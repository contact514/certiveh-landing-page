---
import { existsSync } from 'node:fs';
import BaseLayout from './BaseLayout.astro';
import { Navbar } from '../app/components/Navbar';
import { SiteFooter } from '../app/components/SiteFooter';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  datePublished?: string;
  /**
   * ⚠️ **Sin esto, `dateModified` era `datePublished` y no había forma de moverlo.** El 8-sep-2026
   * se editaron NUEVE de los doce artículos —siete de ellos por el modelo del servicio de IVA;
   * los otros dos, una corrección menor— y los nueve seguían anunciándole a Google su fecha de
   * publicación, con hasta cinco meses de desfase.
   *
   * Si no se pasa, cae en `datePublished`, que es lo correcto para un artículo que no se ha
   * tocado desde que se publicó.
   */
  dateModified?: string;
  isArticle?: boolean;
  /** La página empieza con una cabecera oscura (el índice): la barra arranca transparente y no hay espaciador blanco. */
  darkHero?: boolean;
}

const {
  title,
  description,
  keywords,
  datePublished = '2026-04-01',
  dateModified = datePublished,
  isArticle = false,
  darkHero = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// Cada artículo tiene su imagen social con su propio titular (scripts/generate-og-images.mjs la genera leyendo el
// h1). Si un artículo nuevo aún no la tiene, cae en la portada del blog en vez de enlazar una imagen que no existe.
const slug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const ogImage = isArticle && slug && existsSync(new URL(`../../public/og/blog/${slug}.jpg`, import.meta.url))
  ? `https://certiveh.co/og/blog/${slug}.jpg`
  : 'https://certiveh.co/og/blog.jpg';

const jsonLd = isArticle ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: ogImage,
  datePublished: datePublished,
  dateModified: dateModified,
  author: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  publisher: {
    '@type': 'Organization',
    name: 'CertiVeh',
    url: 'https://certiveh.co',
    logo: { '@type': 'ImageObject', url: 'https://certiveh.co/og/blog.jpg', width: 1200, height: 630 },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  inLanguage: 'es-CO',
}) : null;

const breadcrumbLd = isArticle ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://certiveh.co/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://certiveh.co/blog/' },
    { '@type': 'ListItem', position: 3, name: title },
  ]
}) : null;
---

<BaseLayout title={title} description={description} keywords={keywords} ogType={isArticle ? 'article' : 'website'} ogImage={ogImage}>
  {jsonLd && (
    <script slot="head" type="application/ld+json" set:html={jsonLd} />
  )}
  {breadcrumbLd && (
    <script slot="head" type="application/ld+json" set:html={breadcrumbLd} />
  )}
  <style is:global>
    /* ── BLOG · estándar visual 2026-11 (DESIGN_SYSTEM.md §0) ─────────────────
       Una sola hoja para el índice y los 15 artículos. Las clases son las de siempre (los artículos
       no se tocan); lo que cambia es cómo se pintan: sin degradados, sin sombras, sin el número
       gigante del banner, sin píldoras ni mayúsculas espaciadas, cuerpo a 18 px y líneas de ~68
       caracteres. Colores y tipo salen de las variables --cv-* de src/styles/marca.css. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      /* alias de las variables antiguas, por si algún artículo las usa en línea */
      --green: var(--cv-accent); --teal: var(--cv-accent); --dark: var(--cv-ink); --slate: var(--cv-ink);
      --muted: var(--cv-soft); --border: var(--cv-tone-2); --light: var(--cv-tone); --amber: #B45309;
    }
    body { font-family: var(--cv-font); background: var(--cv-bg); color: var(--cv-ink); line-height: 1.6; letter-spacing: -0.01em; -webkit-font-smoothing: antialiased; }

    /* ── PAGE SPACER ──────────────────────────────────────────────────── */
    .page-top { height: 64px; }

    /* ── ESTRUCTURA ───────────────────────────────────────────────────── */
    .blog-wrapper { max-width: 760px; margin: 0 auto; padding: 28px var(--cv-m) 120px; display: flex; flex-direction: column; gap: 56px; }
    .page-intro { padding-bottom: 8px; }
    .page-intro .label { display: block; font-size: var(--cv-small); font-weight: 600; color: var(--cv-accent); margin-bottom: 14px; }
    .page-intro h1 { font-size: var(--cv-display); font-weight: var(--cv-wh); color: var(--cv-ink); letter-spacing: var(--cv-trk); margin-bottom: 18px; line-height: 1; text-wrap: balance; }
    .page-intro p { font-size: var(--cv-lead); color: var(--cv-ink); line-height: 1.4; }
    article { background: transparent; }

    /* Cabecera del artículo: un campo de color a todo el ancho, el h1 grande. Sin degradado ni número
       de fondo. Verde en los artículos marcados b-green; el campo oscuro en el resto. */
    .article-banner { position: relative; width: 100vw; margin-left: calc(50% - 50vw); padding: clamp(48px, 7vw, 96px) var(--cv-m); background: var(--cv-field); color: #fff; }
    .article-banner.b-green { background: var(--cv-accent); }
    .article-banner.b-navy, .article-banner.b-amber { background: var(--cv-field); }
    .banner-bg-num { display: none; }
    .banner-inner { max-width: calc(760px - 2 * var(--cv-m)); margin: 0 auto; } /* el mismo borde izquierdo que el cuerpo */
    .banner-tag { font-size: var(--cv-small); font-weight: 600; color: var(--cv-mint); margin-bottom: 18px; }
    .article-banner.b-green .banner-tag { color: #d6f5e8; }
    .banner-title { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.25rem); font-weight: var(--cv-wh); color: #fff; letter-spacing: var(--cv-trk); line-height: 1.04; margin: 0; text-wrap: balance; }
    .banner-subtitle { font-size: var(--cv-lead); color: #e2e8f0; margin-top: 18px; line-height: 1.4; max-width: 46ch; }
    .article-banner.b-green .banner-subtitle { color: #effaf5; }
    .article-meta { display: flex; flex-wrap: wrap; gap: 6px 22px; padding: 22px 0 0; font-size: var(--cv-small); color: var(--cv-soft); }
    .meta-pill { position: relative; padding-left: 14px; }
    .meta-pill::before { content: ""; position: absolute; left: 0; top: .55em; width: 6px; height: 6px; background: var(--cv-accent); }

    /* ── CUERPO ───────────────────────────────────────────────────────── */
    .article-body { padding: 36px 0 0; max-width: 68ch; }
    .article-body > p { font-size: 1.125rem; color: var(--cv-ink); line-height: 1.65; margin-bottom: 22px; }
    .lead { font-size: var(--cv-lead) !important; color: var(--cv-ink) !important; line-height: 1.45 !important; font-weight: 500; padding-left: 20px; box-shadow: inset 4px 0 0 var(--cv-accent); margin-bottom: 36px !important; } /* taste-skill-ignore: barra de acento de la entradilla */
    .article-body h2 { font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.125rem); font-weight: var(--cv-wh); color: var(--cv-ink); letter-spacing: var(--cv-trk); line-height: 1.1; margin: 56px 0 18px; text-wrap: balance; scroll-margin-top: 88px; }
    .article-body h3 { font-size: 1.25rem; font-weight: var(--cv-wh); color: var(--cv-ink); letter-spacing: -0.015em; margin: 32px 0 10px; }
    /* ⚠️ No había regla para los enlaces del cuerpo, así que cada post dependía de que su autor se
       acordara del `style` en línea. Los que no lo llevaban salían en `rgb(0,0,238)`, el azul por
       defecto del navegador: cuatro en `que-es-certificado-upme` y uno en `resolucion-upme-400`,
       servidos así en producción.

       EL COLOR ES `#047857`, NO `var(--green)`. Son los dos verdes de la marca y no se
       intercambian: el primario `#059669` da 3,77:1 sobre blanco y **no cumple AA** para letra;
       `#047857` da 5,48:1. El primario es para rellenos. Este mismo fichero ya usa `#047857` para
       texto en `.page-intro .label`. Una primera versión de esta regla usaba `var(--green)` y era
       exactamente el defecto que el manual del repo lleva escrito.

       NO SE QUITA EL SUBRAYADO EN PROSA, y esto tampoco es estético. `#047857` contra el
       `#475569` del cuerpo da 1,38:1, muy por debajo del 3:1 que exige la WCAG 1.4.1 para
       distinguir un enlace SOLO por color. Sin subrayado, un enlace en mitad de un párrafo deja de
       ser identificable. En las tablas de modelos sí se quita, que es donde estaba puesto a
       propósito: los 11 enlaces con `text-decoration: none` del código anterior estaban TODOS
       dentro de un `<td>`, comprobado uno a uno.

       El `:not(.cta-btn)` NO es decorativo. `.article-cta` vive DENTRO de `.article-body`, así que
       sin la exclusión un `.article-body a` (0,1,1) le ganaría por especificidad a `.cta-btn`
       (0,1,0) y los 13 botones de cierre perderían su texto blanco sobre el gradiente. */
    .article-body a:not(.cta-btn) { color: var(--cv-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
    /* Tablas: sin subrayado a propósito. La pista aparece al pasar por encima.
       Lleva el `:not(.cta-btn)` para igualar la especificidad de la regla base (0,2,2 frente a
       0,2,1): sin él, `.article-body td a` es (0,1,2) y PIERDE, así que el `underline` de arriba se
       colaría en las tablas. */
    .article-body :is(td, th) a:not(.cta-btn) { text-decoration: none; }
    .article-body :is(td, th) a:not(.cta-btn):hover { text-decoration: underline; }
    /* La cabecera de la tabla es el OTRO fondo oscuro del cuerpo (`.data-table th` va sobre
       `#0F172A`), así que le pasa lo mismo que al CTA: el verde de letra ahí da 3,26:1. Hoy no hay
       ni un enlace en un `<th>`, y esta regla existe para que siga sin importar cuando lo haya.
       VA ANCLADA A `.data-table`, no a `th` a secas: quien justifica el verde menta es ESE fondo
       oscuro. Un `<th>` de una tabla sin esa clase tiene fondo blanco, y ahí `#34D399` da 1,92:1,
       o sea ilegible. El ancla floja fue el primer intento de esta regla. */
    .data-table th a:not(.cta-btn) { color: var(--cv-mint); }
    /* Índice interno (`resolucion-upme-400`): el enlace envuelve el título y hereda su color y su
       peso del `<strong>` que lo contiene. Antes era un `style` en línea, que ganaba también al
       `:hover` y dejaba los seis enlaces sin ninguna señal de ser pulsables.
       Va anclado a `.step-content` para subir a (0,3,1): con `.article-body a.toc-link` empataba a
       (0,2,1) con la regla base y solo ganaba por orden de aparición en el fichero. */
    .article-body .step-content a.toc-link { color: inherit; font-weight: inherit; text-decoration: none; }
    .article-body .step-content a.toc-link:hover { text-decoration: underline; }
    /* ⚠️ EL CTA DE CIERRE VA SOBRE `#0F172A`, Y AHÍ EL VERDE DE LETRA NO SIRVE. `#047857` sobre ese
       fondo da 3,26:1 y falla AA; el `#059669` que había antes daba 4,74:1, así que la primera
       versión de este arreglo MEJORABA el fondo claro y EMPEORABA el oscuro. Sobre oscuro va el
       verde claro `#34D399`, que da 9,29:1. Es regla y no `style` en línea a propósito: hay 13
       bloques `.article-cta` y son justo donde se añaden enlaces, así que quien meta uno nuevo lo
       recibe bien sin tener que acordarse. */
    .article-body .article-cta a:not(.cta-btn) { color: var(--cv-mint); font-weight: inherit; }
    /* Citas [1], [2]: superíndice verde, sin cajita. */
    .cite { display: inline-block; font-size: .75rem; font-weight: 700; color: var(--cv-accent); vertical-align: super; line-height: 1; white-space: nowrap; margin-left: 2px; cursor: default; }
    /* Recuadros: por tono, sin borde. El rojo queda para lo que es advertencia. */
    .callout { border-radius: var(--cv-r); padding: 20px 24px; margin: 28px 0; font-size: 1.0625rem; line-height: 1.6; background: var(--cv-tone); color: var(--cv-ink); }
    .callout.green { background: #e6f4ec; color: #064e3b; }
    .callout.amber, .callout.slate { background: var(--cv-tone); color: var(--cv-ink); }
    .callout.red { background: #fdecea; color: #7f1d1d; }
    .callout strong { font-weight: 700; }
    .callout p { font-size: 1.0625rem !important; color: inherit !important; margin-bottom: 8px !important; line-height: 1.6 !important; }
    .callout p:last-child { margin-bottom: 0 !important; }
    .legal-ref { background: var(--cv-tone); border-radius: var(--cv-r); padding: 18px 22px; margin: 24px 0; font-size: .9375rem; color: var(--cv-ink); line-height: 1.6; }
    .legal-ref .ref-title { font-size: var(--cv-small); font-weight: 700; letter-spacing: normal; color: var(--cv-accent); margin-bottom: 6px; }
    /* Las tres cifras de beneficio: baldosas en tono, sin borde, sombra ni salto al pasar el ratón. */
    .benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 28px 0; }
    .benefit-card { border-radius: var(--cv-r); padding: 22px; background: var(--cv-tone); }
    .benefit-card .pct { font-size: 2.5rem; font-weight: var(--cv-wh); letter-spacing: calc(var(--cv-trk) * 1.3); margin-bottom: 6px; line-height: 1; color: var(--cv-accent); }
    .benefit-card.c-green .pct, .benefit-card.c-teal .pct, .benefit-card.c-amber .pct { color: var(--cv-accent); }
    .benefit-card .bc-label { font-size: var(--cv-small); font-weight: 700; letter-spacing: normal; color: var(--cv-ink); margin-bottom: 8px; }
    .benefit-card .bc-norm { font-size: .8125rem; color: var(--cv-soft); font-weight: 600; margin-top: 10px; }
    .benefit-card p { font-size: .9375rem !important; color: var(--cv-ink) !important; margin-bottom: 0 !important; line-height: 1.5 !important; }
    /* Pasos de un procedimiento: el orden es real, así que el número se queda, en un punto plano. */
    .steps { display: flex; flex-direction: column; gap: 6px; margin: 24px 0; }
    .step-item { display: flex; gap: 16px; align-items: flex-start; padding: 16px 18px; background: var(--cv-tone); border-radius: var(--cv-r); }
    .step-num { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--cv-accent); color: #fff; font-size: .875rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
    .step-content strong { display: block; font-size: 1.0625rem; font-weight: 700; color: var(--cv-ink); margin-bottom: 3px; }
    .step-content span { font-size: 1rem; color: var(--cv-ink); line-height: 1.55; }
    /* Línea de tiempo: el riel de la marca (3 px y puntos verdes). */
    .timeline { padding-left: 28px; margin: 24px 0; display: flex; flex-direction: column; gap: 22px; position: relative; }
    .timeline::before { content: ""; position: absolute; left: 6px; top: 6px; bottom: 6px; width: 3px; background: var(--cv-tone-2); }
    .tl-item { position: relative; }
    .tl-item::before { content: ""; position: absolute; left: -28px; top: 4px; width: 15px; height: 15px; border-radius: 50%; background: var(--cv-accent); }
    .tl-label { font-size: var(--cv-small); font-weight: 700; letter-spacing: normal; color: var(--cv-accent); margin-bottom: 3px; }
    .tl-item > p { font-size: 1rem !important; color: var(--cv-ink) !important; margin-bottom: 0 !important; line-height: 1.6 !important; }
    /* Tablas de datos: sí llevan sus líneas (son tablas de verdad). */
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; margin: 24px 0; }
    .table-wrap .data-table { margin: 0; }
    .data-table { width: 100%; border-collapse: collapse; font-size: .9375rem; margin: 24px 0; border-radius: var(--cv-r); overflow: hidden; font-variant-numeric: tabular-nums; }
    .data-table th { background: var(--cv-field); color: #fff; padding: 12px 16px; text-align: left; font-size: .875rem; font-weight: 700; letter-spacing: normal; }
    .data-table td { padding: 12px 16px; border-bottom: 1px solid var(--cv-tone-2); color: var(--cv-ink); vertical-align: top; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--cv-tone); }
    .data-table .hl { color: var(--cv-accent); font-weight: 700; }
    /* Ámbar de TEXTO, igual que el verde: `--amber` (#D97706) es el paso 600 y da 3,19:1 sobre
       blanco y 3,04:1 sobre las filas pares, o sea falla AA en las 15 celdas que lo usan. El resto
       de la landing ya escribe texto ámbar en #B45309 (`api-docs.astro:462`), que da 5,02 y 4,80.
       Se cambia aquí y NO en el token, para no arrastrar el cambio a donde el contraste da igual.
       OJO, y este comentario decía antes lo contrario: tras este cambio `--amber` se queda con CERO
       usos de `var()`. El gradiente de `.article-banner.b-amber` (línea 144) lleva el literal
       `#D97706`, no el token. Se deja declarado a propósito, pero que nadie lo busque esperando
       encontrarlo en uso. */
    .data-table .hl2 { color: #B45309; font-weight: 700; }
    .footnotes { margin-top: 48px; padding: 24px; background: var(--cv-tone); border-radius: var(--cv-r); }
    .footnotes h4 { font-size: var(--cv-small); font-weight: 700; letter-spacing: normal; color: var(--cv-ink); margin-bottom: 12px; }
    .footnotes ol { padding-left: 18px; }
    .footnotes li { font-size: .875rem; color: var(--cv-soft); line-height: 1.6; margin-bottom: 6px; }
    .footnotes li em { font-style: italic; }
    .article-cta { margin-top: 48px; padding: 28px 32px; background: var(--cv-field); border-radius: var(--cv-r); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .article-cta p { font-size: 1.0625rem !important; color: #fff !important; margin-bottom: 0 !important; font-weight: 500; max-width: 46ch; }
    .article-cta p strong { font-weight: 700; color: #fff; }
    .cta-btn { display: inline-flex; align-items: center; gap: 12px; background: #fff; color: var(--cv-ink); font-size: 1.0625rem; font-weight: 600; padding: 16px 20px; border-radius: var(--cv-r); text-decoration: none; white-space: nowrap; flex-shrink: 0; transition: background-color .15s; }
    .cta-btn:hover { background: var(--cv-tone); }
    .cta-btn:focus-visible { outline: 3px solid var(--cv-mint); outline-offset: 3px; }
    .article-number { font-size: var(--cv-small); font-weight: 600; color: var(--cv-soft); }
    @media (max-width: 640px) {
      .article-body > p { font-size: 1.0625rem; }
      .benefits-grid { grid-template-columns: 1fr; }
      .data-table { font-size: .875rem; }
      .data-table th, .data-table td { padding: 10px 12px; }
      .article-cta { padding: 24px 20px; }
      .cta-btn { white-space: normal; }
    }
    /* ── VOLVER Y MIGAS ───────────────────────────────────────────────── */
    .back-link { display: inline-flex; align-items: center; gap: 8px; font-size: var(--cv-small); font-weight: 600; color: var(--cv-ink); text-decoration: none; align-self: flex-start; transition: color .15s, gap .15s; }
    .back-link:hover { color: var(--cv-accent); gap: 10px; }
    .back-link svg { width: 15px; height: 15px; }
    .article-breadcrumb { font-size: var(--cv-small); color: var(--cv-soft); margin-bottom: 24px; }
    .article-breadcrumb a { color: var(--cv-soft); text-decoration: none; transition: color .15s; }
    .article-breadcrumb a:hover { color: var(--cv-accent); }
    .article-breadcrumb span { margin: 0 6px; }
  </style>

  <!-- NAV — mismo componente React que la landing -->
  <Navbar isHome={false} darkHero={darkHero} client:load />

  {!darkHero && <div class="page-top"></div>}

  <!-- CONTENT -->
  <main id="main-content">
    <slot />
  </main>

  <!-- FOOTER: el pie compartido de todo el sitio -->
  <SiteFooter />
</BaseLayout>
