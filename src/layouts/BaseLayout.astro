---
// El estándar visual 2026-11 (tokens y clases de marca) para todas las páginas: DESIGN_SYSTEM.md §0.
import '../styles/marca.css';
// Medición de ventas (6-nov-2026): la etiqueta de Google Ads sólo si el build trae `GOOGLE_ADS_TAG_ID` (AW-<dígitos>).
import { idDeLaEtiquetaDeGoogle } from '../scripts/cv-atrib.ts';
const etiquetaDeGoogleAds = idDeLaEtiquetaDeGoogle(import.meta.env.GOOGLE_ADS_TAG_ID);

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  ogDescription?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title = 'Reclama los beneficios tributarios de tu carro eléctrico o híbrido | CertiVeh',
  description = 'Tramitamos tu certificado UPME y gestionamos de punta a punta la devolución de IVA de tu carro eléctrico o híbrido en Colombia. Tú subes tus documentos y nosotros preparamos tu solicitud.',
  keywords = 'certificado UPME, tramitador virtual UPME, vehículos eléctricos Colombia, beneficios tributarios vehículo eléctrico, devolución IVA vehículo eléctrico, gestión devolución IVA DIAN, deducción renta vehículo eléctrico, trámite UPME, certificado beneficio tributario Colombia, tramitador DIAN vehículos eléctricos',
  ogType = 'website',
  ogDescription = description,
  ogImage = 'https://certiveh.co/og/home.jpg',
  robots = 'index, follow',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Google Fonts preconnect (performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;600;700&display=swap" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="author" content="CertiVeh" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="CertiVeh" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <style>html { background: #0f172a; }</style>

    <!-- Google Analytics GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FJ10NX1DV6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FJ10NX1DV6');
    </script>
    <!-- Medición de ventas (6-nov-2026): el id de clic del anuncio (fbclid / gclid / gbraid / wbraid) a la cookie cv_atrib
         de .certiveh.co, y la etiqueta de Google Ads (AW-…) sobre el mismo gtag.js, sólo si el build trae GOOGLE_ADS_TAG_ID.
         La conversión la sube el servidor del portal; aquí sólo se guarda el clic. -->
    {etiquetaDeGoogleAds && <meta name="cv-etiqueta-google-ads" content={etiquetaDeGoogleAds} />}
    <script>
      import { capturarLaAtribucionDeLaUrl, configurarLaEtiquetaDeGoogleAds } from '../scripts/cv-atrib.ts';
      capturarLaAtribucionDeLaUrl(window);
      // Astro emite los <script> como módulos y no garantiza que éste corra DESPUÉS del de GA4 (que hace gtag('js')): la
      // etiqueta se configura al terminar de cargar el documento, cuando ya corrieron todos.
      if (document.readyState === 'complete') configurarLaEtiquetaDeGoogleAds(window);
      else window.addEventListener('DOMContentLoaded', () => configurarLaEtiquetaDeGoogleAds(window), { once: true });
    </script>

    <!-- Meta Pixel -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1323375866331511');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1323375866331511&ev=PageView&noscript=1"/>
    </noscript>

    <!-- Meta brand signals -->
    <meta name="application-name" content="CertiVeh" />
    <meta name="apple-mobile-web-app-title" content="CertiVeh" />

    <!-- Organization schema: helps Google recognize "CertiVeh" as a brand -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': 'https://certiveh.co/#organization',
      name: 'CertiVeh',
      alternateName: ['Certi Veh', 'Certiveh', 'CertiVeh Colombia'],
      url: 'https://certiveh.co',
      logo: {
        '@type': 'ImageObject',
        url: 'https://certiveh.co/favicon.svg',
        width: 100,
        height: 100,
      },
      description: 'CertiVeh es una plataforma colombiana que gestiona el trámite del certificado UPME para vehículos eléctricos e híbridos, habilitando la devolución de IVA, la deducción en renta y la exención de arancel en importación directa conforme a la Ley 1715 de 2014, la Ley 2099 de 2021 y la Resolución UPME 563 de 2026. Cubre 498+ modelos de 62 marcas certificadas por la UPME.',
      email: 'contacto@certiveh.co',
      foundingDate: '2025',
      legalName: 'CertiVeh S.A.S.',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Medellín',
        addressRegion: 'Antioquia',
        addressCountry: 'CO',
      },
      areaServed: { '@type': 'Country', name: 'Colombia' },
      serviceType: 'Gestión de certificados UPME y devolución de IVA para vehículos eléctricos, híbridos y otros activos (GEE/FNCE)',
      knowsAbout: [
        'Certificado UPME',
        'Vehículos eléctricos',
        'Vehículos híbridos',
        'Ley 1715 de 2014',
        'Ley 2099 de 2021',
        'Resolución UPME 563 de 2026',
        'Resolución CREG 030 de 2018',
        'Beneficios tributarios movilidad eléctrica',
        'Devolución de IVA vehículos eléctricos',
        'Deducción en renta vehículos eléctricos',
        'Gestión Eficiente de la Energía',
      ],
    })} />

    <!-- WebSite schema with SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': 'https://certiveh.co/#website',
      url: 'https://certiveh.co',
      name: 'CertiVeh',
      alternateName: 'CertiVeh - Certificado UPME Colombia',
      description: 'Plataforma que automatiza el trámite del certificado UPME para vehículos eléctricos e híbridos en Colombia.',
      inLanguage: 'es-CO',
      publisher: { '@id': 'https://certiveh.co/#organization' },
    })} />

    <!-- Structured Data slot (JSON-LD) -->
    <slot name="head" />
    <style>
      html { scroll-behavior: smooth; }
      /* El reset `*` de cada pagina se scopea y nunca alcanza a <body>, asi que
         el margen de 8px del navegador dejaba ver el fondo oscuro del <html>
         como un borde alrededor del contenido. Se resetea aqui, global. */
      body { margin: 0; }
      .skip-link {
        position: absolute; top: -100%; left: 16px;
        background: var(--cv-accent); color: #fff; padding: 12px 24px;
        border-radius: 0 0 6px 6px; font-size: 15px; font-weight: 600;
        text-decoration: none; z-index: 9999;
        font-family: var(--cv-font);
      }
      .skip-link:focus { top: 0; }
      /* G1: Global focus-visible for keyboard accessibility */
      a:focus-visible, button:focus-visible, [tabindex]:focus-visible {
        outline: 3px solid var(--cv-accent);
        outline-offset: 3px;
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body style="background:#ffffff">
    <a href="#main-content" class="skip-link">Ir al contenido principal</a>
    <slot />
    <script is:inline>if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; window.scrollTo(0, 0);</script>
    <!-- Anclas que no se quedan cortas. El navegador salta a un #hash (al llegar desde otra página, o al pulsar
         un enlace de la misma) con la altura que tiene la página EN ESE INSTANTE, y con scroll suave el destino
         queda fijado al empezar. Si luego crece lo de arriba (las islas al hidratar: la calculadora de la home
         sumaba 248 px; una imagen, una fuente), el salto termina antes de la sección y se ve parte de la
         anterior. Mientras la página se asienta se vuelve a anclar al destino, y se deja de hacer en cuanto la
         persona toca, rueda o pulsa una tecla. Dónde queda cada sección lo fija marca.css (scroll-padding). -->
    <script is:inline>(function () {
      var hasta = 0, destino = null, ro = null;
      function soltar() { hasta = 0; destino = null; }
      function anclar(suave) {
        if (!destino || Date.now() > hasta) return soltar();
        destino.scrollIntoView({ block: 'start', behavior: suave ? 'smooth' : 'instant' });
      }
      // Un hash mal codificado (#%E0) hace lanzar a decodeURIComponent: entonces se busca el id tal cual.
      function idDe(hash) { var crudo = hash.slice(1); try { return decodeURIComponent(crudo); } catch (e) { return crudo; } }
      function vigilar(id, ms, suave) {
        var t = id && document.getElementById(id);
        if (!t) return;
        destino = t; hasta = Date.now() + ms;
        if (!ro && 'ResizeObserver' in window) { ro = new ResizeObserver(function () { anclar(suave); }); ro.observe(document.body); }
      }
      ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach(function (e) { addEventListener(e, soltar, { passive: true, capture: true }); });
      var id0 = idDe(location.hash);
      if (id0) {
        vigilar(id0, 5000, false);
        addEventListener('load', function () { anclar(false); });
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { anclar(false); });
      }
      // Un enlace a una sección de esta misma página: el navegador hace su salto suave y aquí solo se corrige
      // si algo cambia de altura mientras tanto.
      document.addEventListener('click', function (ev) {
        var a = ev.target && ev.target.closest && ev.target.closest('a[href*="#"]');
        var sinBarra = function (p) { return p.replace(/\/$/, ''); };
        if (!a || a.origin !== location.origin || sinBarra(a.pathname) !== sinBarra(location.pathname) || !a.hash) return;
        var id = idDe(a.hash);
        setTimeout(function () { vigilar(id, 2500, true); }, 0);
      });
    })();</script>
  </body>
</html>
