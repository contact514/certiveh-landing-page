---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title = 'CertiVeh — Certificado UPME para Vehículos Eléctricos en Colombia',
  description = 'CertiVeh automatiza el trámite del certificado UPME para vehículos eléctricos e híbridos en Colombia. Exención de IVA, deducción en renta y reducción arancelaria. 100% en línea.',
  keywords = 'certificado UPME, vehículos eléctricos Colombia, beneficios tributarios vehículo eléctrico, exención IVA vehículo eléctrico, deducción renta vehículo eléctrico, trámite UPME, certificado beneficio tributario Colombia',
  ogType = 'website',
  ogDescription = description,
  ogImage = 'https://certiveh.co/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#059669" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Google Fonts preconnect (performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="CertiVeh" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="CertiVeh" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <style>html { background: #0f172a; }</style>

    <!-- Google Analytics GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FJ10NX1DV6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FJ10NX1DV6');
    </script>

    <!-- Meta Pixel -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1323375866331511');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1323375866331511&ev=PageView&noscript=1"/>
    </noscript>

    <!-- Meta brand signals -->
    <meta name="application-name" content="CertiVeh" />
    <meta name="apple-mobile-web-app-title" content="CertiVeh" />

    <!-- Organization schema — helps Google recognize "CertiVeh" as a brand -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': 'https://certiveh.co/#organization',
      name: 'CertiVeh',
      alternateName: ['Certi Veh', 'Certiveh', 'CertiVeh Colombia'],
      url: 'https://certiveh.co',
      logo: {
        '@type': 'ImageObject',
        url: 'https://certiveh.co/favicon.svg',
        width: 100,
        height: 100,
      },
      description: 'CertiVeh automatiza el trámite del certificado UPME para vehículos eléctricos e híbridos en Colombia, habilitando la deducción en renta, la exclusión de IVA y la exención arancelaria bajo la Ley 1715 de 2014 y la Ley 2099 de 2021.',
      email: 'contacto@certiveh.co',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'CO',
        addressRegion: 'Colombia',
      },
      areaServed: { '@type': 'Country', name: 'Colombia' },
      knowsAbout: [
        'Certificado UPME',
        'Vehículos eléctricos',
        'Vehículos híbridos',
        'Ley 1715 de 2014',
        'Ley 2099 de 2021',
        'Beneficios tributarios movilidad eléctrica',
        'Gestión Eficiente de la Energía',
      ],
    })} />

    <!-- WebSite schema with SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': 'https://certiveh.co/#website',
      url: 'https://certiveh.co',
      name: 'CertiVeh',
      alternateName: 'CertiVeh — Certificado UPME Colombia',
      description: 'Plataforma que automatiza el trámite del certificado UPME para vehículos eléctricos e híbridos en Colombia.',
      inLanguage: 'es-CO',
      publisher: { '@id': 'https://certiveh.co/#organization' },
    })} />

    <!-- Structured Data slot (JSON-LD) -->
    <slot name="head" />
  </head>
  <body style="background:#ffffff">
    <slot />
  </body>
</html>
