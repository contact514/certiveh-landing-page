---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  ogDescription?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title = 'CertiVeh, Tu Tramitador Virtual del Certificado UPME en Colombia',
  description = 'CertiVeh es tu tramitador virtual del certificado UPME para vehículos eléctricos e híbridos en Colombia. Devolución de IVA, deducción en renta y depreciación acelerada. 100% en línea.',
  keywords = 'certificado UPME, tramitador virtual UPME, vehículos eléctricos Colombia, beneficios tributarios vehículo eléctrico, devolución IVA vehículo eléctrico, deducción renta vehículo eléctrico, trámite UPME, certificado beneficio tributario Colombia',
  ogType = 'website',
  ogDescription = description,
  ogImage = 'https://certiveh.co/og-image.png',
  robots = 'index, follow',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#059669" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Google Fonts preconnect (performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="author" content="CertiVeh" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="CertiVeh" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <style>html { background: #0f172a; }</style>

    <!-- Google Analytics GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FJ10NX1DV6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FJ10NX1DV6');
    </script>

    <!-- Meta Pixel -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1323375866331511');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1323375866331511&ev=PageView&noscript=1"/>
    </noscript>

    <!-- Meta brand signals -->
    <meta name="application-name" content="CertiVeh" />
    <meta name="apple-mobile-web-app-title" content="CertiVeh" />

    <!-- Organization schema — helps Google recognize "CertiVeh" as a brand -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': 'https://certiveh.co/#organization',
      name: 'CertiVeh',
      alternateName: ['Certi Veh', 'Certiveh', 'CertiVeh Colombia'],
      url: 'https://certiveh.co',
      logo: {
        '@type': 'ImageObject',
        url: 'https://certiveh.co/favicon.svg',
        width: 100,
        height: 100,
      },
      description: 'CertiVeh es una plataforma colombiana que gestiona el trámite del certificado UPME para vehículos eléctricos e híbridos, habilitando la devolución de IVA, la deducción en renta y la exclusión de arancel conforme a la Ley 1715 de 2014, la Ley 2099 de 2021 y la Resolución UPME 045 de 2016. Cubre 362+ modelos de 51 marcas certificadas por la UPME.',
      email: 'contacto@certiveh.co',
      foundingDate: '2025',
      legalName: 'CertiVeh S.A.S.',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Medellín',
        addressRegion: 'Antioquia',
        addressCountry: 'CO',
      },
      areaServed: { '@type': 'Country', name: 'Colombia' },
      serviceType: 'Gestión de certificados UPME para beneficios tributarios de vehículos eléctricos e híbridos',
      knowsAbout: [
        'Certificado UPME',
        'Vehículos eléctricos',
        'Vehículos híbridos',
        'Ley 1715 de 2014',
        'Ley 2099 de 2021',
        'Resolución UPME 045 de 2016',
        'Resolución CREG 030 de 2018',
        'Beneficios tributarios movilidad eléctrica',
        'Devolución de IVA vehículos eléctricos',
        'Deducción en renta vehículos eléctricos',
        'Gestión Eficiente de la Energía',
      ],
    })} />

    <!-- WebSite schema with SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': 'https://certiveh.co/#website',
      url: 'https://certiveh.co',
      name: 'CertiVeh',
      alternateName: 'CertiVeh – Certificado UPME Colombia',
      description: 'Plataforma que automatiza el trámite del certificado UPME para vehículos eléctricos e híbridos en Colombia.',
      inLanguage: 'es-CO',
      publisher: { '@id': 'https://certiveh.co/#organization' },
    })} />

    <!-- Structured Data slot (JSON-LD) -->
    <slot name="head" />
    <style>
      html { scroll-behavior: smooth; }
      .skip-link {
        position: absolute; top: -100%; left: 16px;
        background: #059669; color: #fff; padding: 12px 24px;
        border-radius: 0 0 8px 8px; font-size: 14px; font-weight: 600;
        text-decoration: none; z-index: 9999;
        font-family: 'Inter', system-ui, sans-serif;
      }
      .skip-link:focus { top: 0; }
      /* G1: Global focus-visible for keyboard accessibility */
      a:focus-visible, button:focus-visible, [tabindex]:focus-visible {
        outline: 2px solid #059669;
        outline-offset: 2px;
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body style="background:#ffffff">
    <a href="#main-content" class="skip-link">Ir al contenido principal</a>
    <slot />
  </body>
</html>
