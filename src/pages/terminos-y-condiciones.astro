---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/index.css';
import { Navbar } from '../app/components/Navbar';
import { SiteFooter } from '../app/components/SiteFooter';
import { VERSION_DE_LOS_TERMINOS, VERSION_DEL_ANEXO_DEL_IVA, TERMINOS_VIGENTES_DESDE } from '../lib/version-de-los-terminos.ts';
import { VIGENTE_DESDE as VIGENCIA_DE_LOS_CODIGOS, VIGENTE_DESDE_LA_BIENVENIDA, laGuardaDeLaVigencia, laVigenciaDeLaBienvenidaEstaPendiente } from '../lib/vigencia-de-los-codigos.ts';

// Desde cuándo rigen la versión 2.0 del Anexo A y las condiciones nuevas de los códigos (arts. XIII, XIII-A,
// XXVIII y TyC de la Devolución del IVA). La fecha vive en `src/lib/vigencia-de-los-codigos.ts`, la misma que
// usa la sección Win Win de la home. Sin fijar, ningún build la publica: en Vercel falla, y en local también, salvo un
// borrador pedido a propósito (`PERMITIR_VIGENCIA_PENDIENTE=1`), que lo avisa en la consola y en la página (80 r2, BAJO-12).
const VIGENTE_DESDE = VIGENCIA_DE_LOS_CODIGOS;
const guardaDeLaVigencia = laGuardaDeLaVigencia(process.env);
if (guardaDeLaVigencia.aviso) console.warn(`\n⚠️  ${guardaDeLaVigencia.aviso}\n`);
// 100 · El «Descuento de bienvenida» (art. XXVIII) rige desde su propia fecha: sin fijar, tampoco se publica (O-3 del dictamen legal).
const guardaDeLaBienvenida = laGuardaDeLaVigencia(process.env, laVigenciaDeLaBienvenidaEstaPendiente(), 'VIGENTE_DESDE_LA_BIENVENIDA');
if (guardaDeLaBienvenida.aviso) console.warn(`\n⚠️  ${guardaDeLaBienvenida.aviso} (la del descuento de bienvenida)\n`);
---

<BaseLayout
  title="Términos y Condiciones | CertiVeh"
  description="Términos y Condiciones de Uso de la plataforma CertiVeh. CERTIVEH S.A.S., NIT 902051875-8."
  robots="noindex, follow"
>
  <style is:inline>
    /* Documento legal · estándar visual 2026-11 (DESIGN_SYSTEM.md §0). SOLO ESTILO: el texto es un documento
       vigente y no se toca aquí (CLAUDE.md, «Los textos legales publicados»). Variables --cv-* de marca.css.
       Cabecera en el campo oscuro, como la de los artículos del blog; cuerpo a 17 px en tinta, sin justificar;
       el índice y los recuadros por tono, sin borde ni sombra; el número de cada cláusula en verde, sin caja. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--cv-font); background: var(--cv-bg); color: var(--cv-ink); letter-spacing: -0.005em; -webkit-font-smoothing: antialiased; }

    /* CABECERA */
    .tc-hero { display: flex; flex-direction: column; align-items: flex-start; background: var(--cv-field); color: #fff; padding: calc(64px + clamp(48px, 7vw, 96px)) max(var(--cv-m), calc((100vw - 720px) / 2)) clamp(48px, 6vw, 80px); }
    .tc-title { order: 1; font-size: var(--cv-display); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; text-wrap: balance; color: #fff; }
    .tc-subtitle { order: 2; font-size: var(--cv-lead); line-height: 1.35; color: #e2e8f0; margin-top: 18px; }
    .tc-date { order: 3; font-size: var(--cv-small); color: var(--cv-field-soft); margin-top: 8px; }
    /* «Documento legal» es un dato del documento, no un rótulo encima del título: va al pie de la cabecera */
    .tc-badge { order: 4; margin-top: 18px; font-size: var(--cv-small); font-weight: 600; color: var(--cv-mint); }

    /* CONTENIDO: una columna de lectura */
    .tc-container { max-width: calc(720px + 2 * var(--cv-m)); margin: 0 auto; padding: clamp(40px, 6vw, 72px) var(--cv-m) 96px; }

    /* ÍNDICE */
    .tc-index { background: var(--cv-tone); border-radius: var(--cv-r); padding: clamp(20px, 3vw, 32px); margin-bottom: 64px; }
    .tc-index-title { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 14px; }
    .tc-index-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 24px; }
    .tc-index-item { display: block; padding: 6px 0; font-size: .9375rem; line-height: 1.45; color: var(--cv-accent); font-weight: 600; text-decoration: none; }
    .tc-index-item:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* CLÁUSULAS */
    .tc-section { margin-bottom: 56px; }
    .tc-section-header { display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; }
    .tc-section-num { flex-shrink: 0; min-width: 2.2em; font-size: 1.0625rem; font-weight: 700; color: var(--cv-accent); font-variant-numeric: tabular-nums; }
    .tc-section-title { font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.75rem); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1.15; color: var(--cv-ink); text-wrap: balance; }
    .tc-section p { font-size: 1.0625rem; line-height: 1.7; color: var(--cv-ink); margin-bottom: 14px; }
    .tc-section p:last-child { margin-bottom: 0; }
    .tc-section ol, .tc-section ul { padding-left: 22px; margin-bottom: 14px; }
    .tc-section li { font-size: 1.0625rem; line-height: 1.7; color: var(--cv-ink); margin-bottom: 10px; }
    .tc-section li:last-child { margin-bottom: 0; }
    .tc-section li::marker { color: var(--cv-accent); font-weight: 700; }
    .tc-section li strong { color: var(--cv-ink); }
    .tc-section a { color: var(--cv-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
    /* Subapartados (8.1, 8.2, 8.3) */
    .tc-section p.tc-subsec { margin-top: 26px; font-weight: 700; color: var(--cv-ink); }

    /* RECUADRO */
    .tc-highlight { background: var(--cv-tone); border-radius: var(--cv-r); padding: 18px 22px; margin: 16px 0; }
    .tc-highlight p { color: var(--cv-ink) !important; margin-bottom: 0 !important; line-height: 1.7; }

    /* CABECERA DE CADA ANEXO: el campo verde */
    .tc-anexo-header-block { background: var(--cv-accent); color: #fff; border-radius: var(--cv-r); padding: clamp(24px, 4vw, 40px); margin: 88px 0 48px; display: flex; flex-direction: column; }
    .tc-anexo-title { order: 1; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1.1; text-wrap: balance; }
    .tc-anexo-label { order: 2; margin-top: 12px; font-size: 1rem; font-weight: 600; color: #fff; }
    .tc-anexo-meta { order: 3; margin-top: 10px; font-size: var(--cv-small); color: #fff; line-height: 1.6; }

    /* BOTÓN DE SUBIR: plano, en el verde de la acción */
    #scrollTopBtn { position: fixed; bottom: 24px; right: 24px; z-index: 90; width: 48px; height: 48px; border-radius: var(--cv-r); background: var(--cv-accent); color: #fff; border: 0; cursor: pointer; align-items: center; justify-content: center; transition: background-color .15s; }
    #scrollTopBtn:hover { background: var(--cv-accent-hover); }
    #scrollTopBtn:focus-visible { outline: 3px solid var(--cv-accent); outline-offset: 3px; }

    @media (max-width: 640px) {
      .tc-index-grid { grid-template-columns: 1fr; }
      .tc-index-item { padding-block: 12px; margin-block: -6px; } /* 44 px de toque; en la rejilla el margen no colapsa y el índice no se mueve */
      .tc-section-header { gap: 10px; }
    }
  </style>

  <!-- NAV -->
  <Navbar isHome={false} darkHero={true} client:load />

  {guardaDeLaVigencia.aviso && (
    <p class="tc-borrador" role="note" data-borrador-de-la-vigencia style="margin:0;padding:12px 16px;background:#fef3c7;color:#78350f;font:600 15px/1.4 var(--cv-font);text-align:center">{guardaDeLaVigencia.aviso}</p>
  )}
  {guardaDeLaBienvenida.aviso && (
    <p class="tc-borrador" role="note" data-borrador-de-la-bienvenida style="margin:0;padding:12px 16px;background:#fef3c7;color:#78350f;font:600 15px/1.4 var(--cv-font);text-align:center">{guardaDeLaBienvenida.aviso}</p>
  )}
  <!-- HERO -->
  <div class="tc-hero" id="main-content">
    <div class="tc-badge">Documento legal</div>
    <h1 class="tc-title">Términos y Condiciones de Uso</h1>
    <p class="tc-subtitle">CERTIVEH S.A.S. · NIT 902051875-8</p>
    <p class="tc-date">Versión {VERSION_DE_LOS_TERMINOS} · Fecha de entrada en vigencia: {TERMINOS_VIGENTES_DESDE}</p>
  </div>

  <!-- CONTENT -->
  <div class="tc-container">

    <!-- INDEX -->
    <div class="tc-index">
      <div class="tc-index-title">Contenido</div>
      <div class="tc-index-grid">
        <a href="#i" class="tc-index-item">I. Aceptación</a>
        <a href="#ii" class="tc-index-item">II. Operador de la Plataforma</a>
        <a href="#iii" class="tc-index-item">III. Marco legal</a>
        <a href="#iv" class="tc-index-item">IV. Definiciones</a>
        <a href="#v" class="tc-index-item">V. Naturaleza del servicio</a>
        <a href="#vi" class="tc-index-item">VI. Cuenta de Usuario</a>
        <a href="#vi-a" class="tc-index-item">VI-A. Trámites de terceros</a>
        <a href="#vi-b" class="tc-index-item">VI-B. Verificación del vehículo</a>
        <a href="#vii" class="tc-index-item">VII. Cuenta ante la UPME</a>
        <a href="#viii" class="tc-index-item">VIII. Responsabilidad del Usuario</a>
        <a href="#ix" class="tc-index-item">IX. Autorización del trámite</a>
        <a href="#x" class="tc-index-item">X. Tiempos del trámite</a>
        <a href="#xi" class="tc-index-item">XI. Requerimientos adicionales</a>
        <a href="#xii" class="tc-index-item">XII. Rechazo de la solicitud</a>
        <a href="#xii-a" class="tc-index-item">XII-A. Sin facturar, sin placa o en leasing</a>
        <a href="#xiii" class="tc-index-item">XIII. Pagos del servicio</a>
        <a href="#xiii-a" class="tc-index-item">XIII-A. Programa Win Win</a>
        <a href="#xiv" class="tc-index-item">XIV. Política de reembolsos</a>
        <a href="#xv" class="tc-index-item">XV. Derecho de retracto</a>
        <a href="#xvi" class="tc-index-item">XVI. Limitación de responsabilidad</a>
        <a href="#xvii" class="tc-index-item">XVII. Entrega del Certificado UPME</a>
        <a href="#xviii" class="tc-index-item">XVIII. Seguridad y fraude</a>
        <a href="#xix" class="tc-index-item">XIX. Conservación de datos</a>
        <a href="#xx" class="tc-index-item">XX. Propiedad intelectual</a>
        <a href="#xxi" class="tc-index-item">XXI. Prohibición de suplantación</a>
        <a href="#xxii" class="tc-index-item">XXII. Comunicaciones electrónicas</a>
        <a href="#xxiii" class="tc-index-item">XXIII. Suspensión y cancelación</a>
        <a href="#xxiv" class="tc-index-item">XXIV. Integridad del acuerdo</a>
        <a href="#xxv" class="tc-index-item">XXV. Separabilidad</a>
        <a href="#xxvi" class="tc-index-item">XXVI. Modificación</a>
        <a href="#xxvii" class="tc-index-item">XXVII. Ley aplicable</a>
        <a href="#xxviii" class="tc-index-item">XXVIII. Códigos promocionales</a>
        <a href="#xxix" class="tc-index-item">XXIX. Información del Operador</a>
        <a href="#textos-de-la-interfaz" class="tc-index-item">Textos de autorización y aceptación</a>
        <a href="#anexo-a" class="tc-index-item">Anexo A: Reglamento Win Win (versión 2.0)</a>
        <a href="#devolucion-iva" class="tc-index-item">TyC Devolución del IVA</a>
        <a href="#iva-premium" class="tc-index-item">TyC Devolución de IVA Premium</a>
      </div>
    </div>

    <!-- SECTIONS -->

    <div class="tc-section" id="i">
      <div class="tc-section-header">
        <div class="tc-section-num">I</div>
        <h2 class="tc-section-title">Aceptación de los Términos y Condiciones</h2>
      </div>
      <p>Los presentes Términos y Condiciones de Uso regulan el acceso y uso de la plataforma digital CertiVeh, operada por CERTIVEH S.A.S., a través de la cual los Usuarios pueden registrar la información necesaria para la gestión del trámite de certificación que permite acceder a los incentivos tributarios aplicables a vehículos eléctricos o híbridos.</p>
      <p>El acceso, registro y uso de la Plataforma implica la aceptación expresa, libre e informada de los presentes Términos y Condiciones por parte del Usuario. En consecuencia, al crear una Cuenta de Usuario o utilizar cualquiera de los servicios disponibles en la Plataforma, el Usuario declara haber leído, entendido y aceptado en su totalidad las disposiciones aquí contenidas.</p>
      <p>Los Términos y Condiciones del Servicio de Gestión de la Devolución del IVA, el Anexo A (Reglamento del Programa de Referidos CertiVeh Win Win) y los Términos y Condiciones de la modalidad Devolución de IVA Premium forman parte integral de los presentes Términos y Condiciones y se aplican al Usuario que contrate el servicio o participe en el programa correspondiente.</p>
      <p>La aceptación se manifiesta mediante la casilla dispuesta en la Plataforma antes del registro o del pago, y la Plataforma conserva registro de la versión aceptada como mensaje de datos en los términos de la Ley 527 de 1999. Cuando los presentes Términos y Condiciones exijan una aceptación expresa adicional, esta se solicitará mediante una casilla específica, cuyo texto se recoge en la sección «Texto de autorización y aceptación para interfaz de usuario».</p>
      <p>En caso de no estar de acuerdo con alguno de los términos establecidos en este documento, el Usuario deberá abstenerse de utilizar la Plataforma.</p>
    </div>

    <div class="tc-section" id="ii">
      <div class="tc-section-header">
        <div class="tc-section-num">II</div>
        <h2 class="tc-section-title">Operador de la Plataforma</h2>
      </div>
      <p>La Plataforma es operada por CERTIVEH S.A.S., sociedad legalmente constituida conforme a las leyes de la República de Colombia, identificada con NIT 902051875-8, con domicilio en Medellín (en adelante, el Operador de la Plataforma).</p>
      <p>El Operador de la Plataforma presta un servicio de intermediación tecnológica y de gestión administrativa que facilita la recopilación, organización, preparación y radicación de solicitudes de certificación ante la Unidad de Planeación Minero Energética (UPME).</p>
      <p>El Operador de la Plataforma no es una entidad pública ni tiene competencia para otorgar incentivos tributarios o emitir certificaciones, funciones que corresponden exclusivamente a la UPME.</p>
    </div>

    <div class="tc-section" id="iii">
      <div class="tc-section-header">
        <div class="tc-section-num">III</div>
        <h2 class="tc-section-title">Marco legal</h2>
      </div>
      <p>Los presentes Términos y Condiciones se regirán e interpretarán de conformidad con las leyes de la República de Colombia, incluyendo, entre otras, las normas civiles, comerciales, tributarias, de comercio electrónico, de protección al consumidor y de protección de datos personales que resulten aplicables.</p>
      <p>En particular, el tratamiento de los datos personales del Usuario se realizará conforme a lo dispuesto en la Ley 1581 de 2012, el Decreto 1377 de 2013, el Decreto 1074 de 2015 y demás normas que los modifiquen, sustituyan o complementen.</p>
      <p>Así mismo, el uso de la Plataforma se sujetará a las disposiciones aplicables en materia de comercio electrónico, incluyendo la Ley 527 de 1999 y sus modificaciones, así como a las normas de protección al consumidor establecidas en la Ley 1480 de 2011, en lo que resulte aplicable a la naturaleza del servicio prestado por el Operador de la Plataforma.</p>
      <p>El Usuario reconoce que el trámite de certificación objeto del servicio se encuentra sujeto a la normativa vigente aplicable a los incentivos tributarios asociados a vehículos eléctricos o híbridos y demás bienes objeto del servicio, en especial la Ley 1715 de 2014, modificada por la Ley 2099 de 2021, el Decreto 1625 de 2016, en particular su artículo 1.3.1.12.24, y la Resolución UPME 563 de 2026 o las normas que la modifiquen o sustituyan, así como a los procedimientos, lineamientos y criterios técnicos establecidos por la UPME en ejercicio de sus competencias.</p>
      <p>En este sentido, la evaluación, validación, expedición, modificación o rechazo del Certificado UPME se regirá exclusivamente por la normativa aplicable y por las decisiones adoptadas por la UPME, sin que el Operador de la Plataforma tenga injerencia en dichas actuaciones.</p>
      <p>El Operador de la Plataforma presta un servicio de intermediación tecnológica y de gestión administrativa, limitado a la recopilación, organización, preparación y radicación de la solicitud, así como al seguimiento del trámite ante la UPME, de conformidad con lo establecido en los presentes Términos y Condiciones.</p>
    </div>

    <div class="tc-section" id="iv">
      <div class="tc-section-header">
        <div class="tc-section-num">IV</div>
        <h2 class="tc-section-title">Definiciones</h2>
      </div>
      <ul>
        <li><strong>Operador de la Plataforma:</strong> La empresa CERTIVEH S.A.S., responsable de la administración, funcionamiento y prestación de los servicios ofrecidos a través de la Plataforma.</li>
        <li><strong>Plataforma:</strong> El aplicativo digital administrado por el Operador de la Plataforma mediante el cual los Usuarios pueden registrar información, cargar documentos y gestionar, en calidad de intermediación, el proceso de preparación y radicación de solicitudes de certificación ante la UPME.</li>
        <li><strong>Usuario:</strong> La persona natural o jurídica que se registra en la Plataforma y utiliza los servicios ofrecidos por el Operador de la Plataforma con el fin de gestionar el trámite de certificación para acceder a incentivos tributarios aplicables a vehículos eléctricos o híbridos.</li>
        <li><strong>Autoridad competente:</strong> La Unidad de Planeación Minero Energética (UPME), entidad encargada de evaluar las solicitudes y emitir el certificado que permite acceder a los incentivos tributarios establecidos en la normativa vigente.</li>
        <li><strong>Cuenta de Usuario:</strong> El registro individual creado por el Usuario dentro de la Plataforma que le permite acceder a los servicios ofrecidos, cargar información, consultar el estado del trámite y gestionar la solicitud correspondiente.</li>
        <li><strong>Servicios:</strong> Las funcionalidades tecnológicas ofrecidas por la Plataforma que permiten la recopilación, organización, validación preliminar y gestión de la información necesaria para la preparación y radicación de solicitudes de certificación ante la UPME.</li>
        <li><strong>Certificado UPME:</strong> El documento emitido por la UPME mediante el cual se certifica que un proyecto, bien o tecnología cumple con los requisitos establecidos en la normativa vigente para acceder a los incentivos tributarios aplicables.</li>
        <li><strong>Información del Usuario:</strong> El conjunto de datos, documentos y demás información suministrada por el Usuario a través de la Plataforma para efectos de gestionar la solicitud de certificación ante la UPME.</li>
        <li><strong>Referidor:</strong> El Usuario activo que cumple los requisitos de elegibilidad establecidos en el Reglamento del Programa, genera un Código Win Win desde el dashboard de su Cuenta de Usuario y lo comparte con terceros para que estos contraten el servicio en la Plataforma.</li>
        <li><strong>Referido:</strong> La persona que utiliza un Código Win Win válido en su primer pago en la Plataforma, sin que ni su Cuenta de Usuario ni el titular del trámite tengan otro trámite pagado, y cumple las condiciones de elegibilidad establecidas en el Reglamento del Programa.</li>
        <li><strong>Código Win Win:</strong> El código alfanumérico único e intransferible, con formato NOMBRE-XXX, generado manualmente por el Referidor desde el dashboard de su Cuenta de Usuario, que constituye el único mecanismo válido para la atribución de la referenciación y para el reconocimiento de la comisión al Referidor y del descuento al Referido, conforme al Reglamento del Programa.</li>
        <li><strong>Saldo Win Win:</strong> El valor acumulado de las comisiones causadas y acreditadas a favor del Referidor en el marco del Programa, disponible para retiro desde el dashboard de su Cuenta de Usuario conforme a las condiciones del Reglamento.</li>
        <li><strong>Código promocional:</strong> El código de descuento que el Operador de la Plataforma habilita conforme al artículo XXVIII, de uso general o entregado a uno o varios Usuarios. Es distinto del Código Win Win, del Código de descuento de 48 minutos y del Código de bienvenida.</li>
        <li><strong>Código personal de un amigo:</strong> El nombre con el que la Plataforma se refiere al Código Win Win de un Referidor cuando lo usa otra persona para pagar. Se rige por el Reglamento del Programa y no debe confundirse con los códigos promocionales del artículo XXVIII.</li>
        <li><strong>Código de descuento de 48 minutos:</strong> Hasta el {VIGENTE_DESDE_LA_BIENVENIDA}, el código personal que la Plataforma puede asignar a la Cuenta de Usuario de algunos Usuarios que aún no han pagado ningún trámite, como beneficio por tiempo limitado conforme al artículo XXVIII. Solo puede usarse desde esa Cuenta de Usuario y dentro de los cuarenta y ocho (48) minutos siguientes a su asignación; un pago iniciado dentro de ese plazo puede completarse hasta quince (15) minutos después de vencido.</li>
        <li><strong>Código de bienvenida:</strong> El código personal que el Operador de la Plataforma puede ofrecer a algunos Usuarios nuevos, conforme al párrafo «Descuento de bienvenida» del artículo XXVIII. Empieza por «CV» y vale durante setenta y dos (72) horas desde que se ofrece. Es distinto del Código Win Win y de los códigos promocionales.</li>
        <li><strong>Tercero Beneficiario:</strong> La persona natural o jurídica, distinta del Usuario, propietaria de un vehículo eléctrico o híbrido, cuya información y documentación son registradas y cargadas en la Plataforma por el Usuario desde su propia Cuenta de Usuario, con la autorización previa, expresa e informada del Tercero Beneficiario, para efectos de gestionar en su nombre el trámite de certificación ante la UPME, de conformidad con lo establecido en el artículo VI-A de los presentes Términos y Condiciones.</li>
        <li><strong>Titular:</strong> La persona natural o jurídica a cuyo nombre se presenta la solicitud ante la UPME y se expide el Certificado UPME, que es el adquirente del vehículo o, en los contratos de leasing financiero, el locatario. Puede ser el propio Usuario o un Tercero Beneficiario.</li>
        <li><strong>Servicio de Certificación UPME:</strong> El servicio de gestión de la solicitud del Certificado UPME regulado en los presentes Términos y Condiciones.</li>
        <li><strong>Servicio de Devolución del IVA:</strong> El servicio regulado en los Términos y Condiciones del Servicio de Gestión de la Devolución del IVA.</li>
        <li><strong>Aliado Comercial:</strong> La persona natural o jurídica que tiene un acuerdo comercial con el Operador de la Plataforma y a través de cuyo enlace, código o portal se contrata un trámite.</li>
      </ul>
    </div>

    <div class="tc-section" id="v">
      <div class="tc-section-header">
        <div class="tc-section-num">V</div>
        <h2 class="tc-section-title">Naturaleza del servicio y proceso de solicitud del incentivo</h2>
      </div>
      <p>La Plataforma constituye una herramienta tecnológica de apoyo mediante la cual los Usuarios pueden registrar, organizar y suministrar la información y los documentos necesarios para la solicitud del Certificado UPME que habilita el acceso a los incentivos tributarios aplicables a vehículos eléctricos o híbridos.</p>
      <p>El Usuario declara que la solicitud de certificación gestionada a través de la Plataforma corresponde exclusivamente a vehículos eléctricos o híbridos, con exclusión de los híbridos ligeros, o, cuando la Plataforma lo habilite, a vehículos dedicados a gas natural vehicular, que cumplen con las condiciones establecidas en la normativa aplicable para acceder a los incentivos tributarios.</p>
      <p>A través de la Plataforma, el Usuario podrá proporcionar la información y documentación requerida para que el Operador de la Plataforma gestione y radique la solicitud correspondiente ante la UPME, de conformidad con la normativa aplicable y con los procedimientos y canales oficiales establecidos por dicha entidad.</p>
      <p>En este sentido, el servicio ofrecido por la Plataforma consiste en facilitar la recopilación, estructuración, seguimiento y verificación preliminar de la Información del Usuario, así como gestionar la presentación del trámite ante la UPME, con el fin de simplificar el proceso para el Usuario.</p>
      <p>En caso de que el Usuario registre información correspondiente a vehículos que no cumplan con dichas condiciones, o que no correspondan a tecnologías eléctricas o híbridas, cualquier consecuencia derivada del rechazo, requerimiento o negación del trámite será de exclusiva responsabilidad del Usuario.</p>
      <p>El proceso podrá comprender, entre otras, las siguientes etapas:</p>
      <ol>
        <li>Registro del Usuario en la Plataforma y diligenciamiento de la información básica del solicitante.</li>
        <li>Registro de la información del vehículo o del proyecto, cuando el trámite sea realizado por la ventanilla general de GEE, incluyendo las características técnicas y demás datos requeridos para la solicitud.</li>
        <li>Carga de los documentos de soporte necesarios para el trámite, tales como documentos de identificación, certificado de existencia y representación legal, cuando corresponda, ficha técnica del vehículo y certificaciones técnicas exigidas.</li>
        <li>Consulta de los datos del vehículo y de su propietario en el Registro Único Nacional de Tránsito (RUNT), conforme al artículo VI-B.</li>
        <li>Revisión preliminar de la información y documentos suministrados por el Usuario con el fin de verificar su integridad antes de la radicación del trámite, incluida, cuando corresponda, la revisión por el equipo del Operador de la Plataforma de los datos escritos por el Usuario, conforme al artículo VI-B.</li>
        <li>Gestión y radicación de la solicitud ante la UPME mediante los sistemas oficiales dispuestos por dicha entidad.</li>
        <li>Seguimiento del trámite, incluida la comunicación al Usuario de eventuales requerimientos de información adicional que formule la UPME y la preparación de su respuesta conforme al artículo XI.</li>
      </ol>
      <p>El Usuario reconoce que la evaluación, verificación y decisión sobre la solicitud corresponden exclusivamente a la UPME, entidad competente para determinar el cumplimiento de los requisitos y para expedir, modificar o negar el certificado correspondiente.</p>
      <p>En consecuencia, el Operador de la Plataforma no tiene competencia para aprobar, negar o modificar certificaciones ni para otorgar incentivos tributarios, funciones que corresponden exclusivamente a la UPME.</p>
      <p>Cuando el vehículo aún no ha sido facturado, no tiene placa o se adquiere mediante leasing, se aplica además el artículo XII-A.</p>
    </div>

    <div class="tc-section" id="vi">
      <div class="tc-section-header">
        <div class="tc-section-num">VI</div>
        <h2 class="tc-section-title">Creación y administración de la Cuenta de Usuario dentro del aplicativo</h2>
      </div>
      <p>Para acceder a los servicios ofrecidos a través de la Plataforma, el Usuario deberá crear una Cuenta de Usuario mediante el registro de la información solicitada en el formulario previsto para tal efecto.</p>
      <p>Durante el proceso de registro y uso de la Plataforma, el Usuario deberá proporcionar información veraz, completa, actualizada y legible, incluyendo, entre otros, los siguientes datos:</p>
      <ul>
        <li><strong>Información de identificación y contacto del Usuario:</strong>
          <ol>
            <li>Tipo de persona (natural o jurídica).</li>
            <li>Tipo y número de documento de identificación.</li>
            <li>Nombres y apellidos del solicitante.</li>
            <li>Correo electrónico para notificaciones.</li>
            <li>Número telefónico y celular.</li>
            <li>Dirección de notificación y datos de ubicación.</li>
            <li>Actividad económica (código CIIU), cuando corresponda.</li>
            <li>Información relacionada con el solicitante principal y los solicitantes secundarios, cuando aplique.</li>
          </ol>
        </li>
        <li><strong>Información relacionada con el vehículo objeto del trámite:</strong>
          <ol>
            <li>Tipo de vehículo.</li>
            <li>Marca y línea.</li>
            <li>Tecnología del vehículo (por ejemplo, EV, HEV o PHEV).</li>
            <li>Modelo.</li>
            <li>Cantidad de vehículos.</li>
            <li>Valor unitario y valor total del vehículo.</li>
            <li>Información del vehículo que se pretende reemplazar, cuando corresponda.</li>
            <li>Consumo anual estimado y rendimiento del vehículo, cuando aplique.</li>
          </ol>
        </li>
        <li><strong>Régimen tributario del usuario solicitante:</strong> El Usuario reconoce que algunos beneficios tributarios asociados al Certificado UPME, incluyendo la deducción prevista en la Ley 1715 de 2014, pueden no resultar aplicables a contribuyentes acogidos al régimen simple de tributación, en la medida en que dicho régimen no contempla la depuración de la renta líquida en los mismos términos del régimen ordinario. El Usuario declara que la información tributaria suministrada a través de la Plataforma es veraz, completa y actualizada, y acepta que el Operador de la Plataforma confiará en dicha información para efectos de la gestión del trámite.</li>
        <li><strong>Información adicional:</strong> Cualquier otra información técnica o administrativa necesaria para la gestión del trámite de certificación ante la UPME.</li>
        <li><strong>Documentos de soporte:</strong> El Usuario deberá adjuntar los documentos que la Plataforma le solicite según el tipo de Titular y de trámite, entre los cuales podrán incluirse:
          <ol>
            <li>Documento de identidad del Titular, cuando se trate de persona natural, o de su representante legal, cuando se trate de persona jurídica.</li>
            <li>Certificado de existencia y representación legal, cuando el Titular sea persona jurídica, con la vigencia que informe la Plataforma.</li>
            <li>Registro Único Tributario (RUT) del Titular, cuando la Plataforma lo solicite según el tipo de trámite.</li>
            <li>Factura de compra del vehículo o, en los casos del artículo XII-A, la cotización del concesionario y, en leasing, el contrato de leasing.</li>
            <li>Licencia de tránsito (tarjeta de propiedad) del vehículo, o la placa para su consulta en el RUNT conforme al artículo VI-B, cuando el vehículo ya esté matriculado.</li>
            <li>Ficha técnica o catálogo del vehículo junto con el certificado vigente de cumplimiento de normas técnicas, suministrado por el concesionario o proveedor, cuando la UPME lo exija por no reposar la información técnica del vehículo en sus registros ni ser verificable en los registros oficiales (Resolución UPME 563 de 2026, numeral 5.3.2).</li>
            <li>Cualquier otro documento requerido por la normativa aplicable o por la UPME para la evaluación del trámite.</li>
          </ol>
        </li>
      </ul>
      <p>El Usuario será responsable de la exactitud, integridad, vigencia y legibilidad de los documentos cargados en la Plataforma, así como de la autenticidad de la información contenida en los mismos.</p>
      <p>El Usuario reconoce y autoriza que el Operador de la Plataforma podrá utilizar la información y documentos suministrados para preparar, diligenciar y gestionar las solicitudes correspondientes dentro de los sistemas oficiales dispuestos por la UPME, cuando ello sea necesario para la radicación o gestión del trámite.</p>
    </div>

    <div class="tc-section" id="vi-a">
      <div class="tc-section-header">
        <div class="tc-section-num">VI-A</div>
        <h2 class="tc-section-title">Gestión de trámites a nombre de terceros</h2>
      </div>
      <p>El Usuario podrá, desde su propia Cuenta de Usuario, registrar información, cargar documentos y gestionar trámites de certificación ante la UPME a nombre de terceras personas naturales o jurídicas que sean propietarias de vehículos eléctricos o híbridos y que deseen acceder a los incentivos tributarios aplicables (en adelante, los "Terceros Beneficiarios").</p>
      <p>Para efectos de la gestión de trámites a nombre de Terceros Beneficiarios, el Usuario deberá:</p>
      <ol>
        <li>Registrar la información del Tercero Beneficiario dentro de su Cuenta de Usuario, incluyendo los datos de identificación, contacto, información del vehículo y demás información requerida conforme al artículo VI de los presentes Términos y Condiciones.</li>
        <li>Cargar los documentos de soporte correspondientes al Tercero Beneficiario y a su vehículo, de conformidad con los requisitos establecidos en el artículo VI de los presentes Términos y Condiciones.</li>
        <li>Contar con la autorización previa, expresa e informada del Tercero Beneficiario para suministrar su información personal, cargar sus documentos en la Plataforma y gestionar el trámite de certificación en su nombre.</li>
        <li>Garantizar que la información y los documentos suministrados respecto del Tercero Beneficiario son veraces, completos, actualizados y legibles, y que corresponden a la situación real del Tercero Beneficiario y de su vehículo.</li>
      </ol>
      <p>El Usuario declara y garantiza que:</p>
      <ol>
        <li>Ha obtenido la autorización libre, previa, expresa e informada del Tercero Beneficiario para el tratamiento de sus datos personales por parte del Operador de la Plataforma, conforme a lo dispuesto en la Ley 1581 de 2012 y sus normas reglamentarias, y para las finalidades establecidas en los presentes Términos y Condiciones, incluyendo la gestión del trámite de certificación ante la UPME y el envío de comunicaciones relacionadas con el proceso.</li>
        <li>Ha informado al Tercero Beneficiario sobre la naturaleza, condiciones, alcances y limitaciones del servicio prestado por el Operador de la Plataforma, conforme a los presentes Términos y Condiciones.</li>
        <li>Cuenta con la representación legal o la autorización suficiente para actuar en nombre del Tercero Beneficiario frente al Operador de la Plataforma y frente a la UPME en relación con el trámite de certificación correspondiente y, cuando se contrate el Servicio de Devolución del IVA, frente a la DIAN.</li>
      </ol>
      <p>El Usuario será el único responsable frente al Operador de la Plataforma por la veracidad, exactitud, integridad, actualización y legibilidad de la información y de los documentos suministrados respecto de los Terceros Beneficiarios. Las obligaciones y responsabilidades establecidas en el artículo VIII de los presentes Términos y Condiciones se extienden, en lo aplicable, a la información y documentación suministrada respecto de los Terceros Beneficiarios.</p>
      <p>El Operador de la Plataforma no será responsable por el uso de información o documentos de terceros sin la debida autorización, ni por las consecuencias derivadas de la falta de consentimiento del Tercero Beneficiario para el tratamiento de sus datos personales o para la gestión del trámite, las cuales serán de exclusiva responsabilidad del Usuario que gestione el trámite.</p>
      <p>En caso de que el Operador de la Plataforma identifique indicios de uso no autorizado de información de terceros, suplantación o representación no autorizada, podrá suspender el trámite correspondiente y, cuando corresponda, poner la situación en conocimiento de las autoridades competentes, de conformidad con lo establecido en los artículos XVIII y XXI de los presentes Términos y Condiciones.</p>
      <p>La gestión de trámites a nombre de Terceros Beneficiarios estará sujeta al pago de la tarifa correspondiente por cada trámite gestionado, de conformidad con lo establecido en el artículo XIII de los presentes Términos y Condiciones. El Usuario que gestione el trámite será responsable del pago de la tarifa, salvo que el Tercero Beneficiario lo asuma directamente a través de los medios de pago habilitados en la Plataforma.</p>
    </div>

    <div class="tc-section" id="vi-b">
      <div class="tc-section-header">
        <div class="tc-section-num">VI-B</div>
        <h2 class="tc-section-title">Verificación del vehículo, lectura automática de documentos y datos escritos por el Usuario</h2>
      </div>
      <p>Para verificar que el vehículo existe y que corresponde a la tecnología declarada, y para obtener sus datos registrales, incluido el propietario inscrito, y los que exige la UPME, el Usuario autoriza al Operador de la Plataforma para consultar el Registro Único Nacional de Tránsito (RUNT) por medio de un proveedor tecnológico que actúa como Encargado del Tratamiento. Para ello se transmiten la placa y el tipo y número de documento del Titular o, cuando la placa no se conoce o no coincide, el número de identificación vehicular (VIN) que figura en la factura. La consulta puede realizarla la Plataforma de forma automática o el equipo del Operador de la Plataforma durante la revisión del trámite.</p>
      <p>La consulta no tiene costo para el Usuario y no es obligatoria: si no puede realizarse o no arroja resultado, el Usuario puede escribir la placa, cargar la licencia de tránsito o continuar sin ella, conforme a lo que indique la Plataforma. El Operador de la Plataforma conserva los datos técnicos y registrales del vehículo que devuelve el registro y no conserva los datos de identificación del propietario.</p>
      <p>La Plataforma puede leer de forma automática los documentos cargados por el Usuario mediante herramientas de inteligencia artificial de terceros que actúan como Encargados del Tratamiento, con el fin de extraer y precargar los datos del trámite. El Usuario debe revisar los datos precargados y corregirlos cuando no coincidan con sus documentos. La lectura automática no constituye una decisión sobre el trámite ni sobre la procedencia del incentivo.</p>
      <p>Cuando la lectura automática no sea posible, el Usuario puede escribir los datos directamente en la Plataforma. Al hacerlo declara, bajo su responsabilidad y en los términos del artículo VIII, que los datos escritos coinciden fielmente con los documentos originales. El Operador de la Plataforma revisará esos datos antes de radicar la solicitud y podrá pedir al Usuario aclaraciones o nuevos documentos.</p>
      <p>Si un documento no puede leerse, la Plataforma lo informa y permite cargarlo de nuevo o escribir sus datos. Un documento incompleto o protegido con contraseña puede impedir la radicación hasta que el Usuario lo sustituya.</p>
      <p>Cuando el vehículo no haya podido verificarse en el RUNT ni con la licencia de tránsito, el Operador de la Plataforma podrá retener la radicación de la solicitud hasta que su equipo revise los datos del vehículo, lo que hará dentro de los dos (2) días hábiles siguientes al pago. El plazo de evaluación de la UPME previsto en el artículo X corre desde la radicación. Si, como resultado de la revisión, el vehículo resulta no elegible, el Operador de la Plataforma no radicará la solicitud, se lo informará al Usuario y le devolverá la totalidad de lo pagado.</p>
    </div>

    <div class="tc-section" id="vii">
      <div class="tc-section-header">
        <div class="tc-section-num">VII</div>
        <h2 class="tc-section-title">Administración de la cuenta ante la UPME</h2>
      </div>
      <p>El Usuario autoriza expresamente al Operador de la Plataforma para crear, administrar o gestionar la cuenta requerida ante la UPME, cuando ello sea necesario para la radicación y seguimiento de la solicitud de certificación.</p>
      <p>Para efectos de la gestión del trámite, el Operador de la Plataforma podrá:</p>
      <ol>
        <li>Crear una cuenta ante la UPME utilizando la información suministrada por el Usuario.</li>
        <li>Administrar temporalmente las credenciales de acceso necesarias para la radicación, seguimiento y atención de requerimientos asociados a la solicitud.</li>
        <li>Utilizar dicha cuenta exclusivamente para la gestión del trámite de certificación objeto de los presentes Términos y Condiciones.</li>
      </ol>
      <p>El Usuario reconoce y acepta que la administración temporal de las credenciales por parte del Operador de la Plataforma es necesaria para la correcta gestión del trámite ante la UPME.</p>
      <p>Una vez finalizado el trámite, el Operador de la Plataforma podrá, a solicitud del Usuario, entregar, transferir o actualizar las credenciales de acceso a la cuenta ante la UPME.</p>
      <p>En caso de que el Usuario ya cuente con una cuenta previamente creada ante la UPME, este autoriza al Operador de la Plataforma para gestionar el trámite a través de dicha cuenta o para realizar los ajustes necesarios en las credenciales con el fin de adelantar el proceso de certificación.</p>
    </div>

    <div class="tc-section" id="viii">
      <div class="tc-section-header">
        <div class="tc-section-num">VIII</div>
        <h2 class="tc-section-title">Responsabilidad del Usuario sobre la información</h2>
      </div>
      <p>El Usuario es el único responsable de la veracidad, exactitud, integridad, actualización y legibilidad de la información y de los documentos que suministre a través de la Plataforma para efectos de la gestión del trámite de certificación ante la UPME.</p>
      <p>En consecuencia, el Usuario declara y garantiza que:</p>
      <ol>
        <li>Toda la información proporcionada en la Plataforma es verdadera, completa, actualizada y verificable.</li>
        <li>Los documentos cargados en la Plataforma son auténticos, legibles y corresponden a la información real del vehículo, del solicitante y del proyecto.</li>
        <li>Cuenta con las autorizaciones necesarias para utilizar y suministrar la información y los documentos cargados en la Plataforma.</li>
        <li>Los datos relacionados con el vehículo corresponden a la información suministrada por el fabricante, concesionario o proveedor.</li>
        <li>La información tributaria suministrada por el Usuario, incluyendo su régimen tributario, corresponde a su situación real y vigente.</li>
        <li>Los datos que escriba directamente en la Plataforma coinciden fielmente con los documentos originales del vehículo, del Titular y de la compra.</li>
      </ol>
      <p>El Usuario reconoce que el Operador de la Plataforma no realiza validaciones técnicas, jurídicas ni regulatorias exhaustivas sobre la veracidad de la información suministrada, sin perjuicio de las verificaciones previstas en el artículo VI-B, y que la evaluación de la información y los documentos corresponde exclusivamente a la UPME.</p>
      <p>El Operador de la Plataforma tampoco garantiza la procedencia, cuantificación o aprovechamiento efectivo de beneficios tributarios particulares del Usuario, los cuales dependen, entre otros factores, de su régimen tributario, situación fiscal concreta, interpretación normativa aplicable y decisiones de las autoridades competentes.</p>
      <p>En consecuencia, el Operador de la Plataforma no será responsable por retrasos, requerimientos de información adicional, rechazo de la solicitud o negación del certificado cuando dichas situaciones se deriven de:</p>
      <ol>
        <li>Información incompleta o incorrecta suministrada por el Usuario.</li>
        <li>Documentos ilegibles o incompletos.</li>
        <li>Incumplimiento de los requisitos establecidos por la normativa aplicable o por la UPME.</li>
        <li>Falta de entrega oportuna de información requerida durante el proceso de evaluación.</li>
      </ol>
      <p>El suministro de información incorrecta o inconsistente en relación con la tecnología del vehículo constituirá una causal de rechazo atribuible al Usuario.</p>
      <p>El suministro de información falsa o fraudulenta podrá dar lugar al rechazo de la solicitud por parte de la autoridad competente y a las consecuencias legales correspondientes.</p>
    </div>

    <div class="tc-section" id="ix">
      <div class="tc-section-header">
        <div class="tc-section-num">IX</div>
        <h2 class="tc-section-title">Autorización para la gestión y radicación del trámite</h2>
      </div>
      <p>Mediante la aceptación de los presentes Términos y Condiciones y el uso de la Plataforma, el Usuario autoriza expresamente al Operador de la Plataforma para gestionar, preparar y radicar en su nombre la solicitud de certificación correspondiente ante la UPME, cuando ello sea necesario para la tramitación de los incentivos tributarios aplicables a vehículos eléctricos o híbridos.</p>
      <p>En virtud de esta autorización, el Operador de la Plataforma podrá:</p>
      <ol>
        <li>Utilizar la información y los documentos suministrados por el Usuario.</li>
        <li>Diligenciar formularios, cargar documentos y completar la información requerida en los sistemas oficiales de la UPME.</li>
        <li>Presentar o radicar la solicitud correspondiente.</li>
        <li>Realizar seguimiento al estado del trámite, comunicar al Usuario cualquier requerimiento de información adicional formulado por la UPME y preparar y presentar su respuesta conforme al artículo XI.</li>
        <li>Consultar ante la UPME, por cualquier medio disponible, el estado, avance y resultado de la solicitud de certificación radicada en nombre del Usuario.</li>
        <li>Realizar las gestiones de impulso procesal y administrativo que resulten necesarias o convenientes para el avance oportuno del trámite, incluyendo la presentación de comunicaciones, solicitudes de priorización, peticiones, seguimiento a requerimientos pendientes y cualquier otra actuación administrativa ante la UPME orientada a procurar la evaluación y resolución de la solicitud.</li>
        <li>Interactuar con los funcionarios o dependencias competentes de la UPME, por medios electrónicos, telefónicos o presenciales, en representación del Usuario, para los fines exclusivos de la gestión, seguimiento, consulta e impulso del trámite de certificación.</li>
        <li>Registrar en la solicitud, cuando la normativa o la UPME lo exijan, al concesionario o proveedor del vehículo y, en los contratos de leasing, a la entidad financiera como financiador, y anexar los documentos que exija la UPME.</li>
      </ol>
      <p>La autorización otorgada mediante el presente artículo constituye un mandato de carácter administrativo, limitado exclusivamente a las actuaciones de gestión, preparación, radicación, seguimiento, consulta e impulso del trámite de certificación ante la UPME. En consecuencia, dicho mandato no implica la representación legal del Usuario para efectos distintos del proceso de solicitud del certificado, ni le confiere al Operador de la Plataforma facultades para asumir obligaciones, celebrar actos jurídicos o realizar disposiciones en nombre del Usuario más allá de las expresamente señaladas en este artículo. Las actuaciones ante la DIAN se rigen exclusivamente por el artículo XV de los Términos del Servicio de Devolución.</p>
      <p>Dicha autorización permanecerá vigente durante el tiempo necesario para adelantar las actuaciones relacionadas con la solicitud de certificación.</p>
    </div>

    <div class="tc-section" id="x">
      <div class="tc-section-header">
        <div class="tc-section-num">X</div>
        <h2 class="tc-section-title">Tiempos del trámite</h2>
      </div>
      <p>La gestión del trámite de certificación ante la UPME se sujetará a los tiempos, etapas y plazos establecidos por la normativa aplicable y por los lineamientos que dicha entidad expida. La UPME recibe solicitudes del 1 de febrero al 15 de diciembre de cada año (Resolución UPME 563 de 2026, numeral 6.1); las solicitudes que queden listas para radicar después del 15 de diciembre se radicarán a partir del 1 de febrero siguiente.</p>
      <p>El Usuario reconoce que los términos de evaluación del trámite no dependen exclusivamente del Operador de la Plataforma, sino de la revisión, validación y decisión que adopte la UPME en ejercicio de sus competencias.</p>
      <p>Una vez radicada la solicitud ante la UPME, la evaluación del trámite podrá realizarse dentro de un plazo legal de hasta treinta (30) días hábiles, contado a partir de la radicación de la solicitud, de conformidad con la Resolución UPME 563 de 2026. Dicho término se suspende desde el envío de un requerimiento por parte de la UPME y hasta la recepción de la respuesta del solicitante, caso en el cual, al reanudarse, la UPME dispondrá de hasta diez (10) días hábiles adicionales.</p>
      <p>No obstante, el Usuario reconoce que el término de evaluación podrá suspenderse en aquellos casos en los que la UPME solicite información adicional, aclaraciones o documentos complementarios. En tales casos, el Operador de la Plataforma preparará la respuesta conforme al artículo XI y el Usuario deberá aportar lo que le corresponda dentro del plazo establecido por la autoridad competente, el cual podrá ser de hasta un (1) mes, prorrogable conforme a la normativa aplicable, contado a partir de la comunicación del requerimiento.</p>
      <p>Una vez atendido el requerimiento, el trámite continuará con su proceso de evaluación por parte de la UPME, conforme a los tiempos y procedimientos establecidos por dicha entidad.</p>
      <p>El Operador de la Plataforma realizará las gestiones razonables para radicar oportunamente la solicitud y dar seguimiento al trámite; no obstante, no garantiza tiempos específicos de respuesta, evaluación, expedición del Certificado UPME o acceso efectivo al incentivo tributario, toda vez que ello depende exclusivamente de la UPME y del cumplimiento de los requisitos aplicables por parte del Usuario.</p>
      <p>El Operador de la Plataforma radicará la solicitud una vez el Usuario haya completado la información y los documentos requeridos y, cuando aplique, concluida la revisión prevista en el artículo VI-B.</p>
    </div>

    <div class="tc-section" id="xi">
      <div class="tc-section-header">
        <div class="tc-section-num">XI</div>
        <h2 class="tc-section-title">Requerimientos de información adicional</h2>
      </div>
      <p>Durante el proceso de evaluación de la solicitud, la UPME podrá solicitar al Usuario información adicional, aclaraciones o documentos complementarios que considere necesarios para verificar el cumplimiento de los requisitos establecidos en la normativa aplicable.</p>
      <p>En caso de que la UPME formule un requerimiento de información adicional, el Operador de la Plataforma, dentro del servicio y sin costo adicional para el Usuario, analizará el requerimiento y preparará y presentará la respuesta ante la UPME a través de la cuenta prevista en el artículo VII. Cuando la respuesta exija información o documentos que solo el Usuario puede aportar, el Operador de la Plataforma se los solicitará a través de los canales de comunicación registrados en la Cuenta de Usuario.</p>
      <p>El Usuario deberá proporcionar la información requerida dentro de un plazo máximo de quince (15) días calendario, contados a partir de la notificación realizada por el Operador de la Plataforma.</p>
      <p>El Usuario reconoce que el suministro oportuno y adecuado de la información y los documentos que solo él puede aportar es su responsabilidad, por lo que deberá entregarlos dentro del plazo indicado y en las condiciones exigidas por la autoridad competente.</p>
      <p>En caso de que el Usuario no atienda el requerimiento dentro del plazo establecido o no suministre la información solicitada, el Operador de la Plataforma no será responsable por las consecuencias derivadas de dicha omisión, incluyendo la posible suspensión, archivo, desistimiento o rechazo de la solicitud por parte de la UPME, conforme a la normativa aplicable.</p>
    </div>

    <div class="tc-section" id="xii">
      <div class="tc-section-header">
        <div class="tc-section-num">XII</div>
        <h2 class="tc-section-title">Rechazo de la solicitud</h2>
      </div>
      <p>El Usuario reconoce que la evaluación, validación y decisión sobre la solicitud de certificación corresponden exclusivamente a la Unidad de Planeación Minero Energética (UPME), entidad competente para determinar el cumplimiento de los requisitos establecidos en la normativa aplicable y para expedir, modificar o negar el Certificado UPME.</p>
      <p>En consecuencia, el Operador de la Plataforma no garantiza la aprobación de la solicitud ni la expedición del Certificado UPME, toda vez que el resultado del trámite dependerá del cumplimiento de los requisitos establecidos por la normativa vigente y de la evaluación realizada por la UPME.</p>
      <p>En caso de que la solicitud sea rechazada por la UPME, se podrán presentar los siguientes escenarios:</p>
      <ol>
        <li><strong>Rechazo derivado de errores atribuibles al Operador de la Plataforma:</strong> Cuando el rechazo de la solicitud se derive de errores u omisiones atribuibles al Operador de la Plataforma en la preparación o radicación del trámite, el Operador de la Plataforma volverá a presentar la solicitud correspondiente sin generar costos adicionales para el Usuario, siempre que se mantengan vigentes los requisitos establecidos por la normativa aplicable y por la UPME. Si la UPME no está recibiendo solicitudes conforme al artículo X, la solicitud será presentada nuevamente a partir del 1 de febrero siguiente. En caso de que la solicitud sea rechazada por segunda vez por causas imputables al Operador de la Plataforma, este reconocerá la devolución del cinco por ciento (5%) del valor pagado.</li>
        <li><strong>Rechazo derivado de información o documentación atribuible al Usuario:</strong> Cuando el rechazo de la solicitud se derive de información incorrecta, incompleta o inconsistente suministrada por el Usuario, o de documentos que no cumplan con los requisitos establecidos por la normativa aplicable o por la UPME, el Usuario podrá solicitar la presentación de una nueva solicitud una vez haya subsanado las observaciones formuladas por la autoridad competente. En estos casos, la gestión de una nueva solicitud podrá generar el cobro de una tarifa adicional por concepto de gestión del trámite, la cual será informada previamente al Usuario por parte del Operador de la Plataforma. Lo anterior no se aplica en los casos previstos en el numeral 7 del artículo XII-A. El Operador de la Plataforma podrá brindar apoyo al Usuario en la subsanación de las observaciones formuladas por la UPME; no obstante, no será responsable del rechazo de la solicitud cuando este se derive de información o documentación suministrada por el Usuario o del incumplimiento de los requisitos establecidos por la normativa aplicable.</li>
      </ol>
    </div>

    <div class="tc-section" id="xii-a">
      <div class="tc-section-header">
        <div class="tc-section-num">XII-A</div>
        <h2 class="tc-section-title">Certificado UPME para vehículos sin facturar, sin placa o adquiridos mediante leasing</h2>
      </div>
      <p>Antes de pagar, el Usuario indica en la Plataforma si el vehículo ya fue facturado y, en su caso, si ya tiene placa. Según su respuesta, el Servicio de Certificación UPME se presta en alguna de las siguientes modalidades, a las que se aplican, además de los presentes Términos y Condiciones, las siguientes reglas:</p>
      <ol>
        <li><strong>Vehículo sin facturar.</strong> Cuando el vehículo aún no ha sido facturado, el Operador de la Plataforma gestiona la solicitud con base en la cotización, factura proforma o prefactura del concesionario que el Usuario cargue en la Plataforma (en adelante, la «Cotización»), que debe indicar el vehículo, el precio y el concesionario. El vehículo, el concesionario y el valor antes de IVA que se reportan a la UPME son los de la Cotización. La solicitud del certificado antes de la adquisición del vehículo es procedente conforme al artículo 5 de la Resolución UPME 563 de 2026 y al numeral 11 del Concepto DIAN 100208192-2242 de 2026. Esta modalidad solo está disponible para vehículos eléctricos o híbridos y tiene la misma tarifa del Servicio de Certificación UPME conforme al artículo XIII. El servicio comprende la gestión de la solicitud en los términos de los artículos V a XII, la entrega del Certificado UPME y una comunicación informativa, sin firma y sin datos del caso, que el Usuario puede entregar al concesionario con las normas aplicables a la factura sin IVA.</li>
        <li><strong>Lo que no incluye la modalidad sin facturar.</strong> Esta modalidad no incluye:
          <ol type="a">
            <li>el Servicio de Devolución del IVA, porque cuando el certificado existe antes de la factura la venta del vehículo certificado está excluida del IVA y la factura debe expedirse sin IVA (Ley 1715 de 2014, artículo 12; Decreto 1625 de 2016, artículo 1.3.1.12.24, parágrafo 2; Concepto DIAN 100208192-2242 de 2026, numeral 12);</li>
            <li>la expedición de la factura ni ninguna gestión ante el concesionario; ni</li>
            <li>la oferta de seguro que la Plataforma pueda presentar con el Servicio de Certificación UPME.</li>
          </ol>
          <p>Si la factura se expide antes del Certificado UPME y con IVA, el Usuario puede contratar el Servicio de Devolución del IVA conforme a sus propios términos (Decreto 1625 de 2016, artículo 1.3.1.12.24, parágrafo 3).</p>
        </li>
        <li><strong>La facturación sin IVA depende del concesionario.</strong> El Usuario es responsable de entregar el Certificado UPME al concesionario antes de que expida la factura. La expedición de la factura sin IVA es una obligación del concesionario que el Operador de la Plataforma no controla ni garantiza. Si, después de recibir el certificado, el concesionario factura con IVA, el Usuario debe solicitarle una nota crédito y una nueva factura sin IVA; en leasing, debe pedir a la entidad financiera que lo solicite. Ese IVA lo restituye el concesionario y su gestión no está incluida en el servicio.</li>
        <li><strong>El certificado no se modifica y ampara el vehículo que aparece en él.</strong> El Certificado UPME de vehículos no es objeto de modificación (Resolución UPME 563 de 2026, artículo 7, parágrafo 3). El certificado ampara el vehículo que aparece en él (marca, línea, versión y año), con el concesionario que figura como proveedor, a nombre del Titular. El Usuario conoce esta regla antes de pagar, porque la Plataforma le informa que el certificado vale para el vehículo, el año y el concesionario que aparecen en él. Si después de la entrega del certificado el Usuario decide adquirir otro vehículo o de otro año, o el concesionario factura un vehículo distinto del certificado, esa situación queda fuera del servicio contratado, que se entiende prestado con la entrega del certificado. Certificar el vehículo finalmente adquirido, o gestionar la devolución del IVA que se haya pagado sobre él, es un trámite nuevo e independiente, que el Usuario puede contratar en la Plataforma con las tarifas vigentes. Lo anterior no se aplica cuando el certificado no corresponda al vehículo de la Cotización por un error imputable al Operador de la Plataforma, caso en el cual se aplica el numeral 1 del artículo XII. Sobre el valor, el Usuario reconoce que:
          <ol type="a">
            <li>el Operador de la Plataforma le recomienda que la factura se expida por el mismo valor antes de IVA que figura en el certificado;</li>
            <li>si el valor facturado es menor, el certificado no se modifica y el Usuario debe conservar los soportes del cambio (Resolución UPME 563 de 2026, artículo 10, parágrafo 2); y</li>
            <li>la norma no regula el caso de un valor facturado mayor al del certificado, por lo que el Operador de la Plataforma recomienda que la factura no lo supere.</li>
          </ol>
        </li>
        <li><strong>Declaraciones del Usuario.</strong> Además de lo previsto en el artículo VIII, el Usuario declara que los datos registrados coinciden con la Cotización; que el vehículo es nuevo y se facturará a nombre del Titular o, en leasing, a nombre de la entidad financiera con el Titular como locatario, en las condiciones de la Cotización; y que el vehículo no es un híbrido ligero. Cuando haya varios adquirentes, el Usuario procurará que la Cotización salga a nombre de todos, porque la UPME puede requerir un documento que acredite su participación.</li>
        <li><strong>Requerimientos.</strong> Si la UPME formula un requerimiento (Resolución UPME 563 de 2026, numeral 6.3.2), el Operador de la Plataforma lo atiende conforme al artículo XI con la información disponible, incluida la Cotización y, en leasing, el contrato.</li>
        <li><strong>Nueva radicación sin costo.</strong> Si la UPME formula un requerimiento o niega la solicitud de un vehículo gestionado en las modalidades sin facturar o facturado sin placa, el Operador de la Plataforma lo resolverá con el Usuario y, si hace falta, presentará una nueva solicitud sin cobrar al Usuario la tarifa del servicio ni el valor que cobra la UPME, las veces que sea necesario hasta que el certificado sea expedido. Si la UPME no está recibiendo solicitudes, la nueva solicitud se presentará a partir del 1 de febrero siguiente. En estos casos no se aplican el cobro previsto en el numeral 2 del artículo XII ni lo previsto en el numeral 2 del artículo XIV. Esta regla no se aplica cuando el requerimiento o la negación se deban a información falsa o a documentos adulterados suministrados por el Usuario, casos en los que se aplica el artículo XVIII, ni a los cambios de vehículo, año o concesionario previstos en el numeral 4.</li>
        <li><strong>Ventana de la UPME y diciembre.</strong> La UPME recibe solicitudes del 1 de febrero al 15 de diciembre de cada año y tiene hasta treinta (30) días hábiles para evaluarlas, conforme al artículo X. En los pagos de la modalidad sin facturar hechos entre el 10 de diciembre y el 31 de enero, el Usuario acepta de forma expresa, antes de pagar y mediante la casilla correspondiente, que la solicitud se radicará desde el 1 de febrero siguiente si no alcanza a radicarse a más tardar el 15 de diciembre, y que el concesionario debe esperar el certificado para facturar sin IVA, con el mismo vehículo, año y concesionario. Cuando el pago se gestione con el equipo del Operador de la Plataforma fuera del proceso de pago en línea, la aceptación se registrará con el canal y la fecha en que el Usuario la manifieste. El Operador de la Plataforma no responde por la demora que se derive de la ventana de recepción de la UPME ni por la facturación que ocurra antes de la expedición del certificado.</li>
        <li><strong>Leasing.</strong> Cuando el vehículo sin facturar se adquiera mediante un contrato de leasing financiero con opción irrevocable de compra:
          <ol type="a">
            <li>el Titular de la solicitud y del certificado es el locatario, como titular de la inversión (Resolución UPME 563 de 2026, numeral 2.12);</li>
            <li>la entidad financiera se registra como financiador y en la solicitud se anexa el contrato (numeral 2.13.3);</li>
            <li>el Usuario debe cargar el contrato firmado por el locatario y por la entidad financiera, y la Cotización a nombre de la entidad financiera, con el valor antes de IVA. Sin el contrato firmado no se radica la solicitud, porque el financiador no puede añadirse después (artículo 7, parágrafo 3);</li>
            <li>la factura que el concesionario expida a la entidad financiera debe salir sin IVA, y su aceptación por el concesionario y por la entidad financiera no depende del Operador de la Plataforma; y</li>
            <li>la deducción en el impuesto sobre la renta procede solo si el locatario ejerce la opción de compra (Decreto 1625 de 2016, artículo 1.2.1.18.72), y el Operador de la Plataforma no la garantiza.</li>
          </ol>
        </li>
        <li><strong>Vehículo facturado sin placa.</strong> Cuando el vehículo ya fue facturado pero aún no tiene placa, la solicitud se gestiona con la factura, y la licencia de tránsito o la placa son opcionales. La placa sí es necesaria para el Servicio de Devolución del IVA: si se contrata por separado, se pide antes del pago; si se contrata junto con el certificado, el Operador de la Plataforma no puede preparar la solicitud de devolución hasta que el Usuario la suministre. Mientras tanto, sigue corriendo el término de cinco (5) años previsto en los Términos y Condiciones del Servicio de Devolución del IVA. En esta modalidad no se ofrece el seguro mencionado en el numeral 2, literal c).</li>
      </ol>
    </div>

    <div class="tc-section" id="xiii">
      <div class="tc-section-header">
        <div class="tc-section-num">XIII</div>
        <h2 class="tc-section-title">Pagos del servicio</h2>
      </div>
      <p>El acceso a los servicios ofrecidos a través de la Plataforma estará sujeto al pago de una tarifa por la gestión del trámite de certificación ante la UPME.</p>
      <p>La tarifa del servicio prestado por el Operador de la Plataforma es la informada al Usuario en la Plataforma antes del pago, según el servicio que contrate (el Servicio de Certificación UPME, el Servicio de Devolución del IVA o ambos) y el tipo de vehículo o activo. Para vehículos o activos de mayor valor, la tarifa puede aumentar conforme a la regla publicada en la Plataforma, que toma como base el valor del vehículo o del activo antes de IVA.</p>
      <p>A la tarifa del servicio se le suma el Impuesto sobre las Ventas (IVA), o cualquier otro impuesto aplicable al momento del pago.</p>
      <ul>
        <li>El Usuario reconoce y acepta que, cuando la tarifa dependa del valor del vehículo o del activo, se calculará con base en el valor reportado en la solicitud presentada a través de la Plataforma.</li>
        <li>El Usuario reconoce que la tarifa podrá estar sujeta a impuestos, tasas o contribuciones aplicables conforme a la normativa vigente al momento del pago.</li>
        <li>El pago del servicio se realizará en un único pago, a través de los medios de pago habilitados en la Plataforma o de los mecanismos de pago informados por el Operador de la Plataforma.</li>
        <li>El pago realizado por el Usuario corresponde exclusivamente al servicio de gestión administrativa y tecnológica del trámite, incluyendo la recopilación, organización, revisión preliminar de la información, la preparación de la solicitud y la gestión de la radicación ante la UPME.</li>
      </ul>
      <div class="tc-highlight">
        <p>La tarifa del servicio <strong>no incluye el valor que cobra la UPME</strong> por la evaluación de la solicitud de certificación. Ese valor se informa por separado en la Plataforma antes del pago, se paga a través de ella junto con la tarifa y es gestionado por el Operador de la Plataforma ante la UPME como parte del trámite.</p>
      </div>
      <p>El Usuario reconoce que dicho pago corresponde a la evaluación del trámite por parte de la UPME y que dicho valor no es reembolsable por dicha entidad, incluso en aquellos casos en que la solicitud sea rechazada o el Certificado UPME no sea expedido, salvo la política de reembolso establecida en los presentes términos y condiciones.</p>
      <p>La tarifa del servicio no incluye otros gastos adicionales que puedan surgir durante el proceso del trámite, tales como costos asociados a la obtención de documentos, certificaciones técnicas, traducciones, autenticaciones, legalizaciones u otros requisitos exigidos por la normativa aplicable o por la UPME, los cuales deberán ser asumidos directamente por el Usuario.</p>
      <p>En caso de que el Usuario utilice un Código Win Win válido conforme al Reglamento del Programa de Referidos CertiVeh Win Win (Anexo A de los presentes Términos y Condiciones), un Código de descuento de 48 minutos, un Código de bienvenida o un código promocional conforme al artículo XXVIII, el descuento se aplicará automáticamente sobre la tarifa del servicio antes de IVA al momento del pago, y el IVA se liquidará sobre la tarifa ya descontada. Ningún descuento se aplica al valor que cobra la UPME.</p>
      <p>Desde el {VIGENTE_DESDE}, el descuento del Código Win Win es del quince por ciento (15 %) de la tarifa del servicio del primer pago del Referido, conforme al numeral 6 del Anexo A. Hasta esa fecha rige la versión 1.0 del Anexo A.</p>
      <p><strong>Precio aplicable.</strong> El precio de cada servicio es el informado en la Plataforma en el momento en que se inicia el pago: cuando se prepara el pago o, si se paga con un enlace de pago, cuando se genera el enlace. Los cambios posteriores de tarifas no afectan los pagos ya iniciados ni los realizados. Antes de pagar, la Plataforma informa el valor total a pagar, con el IVA y el valor de la UPME discriminados.</p>
    </div>

    <div class="tc-section" id="xiii-a">
      <div class="tc-section-header">
        <div class="tc-section-num">XIII-A</div>
        <h2 class="tc-section-title">Programa de Referidos CertiVeh Win Win</h2>
      </div>
      <p>El Operador de la Plataforma podrá habilitar, de manera voluntaria y discrecional, el programa de referidos denominado CertiVeh Win Win (en adelante, el "Programa"), a través del cual los Usuarios activos podrán referir a nuevos usuarios a la Plataforma y obtener una comisión económica por cada referido que contrate efectivamente el servicio, mientras que el nuevo usuario referido accederá a un descuento sobre la tarifa de su primer pago.</p>
      <p>La participación en el Programa es completamente voluntaria y no constituye un requisito para el acceso ni para el uso de los demás servicios de la Plataforma. El Programa está regulado en su totalidad por el Anexo A, Reglamento del Programa de Referidos CertiVeh Win Win (en adelante, el "Reglamento"), el cual forma parte integral de los presentes Términos y Condiciones y se entiende incorporado a los mismos por referencia expresa en el presente artículo.</p>
      <p>En todo lo relativo al Programa, incluyendo las condiciones de elegibilidad del Referidor y del Referido, el funcionamiento del Código Win Win, los valores de comisión y descuento, el procedimiento de retiro de comisiones, las restricciones aplicables y las causales de exclusión, se aplicará lo dispuesto en dicho Reglamento.</p>
      <p>El Operador de la Plataforma podrá modificar, suspender o dar por terminado el Programa en cualquier momento, mediante actualización del Reglamento y notificación a los Usuarios a través de los canales habilitados en la Plataforma, sin que ello implique modificación de los presentes Términos y Condiciones. Cada referenciación se rige por la versión del Reglamento vigente en el momento en que se inició el primer pago del Referido, conforme al numeral 10 del Reglamento. Por eso un cambio no afecta las comisiones ya causadas y acreditadas, ni las de los Referidos cuyo pago se inició antes del cambio, aunque se acrediten después.</p>
      <div class="tc-highlight">
        <p>La versión 2.0 del Reglamento rige desde el <strong>{VIGENTE_DESDE}</strong>. Hasta esa fecha rige la versión 1.0, vigente desde el 14 de mayo de 2026. Los Usuarios con Código Win Win son notificados del cambio por los canales habilitados en la Plataforma.</p>
      </div>
    </div>

    <div class="tc-section" id="xiv">
      <div class="tc-section-header">
        <div class="tc-section-num">XIV</div>
        <h2 class="tc-section-title">Política de reembolsos</h2>
      </div>
      <p>Los pagos realizados por el Usuario a través de la Plataforma corresponden a la prestación del servicio de gestión administrativa y tecnológica del trámite de certificación ante la UPME, así como al pago de la tarifa correspondiente a la evaluación de la solicitud por parte de dicha entidad.</p>
      <p>El Usuario reconoce y acepta que el valor pagado a la UPME por concepto de evaluación de la solicitud no es reembolsable, incluso en aquellos casos en que la solicitud sea rechazada o el Certificado UPME no sea expedido, de conformidad con las reglas establecidas por dicha autoridad.</p>
      <p>En consecuencia, la devolución de pagos por parte del Operador de la Plataforma únicamente procederá en los siguientes casos, además de los previstos en el artículo VI-B y en el artículo VIII de los Términos del Servicio de Devolución:</p>
      <ol>
        <li><strong>Rechazo atribuible al Operador de la Plataforma:</strong> En caso de que la solicitud presentada ante la UPME sea rechazada como consecuencia de errores, omisiones o fallas imputables al Operador de la Plataforma en la gestión del trámite, este se compromete a subsanar las observaciones y presentar nuevamente la solicitud sin generar cobros adicionales al Usuario, siempre que el rechazo no esté relacionado con la información o documentación suministrada por el Usuario. En caso de que la solicitud sea rechazada por segunda vez por causas imputables al Operador de la Plataforma, este reconocerá la devolución del cinco por ciento (5%) del valor pagado.</li>
        <li><strong>Rechazo atribuible al Usuario:</strong> En caso de que la solicitud sea rechazada por causas atribuibles al Usuario, incluyendo, pero sin limitarse a, la presentación de información incompleta, incorrecta o inconsistente, o de documentación que no cumpla con los requisitos exigidos por la normativa aplicable o por la UPME, no habrá lugar a la devolución de los valores pagados. En estos casos, si el Usuario desea presentar nuevamente la solicitud una vez subsanadas las observaciones formuladas por la UPME, deberá pagar la tarifa correspondiente a un nuevo trámite, conforme a las condiciones económicas vigentes al momento de la nueva solicitud. Lo anterior no se aplica en los casos previstos en el numeral 7 del artículo XII-A.</li>
        <li><strong>Desistimiento del Usuario:</strong> En caso de que el Usuario decida desistir voluntariamente del trámite una vez iniciado el proceso de gestión por parte del Operador de la Plataforma, no habrá lugar a devolución del valor pagado, teniendo en cuenta que dicho pago corresponde a actividades administrativas, tecnológicas y de gestión ya realizadas. En caso de desistimiento posterior a cinco (5) días calendario, se podrá reconocer la devolución del cinco por ciento (5%) del valor pagado.</li>
      </ol>
      <p>En cualquier caso, el Operador de la Plataforma no será responsable por decisiones adoptadas por la UPME en relación con la evaluación, aprobación o rechazo de las solicitudes presentadas.</p>
    </div>

    <div class="tc-section" id="xv">
      <div class="tc-section-header">
        <div class="tc-section-num">XV</div>
        <h2 class="tc-section-title">Derecho de retracto</h2>
      </div>
      <p>El Usuario reconoce que el servicio prestado por el Operador de la Plataforma corresponde a un servicio de intermediación tecnológica y de gestión administrativa que se entiende iniciado desde el momento en que el Usuario confirma su solicitud a través de la Plataforma, realiza el pago correspondiente y completa el registro de su Cuenta de Usuario con la información requerida para la gestión del trámite.</p>
      <p>En consecuencia, el Usuario acepta que, de conformidad con la normativa aplicable, el derecho de retracto no procederá una vez se haya iniciado la ejecución del servicio, lo cual ocurrirá desde la confirmación de la solicitud, el pago en la Plataforma y la finalización del proceso de registro de la cuenta por parte del Usuario. A partir de ese momento, se entenderá que el Operador de la Plataforma ha comenzado la ejecución de actividades administrativas, tecnológicas y operativas orientadas a la gestión del trámite.</p>
      <p>Sin perjuicio de lo anterior, cuando el Usuario manifieste su intención de ejercer el derecho de retracto antes de la confirmación de la solicitud, del pago en la Plataforma y de la finalización del registro de su Cuenta de Usuario, podrá solicitar la devolución de los valores pagados, sin incluir aquellos costos transaccionales, administrativos o no reembolsables que ya se hubieren causado.</p>
      <p>En caso de desistimiento posterior a cinco (5) días calendario, se podrá reconocer la devolución del cinco por ciento (5%) del valor pagado.</p>
      <p>En todo caso, el Usuario reconoce que no habrá lugar a devolución de los valores correspondientes al pago realizado ante la UPME por concepto de evaluación de la solicitud, ni respecto de actividades que ya hubieren sido ejecutadas por el Operador de la Plataforma en desarrollo del servicio.</p>
    </div>

    <div class="tc-section" id="xvi">
      <div class="tc-section-header">
        <div class="tc-section-num">XVI</div>
        <h2 class="tc-section-title">Limitación de responsabilidad</h2>
      </div>
      <p>El Operador de la Plataforma presta un servicio de intermediación tecnológica y de gestión administrativa que facilita al Usuario el registro, la organización y la radicación de la información requerida para la solicitud del Certificado UPME, conforme a la normativa vigente aplicable a los incentivos tributarios asociados a vehículos eléctricos o híbridos.</p>
      <p>En ningún caso el Operador de la Plataforma actúa como autoridad pública, entidad certificadora o entidad competente para aprobar, evaluar o decidir sobre las solicitudes de certificación.</p>
      <p>El Usuario reconoce y acepta que la UPME es la única entidad competente para evaluar las solicitudes y decidir sobre la expedición o no del Certificado UPME, de conformidad con los criterios técnicos y normativos establecidos por dicha entidad.</p>
      <p>En consecuencia, el Operador de la Plataforma no garantiza la aprobación de la solicitud ni la expedición del Certificado UPME, ni será responsable de las decisiones adoptadas por la UPME, incluyendo la solicitud de información adicional, la suspensión de términos, la formulación de observaciones o el rechazo de la solicitud.</p>
      <p>El Operador de la Plataforma tampoco será responsable por retrasos, demoras o suspensiones del trámite que se originen en actuaciones de la UPME, en requerimientos de información adicional, en cambios normativos o en circunstancias ajenas al control del Operador de la Plataforma.</p>
      <p>Igualmente, el Operador de la Plataforma no será responsable por los perjuicios que puedan derivarse de:</p>
      <ul>
        <li>La presentación de información incorrecta, incompleta o inconsistente por parte del Usuario.</li>
        <li>La entrega de documentos falsos, alterados o que no cumplan con los requisitos técnicos o normativos aplicables.</li>
        <li>El incumplimiento, por parte del Usuario, de los requisitos establecidos por la normativa vigente o por la UPME para la obtención del Certificado UPME.</li>
        <li>Cambios en la normativa aplicable, en los procedimientos establecidos por la UPME o en los criterios de evaluación utilizados por dicha entidad.</li>
      </ul>
      <p>El Usuario reconoce que el servicio prestado por el Operador de la Plataforma corresponde exclusivamente a la gestión del trámite, sin que ello implique garantía alguna respecto del resultado final del proceso ante la UPME.</p>
    </div>

    <div class="tc-section" id="xvii">
      <div class="tc-section-header">
        <div class="tc-section-num">XVII</div>
        <h2 class="tc-section-title">Entrega del Certificado UPME y prohibición de elusión del servicio</h2>
      </div>
      <p>El Operador de la Plataforma gestionará ante la UPME la radicación y el seguimiento de la solicitud de certificación presentada por el Usuario, conforme al procedimiento establecido por dicha entidad.</p>
      <p>Una vez la UPME expida el Certificado UPME, el Operador de la Plataforma informará al Usuario sobre la disponibilidad del certificado y procederá a su entrega una vez se haya verificado el pago único del servicio, de conformidad con lo establecido en el artículo XIII de los presentes Términos y Condiciones.</p>
      <p>El Usuario reconoce y acepta que el servicio prestado por el Operador de la Plataforma comprende la gestión integral del trámite, incluyendo la preparación, organización, radicación y seguimiento de la solicitud ante la UPME, por lo que la expedición del Certificado UPME constituye el resultado de dicha gestión.</p>
      <p>En consecuencia, el Usuario se obliga a no realizar actuaciones destinadas a eludir el pago del servicio, incluyendo, pero sin limitarse a:</p>
      <ul>
        <li>Solicitar directamente a la UPME el envío del Certificado UPME cuando el trámite haya sido gestionado a través de la Plataforma.</li>
        <li>Utilizar el número de radicado o la información del trámite para obtener el certificado directamente ante la UPME sin haber realizado el pago único correspondiente.</li>
        <li>Intentar acceder al Certificado UPME por medios distintos de los establecidos por el Operador de la Plataforma, con el fin de evitar el pago del servicio.</li>
      </ul>
      <p>El Usuario reconoce que cualquier actuación orientada a evadir el pago del servicio prestado por el Operador de la Plataforma constituirá un incumplimiento de los presentes Términos y Condiciones, lo cual facultará al Operador de la Plataforma para:</p>
      <ul>
        <li>Exigir el pago inmediato del valor pendiente del servicio.</li>
        <li>Suspender el acceso del Usuario a la Plataforma.</li>
        <li>Iniciar las acciones legales correspondientes para el cobro del servicio prestado.</li>
      </ul>
      <p>El Usuario reconoce que la obligación de pago del servicio subsiste aun en el evento en que obtenga el Certificado UPME por una vía distinta, siempre que este haya sido resultado de la gestión adelantada por el Operador de la Plataforma.</p>
    </div>

    <div class="tc-section" id="xviii">
      <div class="tc-section-header">
        <div class="tc-section-num">XVIII</div>
        <h2 class="tc-section-title">Seguridad y prevención de fraude</h2>
      </div>
      <p>El Operador de la Plataforma adopta medidas razonables de carácter tecnológico, administrativo y organizacional orientadas a proteger la seguridad de la Plataforma, así como la integridad de la información registrada por los Usuarios.</p>
      <p>El Usuario se compromete a utilizar la Plataforma de manera diligente, responsable y conforme a la normativa aplicable, absteniéndose de realizar cualquier actividad que pueda afectar la seguridad del sistema o el correcto funcionamiento del servicio.</p>
      <p>En particular, el Usuario se obliga a:</p>
      <ul>
        <li>Suministrar información veraz, completa y actualizada en el registro y en la solicitud del trámite.</li>
        <li>Cargar únicamente documentos auténticos y que correspondan a la información del vehículo o proyecto objeto de la solicitud.</li>
        <li>Abstenerse de realizar cualquier conducta que implique suplantación de identidad, falsificación documental o uso indebido de la Plataforma.</li>
      </ul>
      <p>El Operador de la Plataforma podrá suspender temporal o definitivamente el acceso del Usuario a la Plataforma cuando existan indicios razonables de:</p>
      <ul>
        <li>Presentación de información falsa, inexacta o inconsistente.</li>
        <li>Uso de documentos falsificados, alterados o que no correspondan al titular de la solicitud.</li>
        <li>Intentos de suplantación de identidad o utilización indebida de cuentas de terceros.</li>
        <li>Uso de la Plataforma para fines distintos a los establecidos en los presentes Términos y Condiciones.</li>
      </ul>
      <p>En caso de identificarse posibles conductas fraudulentas, el Operador de la Plataforma podrá abstenerse de continuar con la gestión del trámite y, cuando corresponda, poner la situación en conocimiento de las autoridades competentes o de la UPME, sin que ello genere responsabilidad alguna para el Operador de la Plataforma.</p>
      <p>El Usuario reconoce que cualquier intento de fraude, falsificación documental o suplantación podrá generar la cancelación inmediata del trámite, la suspensión del acceso a la Plataforma y las acciones legales correspondientes conforme a la legislación vigente.</p>
    </div>

    <div class="tc-section" id="xix">
      <div class="tc-section-header">
        <div class="tc-section-num">XIX</div>
        <h2 class="tc-section-title">Conservación de datos</h2>
      </div>
      <p>El Operador de la Plataforma conservará la información y los datos personales suministrados por el Usuario durante el tiempo necesario para cumplir con las finalidades del servicio prestado a través de la Plataforma, incluyendo la gestión del trámite de certificación ante la UPME, el seguimiento del proceso y la atención de eventuales requerimientos relacionados con la solicitud.</p>
      <p>Los datos serán conservados por el tiempo necesario para cumplir las finalidades del tratamiento, así como para el cumplimiento de obligaciones legales, o hasta que el Usuario solicite su supresión, salvo que exista un deber legal o contractual que obligue a su conservación.</p>
      <p>En todo caso, la información registrada en la Plataforma podrá ser conservada por el Operador de la Plataforma por un período mínimo de <strong>cinco (5) años</strong> contados a partir de la finalización del trámite o de la expedición del Certificado UPME, con el fin de:</p>
      <ul>
        <li>Atender solicitudes, consultas o reclamaciones presentadas por el Usuario.</li>
        <li>Dar cumplimiento a obligaciones legales, regulatorias o contractuales aplicables.</li>
        <li>Atender requerimientos de autoridades administrativas o judiciales competentes.</li>
        <li>Mantener registros asociados al servicio prestado a través de la Plataforma.</li>
      </ul>
      <p>Una vez cumplido el período de conservación señalado, el Operador de la Plataforma podrá proceder a la eliminación, anonimización o bloqueo de la información, conforme a las políticas internas de tratamiento de datos y a la normativa vigente en materia de protección de datos personales.</p>
      <p>El tratamiento, almacenamiento y conservación de los datos personales del Usuario se realizará en cumplimiento de lo dispuesto en la Ley 1581 de 2012, el Decreto 1377 de 2013, el Decreto 1074 de 2015 y demás normas que los modifiquen, sustituyan o complementen.</p>
    </div>

    <div class="tc-section" id="xx">
      <div class="tc-section-header">
        <div class="tc-section-num">XX</div>
        <h2 class="tc-section-title">Propiedad intelectual</h2>
      </div>
      <p>La Plataforma, incluyendo su software, arquitectura tecnológica, interfaces, bases de datos, diseños, contenidos, textos, gráficos, logotipos, marcas, manuales, metodologías y demás elementos que la componen, es propiedad del Operador de la Plataforma o de sus respectivos titulares, y se encuentra protegida por las normas nacionales e internacionales sobre propiedad intelectual e industrial.</p>
      <p>El acceso y uso de la Plataforma por parte del Usuario no implican, en ningún caso, la cesión, transferencia o autorización de uso de los derechos de propiedad intelectual del Operador de la Plataforma, salvo en lo estrictamente necesario para la utilización del servicio conforme a los presentes Términos y Condiciones.</p>
      <p>El Usuario se obliga a abstenerse de:</p>
      <ul>
        <li>Copiar, reproducir, modificar, adaptar, distribuir o explotar, de cualquier forma, el software o los contenidos de la Plataforma sin autorización previa y expresa del Operador de la Plataforma.</li>
        <li>Desarrollar o utilizar herramientas destinadas a extraer, recopilar o replicar la información contenida en la Plataforma.</li>
        <li>Realizar ingeniería inversa, descompilar o cualquier otro intento de acceder al código fuente del software de la Plataforma.</li>
        <li>Utilizar las marcas, nombres comerciales, logotipos o cualquier otro signo distintivo asociado a la Plataforma sin autorización previa del Operador de la Plataforma.</li>
      </ul>
      <p>El Usuario reconoce que cualquier uso no autorizado de los elementos protegidos por derechos de propiedad intelectual podrá constituir una infracción a la normativa vigente y dará lugar a las acciones legales correspondientes por parte del Operador de la Plataforma.</p>
      <p>El uso de la Plataforma se limita exclusivamente a los fines establecidos en los presentes Términos y Condiciones, relacionados con la gestión del trámite de certificación ante la UPME.</p>
    </div>

    <div class="tc-section" id="xxi">
      <div class="tc-section-header">
        <div class="tc-section-num">XXI</div>
        <h2 class="tc-section-title">Prohibición de suplantación de identidad</h2>
      </div>
      <p>El Usuario se compromete a registrarse en la Plataforma utilizando únicamente su propia identidad o, en el caso de personas jurídicas, actuando con las facultades legales correspondientes para representar a la entidad titular del vehículo o del proyecto objeto de la solicitud.</p>
      <p>El Usuario declara y garantiza que cuenta con la autorización necesaria para suministrar la información y la documentación registradas en la Plataforma, incluidos los datos personales y los documentos asociados al titular del vehículo o del proyecto para el cual se solicita el Certificado UPME.</p>
      <p>En consecuencia, el Usuario se obliga a abstenerse de:</p>
      <ul>
        <li>Suplantar la identidad de otra persona natural o jurídica.</li>
        <li>Registrar información o documentos con datos de terceros sin la debida autorización.</li>
        <li>Utilizar la Plataforma en nombre de terceros sin contar con la representación legal o autorización correspondiente.</li>
      </ul>
      <p>El Operador de la Plataforma no será responsable del uso indebido de la identidad de terceros por parte del Usuario, ni de la información o documentación suministrada sin autorización del titular correspondiente.</p>
      <p>En caso de identificarse indicios de suplantación de identidad, uso indebido de datos personales o representación no autorizada, el Operador de la Plataforma podrá suspender inmediatamente el acceso del Usuario a la Plataforma, cancelar el trámite en curso y, cuando corresponda, poner la situación en conocimiento de las autoridades competentes o de la UPME.</p>
      <p>El Usuario reconoce que la suplantación de identidad y el uso indebido de datos personales pueden constituir infracciones a la legislación vigente y dar lugar a las acciones legales correspondientes.</p>
    </div>

    <div class="tc-section" id="xxii">
      <div class="tc-section-header">
        <div class="tc-section-num">XXII</div>
        <h2 class="tc-section-title">Comunicaciones electrónicas</h2>
      </div>
      <p>El Usuario acepta que todas las comunicaciones, notificaciones, requerimientos de información, avisos y demás mensajes relacionados con el uso de la Plataforma y con la gestión del trámite de certificación ante la UPME podrán realizarse por medios electrónicos.</p>
      <p>En particular, el Usuario autoriza al Operador de la Plataforma para enviar comunicaciones a través del correo electrónico registrado en la Cuenta de Usuario, mensajes dentro de la Plataforma, mensajes de WhatsApp o de texto al número de celular registrado u otros canales digitales habilitados.</p>
      <p>Algunas conversaciones por WhatsApp y por el chat de la Plataforma son atendidas por un asistente virtual del Operador de la Plataforma basado en inteligencia artificial, que puede escalar la conversación a una persona del equipo. Las respuestas del asistente tienen carácter informativo y no modifican los presentes Términos y Condiciones.</p>
      <p>El Usuario reconoce que dichas comunicaciones tendrán plena validez jurídica y se considerarán recibidas en el momento en que sean enviadas al canal registrado, siendo responsabilidad del Usuario mantener actualizada su información de contacto y revisar periódicamente los medios de comunicación asociados a su cuenta.</p>
    </div>

    <div class="tc-section" id="xxiii">
      <div class="tc-section-header">
        <div class="tc-section-num">XXIII</div>
        <h2 class="tc-section-title">Suspensión y cancelación de la cuenta</h2>
      </div>
      <p>El Operador de la Plataforma podrá suspender temporal o definitivamente el acceso del Usuario a la Plataforma, cancelar la Cuenta de Usuario o abstenerse de continuar con la prestación del servicio, cuando se configure cualquiera de las siguientes situaciones:</p>
      <ul>
        <li>Incumplimiento de los presentes Términos y Condiciones.</li>
        <li>Suministro de información falsa, inexacta, incompleta o inconsistente.</li>
        <li>Uso de documentos falsificados, alterados o que no correspondan al titular de la solicitud.</li>
        <li>Incumplimiento de los requisitos establecidos por la normativa aplicable o por la UPME.</li>
        <li>Uso indebido de la Plataforma o utilización de la misma para fines distintos a los previstos en estos Términos y Condiciones.</li>
        <li>Intentos de fraude, suplantación de identidad o afectación de la seguridad de la Plataforma.</li>
      </ul>
      <p>La suspensión o cancelación de la cuenta no generará derecho a indemnización alguna a favor del Usuario, sin perjuicio de las acciones legales a que haya lugar.</p>
    </div>

    <div class="tc-section" id="xxiv">
      <div class="tc-section-header">
        <div class="tc-section-num">XXIV</div>
        <h2 class="tc-section-title">Integridad del acuerdo</h2>
      </div>
      <p>Los presentes Términos y Condiciones constituyen el acuerdo total entre el Usuario y el Operador de la Plataforma en relación con el acceso y uso de la Plataforma y la prestación de los servicios ofrecidos a través de la misma.</p>
      <p>En consecuencia, sustituyen cualquier acuerdo, comunicación, negociación o entendimiento previo, verbal o escrito, relacionado con el objeto de estos Términos y Condiciones.</p>
    </div>

    <div class="tc-section" id="xxv">
      <div class="tc-section-header">
        <div class="tc-section-num">XXV</div>
        <h2 class="tc-section-title">Separabilidad</h2>
      </div>
      <p>En caso de que alguna de las disposiciones contenidas en los presentes Términos y Condiciones sea declarada inválida, nula o inaplicable por una autoridad competente, dicha disposición se considerará separable y no afectará la validez ni la exigibilidad de las demás disposiciones, las cuales continuarán en pleno vigor y efecto.</p>
    </div>

    <div class="tc-section" id="xxvi">
      <div class="tc-section-header">
        <div class="tc-section-num">XXVI</div>
        <h2 class="tc-section-title">Modificación de los Términos y Condiciones</h2>
      </div>
      <p>El Operador de la Plataforma se reserva el derecho de modificar, actualizar o ajustar en cualquier momento los presentes Términos y Condiciones, cuando ello resulte necesario para mejorar el funcionamiento de la Plataforma, adaptar el servicio a cambios normativos o regulatorios, o actualizar las condiciones operativas y comerciales del servicio.</p>
      <p>En caso de realizarse modificaciones sustanciales a los presentes Términos y Condiciones, el Operador de la Plataforma informará a los Usuarios a través de la Plataforma, mediante correo electrónico registrado por el Usuario o por cualquier otro medio de comunicación habilitado.</p>
      <p>Cuando la modificación afecte las condiciones de un servicio ya contratado, se aplicará la versión aceptada por el Usuario al contratarlo, salvo que acepte expresamente la nueva.</p>
      <p>Las modificaciones entrarán en vigencia a partir de la fecha de su publicación en la Plataforma, salvo que se indique expresamente una fecha distinta.</p>
      <p>Sin perjuicio de la regla de este artículo para los servicios ya contratados, el uso continuo de la Plataforma por parte del Usuario después de la publicación de las modificaciones se entenderá como aceptación expresa de los nuevos Términos y Condiciones.</p>
      <p>En caso de que el Usuario no esté de acuerdo con las modificaciones introducidas, deberá abstenerse de continuar utilizando la Plataforma y podrá solicitar la cancelación de su cuenta conforme a los procedimientos establecidos por el Operador de la Plataforma.</p>
    </div>

    <div class="tc-section" id="xxvii">
      <div class="tc-section-header">
        <div class="tc-section-num">XXVII</div>
        <h2 class="tc-section-title">Ley aplicable y resolución de disputas</h2>
      </div>
      <p>Los presentes Términos y Condiciones se regirán e interpretarán de conformidad con las leyes de la República de Colombia.</p>
      <p>Cualquier controversia, reclamación o diferencia que surja entre el Usuario y el Operador de la Plataforma con ocasión de la interpretación, ejecución, cumplimiento o terminación de los presentes Términos y Condiciones será resuelta conforme al siguiente procedimiento:</p>
      <ol>
        <li><strong>Arreglo directo.</strong> Las partes procurarán resolver cualquier controversia mediante arreglo directo, por medio de comunicaciones escritas entre el Usuario y el Operador de la Plataforma, dentro de un plazo de treinta (30) días calendario contados a partir de la notificación de la controversia.</li>
        <li><strong>Conciliación.</strong> En caso de no lograrse una solución mediante arreglo directo dentro del plazo señalado, las partes acudirán a un procedimiento de conciliación ante un Centro de Conciliación legalmente autorizado en la ciudad de Bogotá, D.C., de conformidad con lo dispuesto en la legislación colombiana.</li>
        <li><strong>Jurisdicción competente.</strong> En caso de no lograrse una solución mediante el procedimiento de conciliación, las controversias serán sometidas a la jurisdicción de los jueces de la República de Colombia, conforme a las normas procesales vigentes.</li>
      </ol>
    </div>

    <div class="tc-section" id="xxviii">
      <div class="tc-section-header">
        <div class="tc-section-num">XXVIII</div>
        <h2 class="tc-section-title">Códigos promocionales y descuentos</h2>
      </div>
      <p>El Operador de la Plataforma podrá habilitar, de manera ocasional, códigos promocionales, cupones, descuentos, beneficios comerciales o campañas especiales aplicables a la tarifa de los servicios ofrecidos a través de la Plataforma.</p>
      <p>Cada código promocional o descuento se regirá por las condiciones particulares informadas por el Operador de la Plataforma al momento de su publicación, entrega o habilitación, incluyendo, entre otros, su vigencia, porcentaje o valor del descuento, servicios a los que aplica, número máximo de usos, tipo de Usuario beneficiario, condiciones de elegibilidad, restricciones de acumulación y demás parámetros comerciales definidos para la respectiva campaña.</p>
      <p>Salvo que el Operador de la Plataforma indique expresamente lo contrario, los códigos promocionales y descuentos: (i) serán personales e intransferibles; (ii) no serán acumulables con otros descuentos, promociones, beneficios derivados de alianzas comerciales o programas de referidos; (iii) no tendrán valor en efectivo ni podrán ser canjeados por dinero; (iv) no aplicarán retroactivamente a pagos ya realizados; y (v) deberán ser ingresados y validados en la Plataforma antes de completar el pago correspondiente.</p>
      <p><strong>Cálculo.</strong> Salvo que se indique lo contrario, los descuentos expresados en porcentaje se calculan sobre la tarifa del servicio del Operador de la Plataforma antes del Impuesto sobre las Ventas (IVA), y el IVA se liquida sobre la tarifa ya descontada. Ningún código ni descuento se aplica al valor que cobra la UPME ni a otros valores de terceros. La Plataforma muestra el valor del descuento, en pesos, antes de pagar.</p>
      <p><strong>Un código por pago.</strong> En cada pago se aplica un solo código: el que figure en el campo «Código de descuento» al momento de pagar. Si el Usuario tiene a su disposición más de uno, se aplica el que haya ingresado en ese campo. Los códigos no aplican a los trámites gestionados a través de un Aliado Comercial de CertiVeh.</p>
      <p><strong>Beneficios personales.</strong> Hasta el {VIGENTE_DESDE_LA_BIENVENIDA}, el Operador de la Plataforma podrá asignar a algunos Usuarios, y no a todos, un Código de descuento de 48 minutos. Es un beneficio personal por tiempo limitado: vale para el primer pago de la Cuenta de Usuario a la que se asigna, solo desde ella y dentro de los cuarenta y ocho (48) minutos siguientes a su asignación. Un pago iniciado dentro de ese plazo puede completarse hasta quince (15) minutos después de vencido. Su valor, los servicios a los que aplica y la hora exacta en que vence se informan en la Plataforma al asignarlo.</p>
      <p id="descuento-de-bienvenida"><strong>Descuento de bienvenida.</strong> Desde el {VIGENTE_DESDE_LA_BIENVENIDA}, el Operador de la Plataforma podrá ofrecer a algunos Usuarios nuevos, y no a todos, un descuento de bienvenida personal, con estas condiciones:</p>
      <p>a) <strong>A quién se ofrece.</strong> A las personas que contactan directamente al Operador de la Plataforma por WhatsApp, por el chat del portal o en la Plataforma y aún no han pagado ningún trámite. No se ofrece en trámites gestionados a través de un Aliado Comercial ni a quien llega con un Código Win Win. El porcentaje puede ser distinto entre Usuarios, y a algunos Usuarios no se les ofrece descuento. La Plataforma lo asigna de forma automática, sin tener en cuenta datos sensibles ni la capacidad económica del Usuario, y una misma persona conserva siempre el mismo porcentaje. Ningún Usuario paga más que la tarifa publicada.</p>
      <p>b) <strong>Valor.</strong> Es el porcentaje de la tarifa del servicio antes de IVA que se informa al ofrecerlo. Se aplica igual al Servicio de Certificación UPME, al Servicio de Devolución del IVA, en cualquiera de sus modalidades, contratado por separado, y a ambos contratados en un mismo pago. El IVA se liquida sobre la tarifa ya descontada. No se aplica al valor que cobra la UPME ni a otros valores de terceros. La Plataforma muestra el descuento en pesos y el total con IVA antes de pagar.</p>
      <p>c) <strong>Código.</strong> Se entrega con un Código de bienvenida personal e intransferible. Solo puede usarse desde la Cuenta de Usuario de quien lo recibió o, si se entregó por WhatsApp, desde la Cuenta de Usuario cuyo celular sea el de esa conversación.</p>
      <p>d) <strong>Vigencia.</strong> Vale durante setenta y dos (72) horas desde que se ofrece. La fecha y la hora exactas de vencimiento, en hora de Colombia, se informan al ofrecerlo y en la pantalla de pago. No se prorroga ni se renueva. Un pago preparado en la Plataforma antes del vencimiento puede completarse hasta quince (15) minutos después.</p>
      <p>e) <strong>Uso.</strong> Sirve en un solo pago y no se acumula con otros códigos: en cada pago se aplica un solo código, el que figure en el campo «Código de descuento». Si el Usuario tiene también un Código Win Win u otro código promocional vigente, elige cuál usar.</p>
      <p>f) <strong>Fallas.</strong> Si, por una falla atribuible a la Plataforma, el Código de bienvenida no pudo aplicarse dentro de su vigencia, el Operador de la Plataforma respetará el descuento cuando el Usuario lo informe por los canales de atención.</p>
      <p>g) <strong>Retracto y reembolsos.</strong> Si un pago hecho con el Código de bienvenida se reembolsa por retracto o por otra causa, se devuelve lo efectivamente pagado. El código no se restablece.</p>
      <p>h) <strong>Terminación.</strong> El Operador de la Plataforma puede dejar de ofrecer este descuento en cualquier momento. Los Códigos de bienvenida ya ofrecidos conservan su valor hasta su vencimiento.</p>
      <p>i) <strong>Datos personales.</strong> Para ofrecer y aplicar este descuento y analizar sus resultados, el Operador de la Plataforma trata los datos descritos en la Política de Tratamiento de Datos Personales.</p>
      <p>Los Códigos de descuento de 48 minutos asignados antes del {VIGENTE_DESDE_LA_BIENVENIDA} conservan las condiciones del párrafo «Beneficios personales» hasta su vencimiento. Su retiro no afecta los pagos realizados con ellos.</p>
      <p><strong>Códigos promocionales desde el {VIGENTE_DESDE}.</strong> Desde esa fecha, los códigos promocionales que entregue el Operador de la Plataforma se rigen por estas condiciones, que sustituyen las informadas antes: (i) su descuento es un porcentaje de la tarifa del servicio antes de IVA, el que el Operador de la Plataforma informe al entregar el código; (ii) aplican al Servicio de Certificación UPME, al Servicio de Devolución del IVA contratado por separado y a ambos contratados en un mismo pago; y (iii) pueden usarse en cualquier pago, no solo en el primero, siempre con un solo código por pago.</p>
      <p><strong>Códigos entregados antes de esa fecha.</strong> Un código promocional entregado antes del {VIGENTE_DESDE} solo sigue vigente desde esa fecha si el Operador de la Plataforma lo mantiene, y en ese caso se rige por las condiciones del párrafo anterior. Los que no mantenga dejan de estar vigentes el {VIGENTE_DESDE}: desde ese momento la Plataforma no los acepta y lo indica al ingresarlos. El retiro no afecta los pagos realizados con ellos antes de esa fecha.</p>
      <p><strong>Pagos que cruzan un cambio.</strong> Cada pago se liquida con las condiciones del código vigentes en el momento en que se inició en la Plataforma: cuando se preparó el pago o, si se paga con un enlace de pago, cuando se generó el enlace.</p>
      <p><strong>Retiro de un código.</strong> Cuando el Operador de la Plataforma retire un código promocional lo informará por los medios en que lo dio a conocer, y desde ese momento la Plataforma no lo aceptará. El retiro no afecta los pagos ya realizados con él.</p>
      <p>El uso de un código promocional estará sujeto a su disponibilidad, vigencia y correcta aplicación dentro de la Plataforma. El vencimiento del plazo de vigencia, el agotamiento del número máximo de usos o el incumplimiento de cualquiera de las condiciones particulares del código impedirá su aplicación, sin que ello genere derecho a compensación, reembolso o reconocimiento económico alguno a favor del Usuario.</p>
      <p>El Operador de la Plataforma se reserva el derecho de modificar, suspender o terminar cualquier campaña promocional, código de descuento o beneficio comercial en cualquier momento, sin que ello afecte los descuentos válidamente aplicados a pagos realizados con anterioridad a dicha modificación, suspensión o terminación.</p>
      <p>Cualquier uso indebido, fraudulento, abusivo o contrario a las condiciones informadas para el respectivo código promocional podrá dar lugar a la anulación del descuento, la reversión del beneficio aplicado, la suspensión o cancelación de la Cuenta de Usuario y las demás acciones legales que resulten procedentes conforme a la legislación colombiana vigente.</p>
    </div>

