---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://certiveh.co/' },
    { '@type': 'ListItem', position: 2, name: 'Partner API' },
  ]
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'CertiVeh Partner API | Documentación de Integración',
  description: 'Documentación técnica de la API de integración para partners de CertiVeh. Automatiza trámites de certificados UPME para vehículos eléctricos e híbridos en Colombia.',
  url: 'https://certiveh.co/api-docs/',
  author: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  publisher: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  inLanguage: 'es-CO',
  datePublished: '2026-05-22',
  dateModified: '2026-06-25',
  proficiencyLevel: 'Expert',
});
---

<BaseLayout
  title="Partner API | Documentación de Integración | CertiVeh"
  description="Documentación técnica de la API de integración para partners de CertiVeh. Automatiza trámites de certificados UPME para vehículos eléctricos e híbridos en Colombia."
  keywords="CertiVeh API, partner API, UPME certificado API, integración CertiVeh, vehículos eléctricos API Colombia, API REST UPME"
>
  <script slot="head" type="application/ld+json" set:html={breadcrumbLd} />
  <script slot="head" type="application/ld+json" set:html={webPageLd} />
  <style is:inline>
    :root {
      --emerald-600: #059669;
      --emerald-500: #10B981;
      --emerald-400: #34D399;
      --emerald-50:  #ECFDF5;
      --blue-500:    #3B82F6;
      --blue-50:     #EFF6FF;
      --amber-400:   #FBBF24;
      --cyan-400:    #22D3EE;
      --green-400:   #4ADE80;
      --red-500:     #EF4444;
      --red-50:      #FEF2F2;
      --slate-900:   #0F172A;
      --slate-800:   #1E293B;
      --slate-700:   #334155;
      --slate-600:   #475569;
      --slate-500:   #64748B;
      --slate-400:   #94A3B8;
      --slate-300:   #CBD5E1;
      --slate-200:   #E2E8F0;
      --slate-100:   #F1F5F9;
      --slate-50:    #F8FAFC;
      --ff: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      --mono: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--ff); background: var(--slate-50); color: var(--slate-700); -webkit-font-smoothing: antialiased; }
    html { scroll-behavior: smooth; }

    /* NAV */
    .api-nav {
      background: var(--slate-900);
      padding: 0 48px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 200;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .api-nav-logo {
      display: flex;
      align-items: center;
      text-decoration: none;
      gap: 12px;
    }
    .api-nav-logo-badge {
      font-size: 11px;
      font-weight: 600;
      color: var(--emerald-400);
      background: rgba(5,150,105,0.15);
      border: 1px solid rgba(5,150,105,0.25);
      padding: 3px 10px;
      border-radius: 100px;
      letter-spacing: 0.05em;
    }
    .api-nav-back {
      font-size: 14px;
      color: var(--slate-400);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.15s;
    }
    .api-nav-back:hover { color: white; }

    /* LAYOUT */
    .api-layout {
      display: flex;
      margin-top: 64px;
      min-height: calc(100vh - 64px);
    }

    /* SIDEBAR */
    .api-sidebar {
      width: 280px;
      min-width: 280px;
      background: var(--slate-900);
      position: fixed;
      top: 64px;
      left: 0;
      bottom: 0;
      overflow-y: auto;
      padding: 24px 0;
      border-right: 1px solid rgba(255,255,255,0.06);
      z-index: 100;
    }
    .api-sidebar::-webkit-scrollbar { width: 4px; }
    .api-sidebar::-webkit-scrollbar-track { background: transparent; }
    .api-sidebar::-webkit-scrollbar-thumb { background: var(--slate-700); border-radius: 4px; }

    .sidebar-section-title {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--slate-500);
      padding: 16px 24px 8px;
    }
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 24px;
      font-size: 13px;
      font-weight: 500;
      color: var(--slate-400);
      text-decoration: none;
      transition: all 0.15s;
      border-left: 2px solid transparent;
    }
    .sidebar-link:hover {
      color: white;
      background: rgba(255,255,255,0.04);
    }
    .sidebar-link.active {
      color: var(--emerald-400);
      border-left-color: var(--emerald-500);
      background: rgba(5,150,105,0.08);
    }
    .sidebar-link .method-badge-sm {
      font-size: 9px;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 3px;
      letter-spacing: 0.03em;
      font-family: var(--mono);
    }
    .sidebar-link .method-post { background: rgba(5,150,105,0.2); color: var(--emerald-400); }
    .sidebar-link .method-get { background: rgba(59,130,246,0.2); color: var(--blue-500); }
    .sidebar-endpoint-path {
      font-family: var(--mono);
      font-size: 12px;
    }
    .sidebar-sub {
      padding-left: 40px;
    }

    /* MAIN CONTENT */
    .api-main {
      margin-left: 280px;
      flex: 1;
      padding: 48px 64px 80px;
      max-width: 900px;
    }

    /* MOBILE NAV */
    .api-mobile-nav {
      display: none;
      background: var(--slate-900);
      overflow-x: auto;
      white-space: nowrap;
      padding: 0 20px;
      gap: 4px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      position: sticky;
      top: 64px;
      z-index: 99;
      -webkit-overflow-scrolling: touch;
    }
    .api-mobile-nav::-webkit-scrollbar { display: none; }
    .api-mobile-nav a {
      display: inline-flex;
      align-items: center;
      padding: 12px 14px;
      font-size: 12px;
      font-weight: 500;
      color: var(--slate-400);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .api-mobile-nav a:hover { color: white; }
    .api-mobile-nav a.active {
      color: var(--emerald-400);
      border-bottom-color: var(--emerald-500);
    }

    @media (max-width: 768px) {
      .api-sidebar { display: none; }
      .api-mobile-nav { display: flex; }
      .api-main {
        margin-left: 0;
        padding: 32px 20px 60px;
        max-width: 100%;
      }
      .api-nav { padding: 0 20px; }
    }
    @media (min-width: 769px) and (max-width: 1100px) {
      .api-sidebar { width: 240px; min-width: 240px; }
      .api-main { margin-left: 240px; padding: 40px 40px 80px; }
    }

    /* TYPOGRAPHY */
    .section-anchor {
      scroll-margin-top: 80px;
    }
    .api-main h2 {
      font-size: 28px;
      font-weight: 700;
      color: var(--slate-900);
      margin: 56px 0 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--slate-200);
      letter-spacing: -0.02em;
    }
    .api-main h2:first-child { margin-top: 0; }
    .api-main h3 {
      font-size: 20px;
      font-weight: 600;
      color: var(--slate-900);
      margin: 40px 0 12px;
    }
    .api-main h4 {
      font-size: 16px;
      font-weight: 600;
      color: var(--slate-700);
      margin: 24px 0 8px;
    }
    .api-main p {
      font-size: 15px;
      line-height: 1.7;
      color: var(--slate-600);
      margin-bottom: 16px;
    }
    .api-main ul, .api-main ol {
      padding-left: 20px;
      margin-bottom: 16px;
    }
    .api-main li {
      font-size: 15px;
      line-height: 1.7;
      color: var(--slate-600);
      margin-bottom: 4px;
    }

    /* ENDPOINT HEADER */
    .endpoint-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 40px 0 12px;
      flex-wrap: wrap;
    }
    .method-badge {
      font-size: 12px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 6px;
      font-family: var(--mono);
      letter-spacing: 0.03em;
      flex-shrink: 0;
    }
    .method-badge.post { background: var(--emerald-600); color: white; }
    .method-badge.get { background: var(--blue-500); color: white; }
    .endpoint-path {
      font-family: var(--mono);
      font-size: 16px;
      font-weight: 600;
      color: var(--slate-900);
    }
    .endpoint-desc {
      font-size: 14px;
      color: var(--slate-500);
      margin-bottom: 20px;
    }

    /* CODE BLOCKS */
    .code-block-wrapper {
      position: relative;
      margin-bottom: 24px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .code-block-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 16px;
      background: #151D2E;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .code-block-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--slate-500);
      letter-spacing: 0.05em;
    }
    .copy-btn {
      font-size: 11px;
      font-weight: 500;
      color: var(--slate-500);
      background: none;
      border: 1px solid var(--slate-700);
      border-radius: 4px;
      padding: 3px 10px;
      cursor: pointer;
      font-family: var(--ff);
      transition: all 0.15s;
    }
    .copy-btn:hover { color: white; border-color: var(--slate-500); }
    .code-block {
      background: var(--slate-800);
      padding: 20px;
      overflow-x: auto;
      font-family: var(--mono);
      font-size: 13px;
      line-height: 1.7;
      color: #E2E8F0;
      -webkit-overflow-scrolling: touch;
    }
    .code-block::-webkit-scrollbar { height: 6px; }
    .code-block::-webkit-scrollbar-track { background: transparent; }
    .code-block::-webkit-scrollbar-thumb { background: var(--slate-700); border-radius: 3px; }

    /* SYNTAX COLORS */
    .ck { color: var(--cyan-400); }     /* key */
    .cs { color: var(--green-400); }    /* string */
    .cn { color: var(--amber-400); }    /* number */
    .cp { color: var(--slate-500); }    /* punctuation */
    .cc { color: var(--slate-500); }    /* comment */
    .cm { color: #C084FC; }            /* method */

    /* INLINE CODE */
    code {
      font-family: var(--mono);
      font-size: 13px;
      background: var(--slate-100);
      color: var(--slate-700);
      padding: 2px 6px;
      border-radius: 4px;
      border: 1px solid var(--slate-200);
    }

    /* TABLES */
    .table-wrapper {
      overflow-x: auto;
      margin-bottom: 24px;
      border-radius: 12px;
      border: 1px solid var(--slate-200);
      -webkit-overflow-scrolling: touch;
    }
    .api-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      min-width: 540px;
    }
    .api-table th {
      background: var(--slate-100);
      font-weight: 600;
      color: var(--slate-700);
      text-align: left;
      padding: 10px 16px;
      border-bottom: 1px solid var(--slate-200);
      white-space: nowrap;
    }
    .api-table td {
      padding: 10px 16px;
      border-bottom: 1px solid var(--slate-100);
      color: var(--slate-600);
      vertical-align: top;
    }
    .api-table tr:nth-child(even) td { background: var(--slate-50); }
    .api-table tr:last-child td { border-bottom: none; }
    .api-table .field-name {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      color: var(--slate-800);
    }
    .api-table .required {
      font-size: 10px;
      font-weight: 700;
      color: var(--red-500);
      background: var(--red-50);
      padding: 1px 6px;
      border-radius: 3px;
      letter-spacing: 0.05em;
      margin-left: 6px;
    }
    .api-table .optional {
      font-size: 10px;
      font-weight: 600;
      color: var(--slate-500);
      background: var(--slate-100);
      padding: 1px 6px;
      border-radius: 3px;
      margin-left: 6px;
    }
    .api-table .type-badge {
      font-size: 11px;
      font-family: var(--mono);
      color: var(--slate-500);
    }

    /* STATUS LIST */
    .status-list {
      list-style: none;
      padding: 0;
    }
    .status-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px solid var(--slate-100);
    }
    .status-list li:last-child { border-bottom: none; }
    .status-code {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 4px;
      flex-shrink: 0;
      min-width: 56px;
      text-align: center;
    }
    .status-code.s2 { background: var(--emerald-50); color: var(--emerald-600); }
    .status-code.s4 { background: #FEF3C7; color: #B45309; }
    .status-code.s5 { background: var(--red-50); color: var(--red-500); }

    /* CALLOUT */
    .callout {
      padding: 16px 20px;
      border-radius: 8px;
      margin-bottom: 24px;
      font-size: 14px;
      line-height: 1.6;
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .callout-info {
      background: var(--blue-50);
      border: 1px solid rgba(59,130,246,0.2);
      color: #1E40AF;
    }
    .callout-warn {
      background: #FFFBEB;
      border: 1px solid rgba(245,158,11,0.2);
      color: #92400E;
    }
    .callout-icon { font-size: 18px; flex-shrink: 0; line-height: 1.4; }

    /* FLOW STEPS */
    .flow-steps {
      list-style: none;
      padding: 0;
      counter-reset: flow;
    }
    .flow-steps li {
      display: flex;
      gap: 16px;
      padding: 16px 0;
      border-bottom: 1px solid var(--slate-100);
      align-items: flex-start;
    }
    .flow-steps li:last-child { border-bottom: none; }
    .flow-steps li::before {
      counter-increment: flow;
      content: counter(flow);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      min-width: 28px;
      border-radius: 50%;
      background: var(--emerald-50);
      color: var(--emerald-600);
      font-size: 13px;
      font-weight: 700;
    }
    .flow-step-content {
      flex: 1;
    }
    .flow-step-content strong {
      color: var(--slate-900);
      display: block;
      margin-bottom: 2px;
    }
    .flow-step-content code {
      font-size: 12px;
    }

    /* FOOTER */
    .api-footer {
      background: var(--slate-900);
      padding: 32px 48px;
      text-align: center;
      color: var(--slate-500);
      font-size: 13px;
    }
    .api-footer a {
      color: var(--emerald-400);
      text-decoration: none;
    }
    .api-footer a:hover { text-decoration: underline; }

    /* DIVIDER */
    .section-divider {
      border: none;
      border-top: 1px solid var(--slate-200);
      margin: 48px 0;
    }

    /* Copy button for code blocks */
    .code-block-wrap { position: relative; }
    .copy-btn {
      position: absolute; top: 8px; right: 8px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.15);
      color: var(--slate-400);
      font-size: 11px; font-weight: 600;
      padding: 4px 10px;
      border-radius: 6px;
      cursor: pointer;
      font-family: var(--ff);
      transition: background 0.15s, color 0.15s;
      z-index: 2;
    }
    .copy-btn:hover { background: rgba(255,255,255,0.2); color: white; }
    .copy-btn.copied { background: var(--emerald-600); color: white; border-color: var(--emerald-600); }
  </style>

  <!-- NAV -->
  <nav class="api-nav">
    <a href="/" class="api-nav-logo" aria-label="CertiVeh — inicio">
      <svg width="180" height="44" viewBox="0 0 240 60" fill="none" role="img" aria-label="Logo CertiVeh">
        <defs>
          <linearGradient id="apiLogoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#059669"/><stop offset="100%" stop-color="#14B8A6"/>
          </linearGradient>
        </defs>
        <g transform="translate(4,8) scale(0.48)">
          <path d="M50 10 L80 25 L80 50 C80 65 70 77 50 85 C30 77 20 65 20 50 L20 25 L50 10 Z" fill="url(#apiLogoGrad)"/>
          <path d="M55 28 L42 52 L48 52 L45 72 L58 48 L52 48 L55 28 Z" fill="white"/>
        </g>
        <g transform="translate(60,28)">
          <text x="0" y="0" fill="#FFFFFF" font-size="26" font-weight="700"
            font-family="Inter, system-ui, sans-serif" letter-spacing="-0.5">
            Certi<tspan fill="#059669">Veh</tspan>
          </text>
        </g>
      </svg>
      <span class="api-nav-logo-badge">API Docs for Developers</span>
    </a>
    <a href="/" class="api-nav-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Volver al inicio
    </a>
  </nav>

  <!-- MOBILE NAV -->
  <div class="api-mobile-nav" id="mobileNav">
    <a href="#introduction">Intro</a>
    <a href="#authentication">Auth</a>
    <a href="#base-url">Base URL</a>
    <a href="#post-users">POST /users</a>
    <a href="#post-tramites">POST /tramites</a>
    <a href="#post-documents">Documentos</a>
    <a href="#get-tramite">GET /tramites</a>
    <a href="#post-payment">Pago</a>
    <a href="#webhooks">Webhooks</a>
    <a href="#errors">Errores</a>
    <a href="#rate-limiting">Limite</a>
    <a href="#integration-flow">Flujo</a>
    <a href="#contact">Contacto</a>
  </div>

  <div class="api-layout">
    <!-- SIDEBAR -->
    <aside class="api-sidebar" id="sidebar">
      <div class="sidebar-section-title">Inicio</div>
      <a href="#introduction" class="sidebar-link active">Introduccion</a>
      <a href="#authentication" class="sidebar-link">Autenticacion</a>
      <a href="#base-url" class="sidebar-link">Base URL</a>

      <div class="sidebar-section-title">Endpoints</div> <!-- Technical term, kept in English -->
      <a href="#post-users" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/users</span>
      </a>
      <a href="#post-tramites" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/tramites</span>
      </a>
      <a href="#post-documents" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/tramites/:id/documents</span>
      </a>
      <a href="#get-tramite" class="sidebar-link">
        <span class="method-badge-sm method-get">GET</span>
        <span class="sidebar-endpoint-path">/tramites/:id</span>
      </a>
      <a href="#post-payment" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/tramites/:id/payment</span>
      </a>
      <a href="#post-simulate-payment" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/tramites/:id/simulate-payment</span>
      </a>
      <a href="#webhooks" class="sidebar-link">Webhooks</a>

      <div class="sidebar-section-title">Sandbox</div>
      <a href="#sandbox" class="sidebar-link">Ambiente de pruebas</a>

      <div class="sidebar-section-title">Referencia</div>
      <a href="#errors" class="sidebar-link">Errores</a>
      <a href="#rate-limiting" class="sidebar-link">Limite de tasa</a>
      <a href="#security" class="sidebar-link">Seguridad</a>
      <a href="#partner-discounts" class="sidebar-link">Descuentos</a>
      <a href="#integration-flow" class="sidebar-link">Flujo de integracion</a>
      <a href="#contact" class="sidebar-link">Contacto</a>
    </aside>

    <!-- MAIN -->
    <main class="api-main">

      <!-- INTRODUCTION -->
      <h1 id="introduction" class="section-anchor">Introduccion</h1>
      <p>
        <strong>CertiVeh Partner API</strong> · Integra CertiVeh en tu aplicacion para que tus usuarios obtengan su certificado UPME sin salir de tu plataforma.
      </p>
      <p>
        Esta API REST permite crear usuarios, iniciar tramites de certificacion UPME, subir documentos, procesar pagos y consultar el estado de cada tramite de forma programatica.
      </p>
      <div class="callout callout-info">
        <span class="callout-icon">i</span>
        <span>
          <strong>Flujo tipico:</strong> Tu plataforma recopila los datos del usuario y su vehiculo, los envia a la API, sube los documentos, y procesa el pago via Wompi. Desde ese momento, CertiVeh gestiona todo el tramite ante la UPME de forma automatizada. Tu plataforma puede consultar el estado en cualquier momento via polling o recibir notificaciones via webhook.
        </span>
      </div>

      <!-- AUTHENTICATION -->
      <h2 id="authentication" class="section-anchor">Autenticacion</h2>
