            <tr><td><span class="field-name">owner_name</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Nombre propietario registrado</td></tr>
            <tr><td><span class="field-name">owner_id</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Cedula/NIT propietario</td></tr>
            <tr><td><span class="field-name">purchase_value_cop</span><span class="required">required</span></td><td><span class="type-badge">number</span></td><td>Valor del vehiculo en COP antes de IVA (minimo 1.000.000)</td></tr>
            <tr><td><span class="field-name">purchase_date</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Fecha compra AAAA-MM-DD</td></tr>
            <tr><td><span class="field-name">dealer_name</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Nombre concesionario</td></tr>
            <tr><td><span class="field-name">invoice_number</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Numero factura</td></tr>
            <tr><td><span class="field-name">buyer_name</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Nombre comprador en factura</td></tr>
            <tr><td><span class="field-name">person_type</span><span class="optional">optional</span></td><td><span class="type-badge">string</span></td><td><code>"natural"</code> o <code>"juridica"</code>. Default: <code>"natural"</code>. Debe coincidir con el tipo usado en POST /users.</td></tr>
