    "owner_name": "JUAN CARLOS GARCIA LOPEZ",
    "owner_id": "1020304050",
    "purchase_value_cop": 116805309,
    "purchase_date": "2025-08-10",
    "dealer_name": "KIA MOTORS BOGOTA",
