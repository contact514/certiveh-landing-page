            <tr><td><span class="field-name">Facturas Alegra</span></td><td>Si</td><td>No</td></tr>
            <tr><td><span class="field-name">Emails / WhatsApp</span></td><td>Si</td><td>No</td></tr>
            <tr><td><span class="field-name">Emision seguros</span></td><td>Si</td><td>No</td></tr>
            <tr><td><span class="field-name">OCR documentos</span></td><td>Si</td><td>Si (para testear)</td></tr>
            <tr><td><span class="field-name">Webhooks al partner</span></td><td>Si</td><td>Si (con <code>sandbox: true</code>)</td></tr>
            <tr><td><span class="field-name">Datos</span></td><td>Base de datos principal</td><td>Misma base, marcados <code>sandbox=true</code></td></tr>
            <tr><td><span class="field-name">Header de respuesta</span></td><td>—</td><td><code>X-Sandbox: true</code></td></tr>
          </tbody>
        </table>
      </div>

      <h4>Flujo tipico de prueba</h4>
      <ol class="flow-steps">
        <li>
          <div class="flow-step-content">
            <strong>Usa tu API key sandbox</strong>
            <code>X-API-Key: sk_sandbox_xxx</code> · Todos los endpoints funcionan igual, pero la data se marca como sandbox.
