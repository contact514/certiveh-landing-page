---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tarifaVigente } from '../lib/tipos-de-activo.ts';
import { cotizacionDeLaHome } from '../lib/precios-de-la-landing.ts';

// El ejemplo de la respuesta (un eléctrico de $100M sin la gestión del IVA), con la tarifa vigente al construir
// (ajuste de precios, lote 4): así la documentación no cita un precio que ya no se cobra.
const ejemplo = cotizacionDeLaHome(100_000_000, false, tarifaVigente(new Date()));

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://certiveh.co/' },
    { '@type': 'ListItem', position: 2, name: 'Partner API' },
  ]
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'CertiVeh Partner API | Documentación de Integración',
  description: 'Documentación técnica de la API de integración para partners de CertiVeh. Automatiza trámites de certificados UPME para vehículos eléctricos e híbridos en Colombia.',
  url: 'https://certiveh.co/api-docs/',
  author: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  publisher: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  inLanguage: 'es-CO',
  datePublished: '2026-05-22',
  dateModified: '2026-06-25',
  proficiencyLevel: 'Expert',
});
---

<BaseLayout
  title="Partner API | Documentación de Integración | CertiVeh"
  description="Documentación técnica de la API de integración para partners de CertiVeh. Automatiza trámites de certificados UPME para vehículos eléctricos e híbridos en Colombia."
  keywords="CertiVeh API, partner API, UPME certificado API, integración CertiVeh, vehículos eléctricos API Colombia, API REST UPME"
>
  <script slot="head" type="application/ld+json" set:html={breadcrumbLd} />
  <script slot="head" type="application/ld+json" set:html={webPageLd} />
  <style is:inline>
    /* Documentación de la API · estándar visual 2026-11 (DESIGN_SYSTEM.md §0). Variables --cv-* de marca.css.
       Es una herramienta: barra blanca como la del sitio, índice lateral en tono, tablas y bloques de código
       con sus líneas. Lo único en monoespaciada es el código literal: los bloques <pre> y el <code> en línea.
       Métodos, rutas, campos y códigos de estado van en la fuente de la marca con cifras tabulares. Sin degradados, sin sombras y sin rayas de 1 px fuera de las tablas. */
    :root {
      --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace; /* taste-skill-ignore: solo para código literal */
      --side: 280px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--cv-font); background: var(--cv-bg); color: var(--cv-ink); line-height: 1.5; letter-spacing: -0.005em; -webkit-font-smoothing: antialiased; }
    html { scroll-behavior: smooth; }

    /* NAV: sólida y blanca, como la del resto del sitio */
    .api-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 200; height: 64px; padding: 0 var(--cv-m); display: flex; align-items: center; justify-content: space-between; gap: 16px; background: var(--cv-bg); }
    .api-nav-logo { display: flex; align-items: center; gap: 14px; text-decoration: none; color: var(--cv-ink); min-width: 0; }
    .api-nav-logo svg { flex: none; width: 150px; height: auto; }
    .api-nav-logo-badge { font-size: var(--cv-small); font-weight: 600; color: var(--cv-soft); white-space: nowrap; }
    .api-nav-back { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px; border-radius: var(--cv-r); background: var(--cv-tone); color: var(--cv-ink); font-size: .9375rem; font-weight: 600; text-decoration: none; white-space: nowrap; transition: background-color .15s; }
    .api-nav-back:hover { background: var(--cv-tone-2); }

    /* LAYOUT */
    .api-layout { display: flex; margin-top: 64px; min-height: calc(100vh - 64px); }

    /* ÍNDICE LATERAL: en tono, el enlace actual en verde */
    .api-sidebar { position: fixed; top: 64px; left: 0; bottom: 0; width: var(--side); overflow-y: auto; padding: 20px 12px 32px; background: var(--cv-tone); z-index: 100; }
    .sidebar-section-title { font-size: var(--cv-small); font-weight: 700; color: var(--cv-ink); padding: 18px 12px 6px; }
    .sidebar-link { display: flex; align-items: center; gap: 8px; min-height: 36px; padding: 6px 12px; border-radius: var(--cv-r); font-size: .9375rem; font-weight: 500; color: var(--cv-ink); text-decoration: none; transition: background-color .15s, color .15s; }
    .sidebar-link:hover { background: var(--cv-tone-2); }
    .sidebar-link.active { background: var(--cv-accent); color: #fff; }
    .sidebar-link:focus-visible { outline: 3px solid var(--cv-accent); outline-offset: 0; }
    .sidebar-link .method-badge-sm { font-size: .8125rem; font-weight: 700; color: var(--cv-accent); }
    .sidebar-link .method-get { color: #1d4ed8; }
    .sidebar-link.active .method-badge-sm { color: #fff; }
    .sidebar-endpoint-path { font-size: .875rem; overflow-wrap: anywhere; }

    /* CONTENIDO */
    .api-main { margin-left: var(--side); flex: 1; min-width: 0; max-width: calc(860px + 2 * clamp(20px, 5vw, 72px)); padding: 48px clamp(20px, 5vw, 72px) 96px; }

    /* MOBILE NAV: pestañas que se desplazan */
    .api-mobile-nav { display: none; position: sticky; top: 64px; z-index: 99; overflow-x: auto; white-space: nowrap; gap: 2px; padding: 0 var(--cv-m); background: var(--cv-tone); -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .api-mobile-nav::-webkit-scrollbar { display: none; }
    .api-mobile-nav a { display: inline-flex; align-items: center; flex-shrink: 0; min-height: 48px; padding: 0 12px; font-size: .9375rem; font-weight: 600; color: var(--cv-ink); text-decoration: none; border-bottom: 3px solid transparent; transition: color .15s, border-color .15s; }
    .api-mobile-nav a.active { color: var(--cv-accent); border-bottom-color: var(--cv-accent); }
    @media (max-width: 768px) {
      .api-sidebar { display: none; }
      .api-mobile-nav { display: flex; }
      .api-main { margin-left: 0; padding: 32px var(--cv-m) 64px; max-width: 100%; }
      .api-nav-logo-badge { display: none; }
      .api-footer { margin-left: 8px !important; }
    }
    @media (min-width: 769px) and (max-width: 1100px) {
      :root { --side: 240px; }
    }

    /* TIPOGRAFÍA */
    .section-anchor { scroll-margin-top: 96px; }
    .api-main h1 { font-size: var(--cv-head); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; margin-bottom: 20px; }
    .api-main h2 { font-size: clamp(1.625rem, 1.3rem + 1.1vw, 2.125rem); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1.1; margin: 72px 0 16px; }
    .api-main h3 { font-size: 1.25rem; font-weight: var(--cv-wh); letter-spacing: -0.02em; margin: 40px 0 12px; }
    .api-main h4 { font-size: 1.0625rem; font-weight: 700; margin: 24px 0 8px; }
    .api-main p { font-size: 1.0625rem; line-height: 1.65; margin-bottom: 16px; max-width: 62ch; }
    .api-main ul, .api-main ol { padding-left: 22px; margin-bottom: 16px; }
    .api-main li { font-size: 1.0625rem; line-height: 1.65; margin-bottom: 4px; max-width: 66ch; }
    .api-main a:not(.sidebar-link) { color: var(--cv-accent); font-weight: 600; text-underline-offset: 3px; }
    .api-note { margin-top: 12px; font-size: var(--cv-small) !important; color: var(--cv-soft); }

    /* CABECERA DE CADA ENDPOINT */
    .endpoint-header { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 80px 0 12px; scroll-margin-top: 96px; }
    .method-badge { flex-shrink: 0; font-size: .875rem; font-weight: 700; padding: 5px 10px; border-radius: 4px; color: #fff; }
    .method-badge.post { background: var(--cv-accent); }
    .method-badge.get { background: #1d4ed8; }
    .endpoint-path { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; color: var(--cv-ink); overflow-wrap: anywhere; }
    .endpoint-desc { font-size: 1.0625rem; color: var(--cv-soft); margin-bottom: 20px; }

    /* BLOQUES DE CÓDIGO: el campo oscuro de la marca */
    .code-block-wrapper { position: relative; margin-bottom: 24px; border-radius: var(--cv-r); overflow: hidden; background: var(--cv-field); }
    .code-block-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 6px 8px 6px 16px; background: var(--cv-field-2); }
    .code-block-label { font-size: .875rem; font-weight: 600; color: var(--cv-field-soft); }
    .copy-btn { font: 600 .8125rem/1 var(--cv-font); color: #fff; background: rgba(255,255,255,.1); border: 0; border-radius: 4px; padding: 8px 12px; min-height: 32px; cursor: pointer; transition: background-color .15s; }
    .copy-btn:hover { background: rgba(255,255,255,.18); }
    .copy-btn:focus-visible { outline: 3px solid var(--cv-mint); outline-offset: 2px; }
    .copy-btn.copied { background: var(--cv-accent); }
    .code-block { display: block; padding: 18px 20px; overflow-x: auto; font-family: var(--mono); font-size: .875rem; line-height: 1.7; color: #e2e8f0; background: var(--cv-field); -webkit-overflow-scrolling: touch; } /* taste-skill-ignore: bloque de código */
    .code-block::-webkit-scrollbar { height: 6px; }
    .code-block::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    /* El guion de abajo envuelve cada <pre> y le añade un segundo «Copiar». En los bloques con cabecera ya hay
       uno («Copy»): el segundo se oculta para no tener dos botones que hacen lo mismo. */
    .code-block-wrap { position: relative; }
    .code-block-wrap > .copy-btn { position: absolute; top: 8px; right: 8px; z-index: 2; }
    .code-block-wrapper .code-block-wrap > .copy-btn { display: none; }

    /* COLORES DE SINTAXIS (sobre el campo oscuro, todos por encima de 4,5:1) */
    .ck { color: #67e8f9; }  /* clave */
    .cs { color: var(--cv-mint); }  /* cadena */
    .cn { color: #fcd34d; }  /* número */
    .cp { color: #94a3b8; }  /* puntuación */
    .cc { color: #94a3b8; }  /* comentario */
    .cm { color: #93c5fd; }  /* método */

    /* CÓDIGO EN LÍNEA */
    code { font-family: var(--mono); font-size: .875em; background: var(--cv-tone); color: var(--cv-ink); padding: 2px 6px; border-radius: 4px; overflow-wrap: anywhere; } /* taste-skill-ignore: código en línea */

    /* TABLAS: son tablas de datos de verdad, así que llevan sus líneas */
    .table-wrapper { overflow-x: auto; margin-bottom: 24px; border-radius: var(--cv-r); background: var(--cv-bg); box-shadow: inset 0 0 0 1.5px var(--cv-tone-2); -webkit-overflow-scrolling: touch; } /* taste-skill-ignore: el contorno de una tabla de datos */
    .api-table { width: 100%; border-collapse: collapse; font-size: .9375rem; min-width: 560px; }
    .api-table th { background: var(--cv-tone); font-weight: 700; color: var(--cv-ink); text-align: left; padding: 12px 16px; white-space: nowrap; }
    .api-table td { padding: 12px 16px; border-bottom: 1px solid var(--cv-tone-2); color: var(--cv-ink); vertical-align: top; } /* taste-skill-ignore: línea de fila en una tabla de datos */
    .api-table tr:last-child td { border-bottom: none; }
    .api-table .field-name { font-size: .9375rem; font-weight: 700; color: var(--cv-ink); }
    .api-table .required { margin-left: 8px; font-size: .8125rem; font-weight: 700; color: #b91c1c; }
    .api-table .optional { margin-left: 8px; font-size: .8125rem; font-weight: 600; color: var(--cv-soft); }
    .api-table .type-badge { font-size: .875rem; color: var(--cv-soft); }

    /* LISTA DE ESTADOS */
    .status-list { list-style: none; padding: 0 !important; display: grid; gap: 4px; }
    .status-list li { display: flex; align-items: flex-start; gap: 12px; padding: 10px 12px; margin: 0 !important; background: var(--cv-tone); border-radius: var(--cv-r); }
    .status-code { flex-shrink: 0; min-width: 52px; text-align: center; font-size: .875rem; font-weight: 700; font-variant-numeric: tabular-nums; padding: 3px 8px; border-radius: 4px; background: #fff; }
    .status-code.s2 { color: var(--cv-accent); }
    .status-code.s4 { color: #92400e; }
    .status-code.s5 { color: #b91c1c; }

    /* NOTAS: por tono, sin borde */
    .callout { max-width: 760px; display: flex; gap: 12px; align-items: flex-start; padding: 16px 20px; margin-bottom: 24px; border-radius: var(--cv-r); font-size: 1rem; line-height: 1.6; background: var(--cv-tone); color: var(--cv-ink); }
    .callout-warn { background: #fdf3e1; color: #713f12; }
    .callout-icon { flex-shrink: 0; width: 1.2em; font-weight: 700; color: var(--cv-accent); line-height: 1.6; text-align: center; }
    .callout-warn .callout-icon { color: #92400e; }

    /* FLUJO: los pasos en el riel, con el número en el punto (el orden es real) */
    .flow-steps { list-style: none; padding: 0 !important; counter-reset: flow; display: grid; gap: 4px; }
    .flow-steps li { display: flex; gap: 14px; align-items: flex-start; padding: 12px 14px; margin: 0 !important; background: var(--cv-tone); border-radius: var(--cv-r); }
    .flow-steps li::before { counter-increment: flow; content: counter(flow); flex: none; display: grid; place-items: center; width: 25px; height: 25px; border-radius: 50%; background: var(--cv-accent); color: #fff; font-size: .8125rem; font-weight: 700; margin-top: 2px; }
    .flow-step-content { flex: 1; min-width: 0; }
    .flow-step-content strong { display: block; color: var(--cv-ink); margin-bottom: 2px; }
    .flow-step-content code { font-size: .8125rem; }

    /* PIE: el texto propio de la documentación, en la baldosa de contacto del pie del sitio */
    .api-footer { margin: 0 8px 8px calc(var(--side) + 8px); padding: 24px; border-radius: var(--cv-r); background: var(--cv-tone); color: var(--cv-ink); font-size: 1rem; line-height: 2; }
    .api-footer a { color: var(--cv-accent); font-weight: 600; text-decoration: none; }
    .api-footer a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .api-footer a[aria-label] { display: inline-grid; place-items: center; width: 44px; height: 44px; vertical-align: middle; border-radius: var(--cv-r); background: var(--cv-bg); color: var(--cv-ink); }
    .api-footer a[aria-label]:hover { color: var(--cv-accent); }
  </style>

  <!-- NAV -->
  <nav class="api-nav">
    <a href="/" class="api-nav-logo" aria-label="CertiVeh - inicio">
      <svg width="180" height="44" viewBox="0 0 240 60" fill="none" role="img" aria-label="Logo CertiVeh">
        <!-- El escudo en un solo verde plano y la palabra en una tinta (marca 2026-11) -->
        <g transform="translate(2,4) scale(0.8)">
          <path d="M32 4 L56 16 L56 36 C56 50 46 60 32 64 C18 60 8 50 8 36 L8 16 Z" fill="#047857"/>
          <path d="M36 18 L26 38 L32 38 L28 56 L42 36 L36 36 Z" fill="#FFFFFF"/>
        </g>
        <text x="60" y="40" fill="#0F172A" font-size="30" font-weight="700"
          font-family="'Albert Sans', 'Helvetica Neue', Arial, sans-serif" letter-spacing="-0.9">CertiVeh</text>
      </svg>
      <span class="api-nav-logo-badge">API Docs for Developers</span>
    </a>
    <a href="/" class="api-nav-back">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Volver al inicio
    </a>
  </nav>

  <!-- MOBILE NAV -->
  <div class="api-mobile-nav" id="mobileNav">
    <a href="#introduction">Intro</a>
    <a href="#authentication">Auth</a>
    <a href="#base-url">Base URL</a>
    <a href="#post-users">POST /users</a>
    <a href="#post-tramites">POST /tramites</a>
    <a href="#post-documents">Documentos</a>
    <a href="#get-tramite">GET /tramites</a>
    <a href="#post-payment">Pago</a>
    <a href="#webhooks">Webhooks</a>
    <a href="#errors">Errores</a>
    <a href="#rate-limiting">Limite</a>
    <a href="#integration-flow">Flujo</a>
    <a href="#contact">Contacto</a>
  </div>

  <div class="api-layout">
    <!-- SIDEBAR -->
    <aside class="api-sidebar" id="sidebar">
      <div class="sidebar-section-title">Inicio</div>
      <a href="#introduction" class="sidebar-link active">Introduccion</a>
      <a href="#authentication" class="sidebar-link">Autenticacion</a>
      <a href="#base-url" class="sidebar-link">Base URL</a>

      <div class="sidebar-section-title">Endpoints</div> <!-- Technical term, kept in English -->
      <a href="#post-users" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/users</span>
      </a>
      <a href="#post-tramites" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/tramites</span>
      </a>
      <a href="#post-documents" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/tramites/:id/documents</span>
      </a>
      <a href="#get-tramite" class="sidebar-link">
        <span class="method-badge-sm method-get">GET</span>
        <span class="sidebar-endpoint-path">/tramites/:id</span>
      </a>
      <a href="#post-payment" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/tramites/:id/payment</span>
      </a>
      <a href="#post-simulate-payment" class="sidebar-link">
        <span class="method-badge-sm method-post">POST</span>
        <span class="sidebar-endpoint-path">/tramites/:id/simulate-payment</span>
      </a>
      <a href="#webhooks" class="sidebar-link">Webhooks</a>

      <div class="sidebar-section-title">Sandbox</div>
      <a href="#sandbox" class="sidebar-link">Ambiente de pruebas</a>

      <div class="sidebar-section-title">Referencia</div>
      <a href="#errors" class="sidebar-link">Errores</a>
      <a href="#rate-limiting" class="sidebar-link">Limite de tasa</a>
      <a href="#security" class="sidebar-link">Seguridad</a>
      <a href="#partner-discounts" class="sidebar-link">Descuentos</a>
      <a href="#integration-flow" class="sidebar-link">Flujo de integracion</a>
      <a href="#contact" class="sidebar-link">Contacto</a>
    </aside>

    <!-- MAIN -->
    <main class="api-main">

      <!-- INTRODUCTION -->
      <h1 id="introduction" class="section-anchor">Introduccion</h1>
      <p>
        <strong>CertiVeh Partner API</strong> · Integra CertiVeh en tu aplicacion para que tus usuarios obtengan su certificado UPME sin salir de tu plataforma.
      </p>
      <p>
        Esta API REST permite crear usuarios, iniciar tramites de certificacion UPME, subir documentos, procesar pagos y consultar el estado de cada tramite de forma programatica.
      </p>
      <div class="callout callout-info">
        <span class="callout-icon" aria-hidden="true">i</span>
        <span>
          <strong>Flujo tipico:</strong> Tu plataforma recopila los datos del usuario y su vehiculo, los envia a la API, sube los documentos, y procesa el pago via Wompi. Desde ese momento, CertiVeh gestiona todo el tramite ante la UPME de forma automatizada. Tu plataforma puede consultar el estado en cualquier momento via polling o recibir notificaciones via webhook.
        </span>
      </div>

      <!-- AUTHENTICATION -->
      <h2 id="authentication" class="section-anchor">Autenticacion</h2>
      <p>
        Todas las solicitudes requieren el header <code>X-API-Key</code> con tu clave de partner.
      </p>
      <div class="code-block-wrapper">
        <div class="code-block-header">
          <span class="code-block-label">Header</span>
          <button class="copy-btn" data-copy="true">Copy</button>
        </div>
        <pre class="code-block">X-API-Key: pk_live_xxxxxxxxxxxxx</pre>
      </div>
      <div class="callout callout-info">
        <span class="callout-icon" aria-hidden="true">i</span>
        <span>Contacta <strong>contacto@certiveh.co</strong> para solicitar tu API key.</span>
      </div>

      <!-- BASE URL -->
      <h2 id="base-url" class="section-anchor">Base URL</h2>
      <div class="code-block-wrapper">
        <div class="code-block-header">
          <span class="code-block-label">Produccion</span>
          <button class="copy-btn" data-copy="true">Copy</button>
        </div>
        <pre class="code-block">https://ykolfdgnlaxahtbuurgj.supabase.co/functions/v1/partner-api</pre>
      </div>

      <!-- POST /users -->
      <div class="endpoint-header" id="post-users">
        <span class="method-badge post section-anchor">POST</span>
        <span class="endpoint-path">/users</span>
      </div>
      <p class="endpoint-desc">Registra un nuevo usuario asociado a tu cuenta de partner.</p>

      <h4>Cuerpo de la solicitud · Persona Natural</h4>
      <div class="table-wrapper">
        <table class="api-table">
          <thead>
            <tr><th>Campo</th><th>Tipo</th><th>Descripcion</th></tr>
          </thead>
          <tbody>
            <tr><td><span class="field-name">email</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Email del usuario</td></tr>
            <tr><td><span class="field-name">phone</span><span class="optional">optional</span></td><td><span class="type-badge">string</span></td><td>Telefono formato E.164 (ej: +573001234567)</td></tr>
            <tr><td><span class="field-name">person_type</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td><code>"natural"</code> o <code>"juridica"</code></td></tr>
            <tr><td><span class="field-name">first_names</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Nombres</td></tr>
            <tr><td><span class="field-name">last_names</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Apellidos</td></tr>
            <tr><td><span class="field-name">cedula_number</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Numero de cedula (solo digitos)</td></tr>
