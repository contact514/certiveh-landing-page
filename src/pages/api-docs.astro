            <tr><td><span class="field-name">expedition_date</span><span class="optional">optional</span></td><td><span class="type-badge">string</span></td><td>Fecha expedicion cedula AAAA-MM-DD</td></tr>
            <tr><td><span class="field-name">ciiu_code</span><span class="optional">optional</span></td><td><span class="type-badge">string</span></td><td>Codigo CIIU 4 digitos</td></tr>
            <tr><td><span class="field-name">department</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Departamento (ej: "ANTIOQUIA")</td></tr>
            <tr><td><span class="field-name">municipality</span><span class="required">required</span></td><td><span class="type-badge">string</span></td><td>Municipio (ej: "MEDELLIN")</td></tr>
