---
import BaseLayout from '../layouts/BaseLayout.astro';
import CertiVehLandingComplete from '../app/components/CertiVehLandingComplete';
import { tarifaVigente } from '../lib/tipos-de-activo.ts';
import { preciosDesde, descripcionDeGas } from '../lib/precios-de-la-landing.ts';
// La tarifa vigente EN EL INSTANTE DEL BUILD (ajuste de precios, lote 4): las cifras del JSON-LD salen de ella y la
// isla la recibe por su id. Tras T, el rebuild de T+1 min cambia el HTML; la isla ya cambia sola al hidratar.
const tarifa = tarifaVigente(new Date());
const desde = preciosDesde(tarifa);
import '../styles/index.css';
---

<BaseLayout robots="noindex, nofollow">
  <CertiVehLandingComplete client:load portalUrl="https://exotics.portal.certiveh.co" tarifaDelBuild={tarifa.id} />

  <!-- Exotics: rewrite all portal links -->
  <script is:inline>
    var rewrite = function() {
      document.querySelectorAll('a[href*="portal.certiveh.co"]').forEach(function(a) {
        if (!a.href.includes('exotics.portal')) {
          a.href = a.href.replace('portal.certiveh.co', 'exotics.portal.certiveh.co');
        }
      });
    };
    rewrite();
    new MutationObserver(rewrite).observe(document.body, { childList: true, subtree: true });
  </script>

  <!-- Structured Data — rendered server-side for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "CertiVeh",
    "description": "CertiVeh gestiona tu certificado UPME y la devolución de IVA para vehículos eléctricos e híbridos en Colombia. Accede a devolución de IVA, deducción en renta y depreciación acelerada.",
    "url": "https://exotics.certiveh.co",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "COP",
      "price": String(desde.certificado),
      "availability": "https://schema.org/InStock",
      "description": `Certificado UPME desde ${desde.pesos.certificado} COP + IVA. Gestión de la devolución de IVA desde ${desde.pesos.ivaPaquete} COP + IVA. Más el costo del trámite ante la UPME según resolución vigente.`
    },
    "author": {
      "@type": "Organization",
      "name": "CertiVeh",
      "url": "https://certiveh.co"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "reviewCount": "3",
      "bestRating": "5"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué vehículos califican?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vehículos eléctricos puros e híbridos nuevos. No aplica para vehículos usados ni para híbridos ligeros. El certificado va a nombre de quien compra el vehículo (con leasing, del locatario)."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuándo puedo radicar mi solicitud?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Solo tienes que entrar a portal.certiveh.co, crear tu cuenta y cargar tu solicitud. La UPME recibe solicitudes de forma continua del 1 de febrero al 15 de diciembre de cada año (Resolución UPME 563 de 2026), y dentro de esa ventana la radicamos en cuanto tus documentos están completos. Lo que llega después del 15 de diciembre se entiende como no presentado y tiene que esperar al 1 de febrero, así que no lo dejes para el último día."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué documentos necesito?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Si eres persona natural: tu cédula de ciudadanía o de extranjería, tu RUT, la factura de compra y la tarjeta de propiedad, o solo la placa si encontramos tu vehículo en el RUNT. El RUT puedes subirlo después de pagar, pero sin él no radicamos. Si eres persona jurídica: el certificado de cámara de comercio (de máximo 30 días), el documento del representante legal, la factura de compra y la tarjeta de propiedad o la placa. El RUT de la empresa solo se pide para la devolución del IVA. Si todavía no hay placa, basta la factura. Y si aún no te facturan el carro, la cotización del concesionario reemplaza la factura (con leasing, la cotización a nombre del banco y el contrato de leasing firmado). Todo se sube en PDF, JPG o PNG desde tu teléfono."
        }
      },
      {
        "@type": "Question",
        "name": "¿Aún no te facturan el carro, o todavía no tienes placa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pide tu certificado igual: con la cotización del concesionario o con la factura. Si aún no te facturan, entrégale el certificado al concesionario antes de que emita la factura y pide que salga sin IVA (Concepto DIAN 2242 de 2026); si lo hace, no necesitas la Devolución de IVA (5% del valor del vehículo). El certificado vale para ese carro, ese año y ese concesionario, y te recomendamos que la factura salga por el mismo valor: puede ser menor, nunca mayor. Si ya te facturaron y no tienes placa, sigue con la factura: la placa te la pedimos después, solo si contratas la Devolución de IVA."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto toma el proceso completo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Desde que subes tus documentos hasta la radicación: menos de 10 minutos de tu parte. Desde la radicación hasta el certificado UPME: la UPME tiene hasta 30 días hábiles para resolver de fondo (Resolución 563 de 2026, numeral 6.3.1). Si hace un requerimiento, ese plazo se suspende hasta que se responde."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué pasa si la UPME rechaza mi solicitud?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Si el rechazo se debe a un error de nuestra parte, gestionamos la corrección y volvemos a radicar sin costo adicional. Si se debe a información incorrecta proporcionada por el usuario, gestionamos la corrección contigo y la nueva solicitud se cobra según las condiciones vigentes; te informamos el valor antes de cualquier cobro. Si pediste el certificado con la cotización del concesionario y la UPME niega la solicitud, lo resolvemos contigo y la radicamos de nuevo sin cobrarte nada más."
        }
      },
      {
        "@type": "Question",
        "name": "¿Funciona para empresas e independientes?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. El servicio está disponible para personas naturales, independientes y empresas. Además, las empresas e independientes tienen un beneficio adicional: depreciación acelerada del vehículo a 3 años, lo que reduce la base gravable más rápido."
        }
      },
      {
        "@type": "Question",
        "name": "¿La devolución del IVA solo aplica a empresas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. También aplica a personas naturales que compran para uso personal. La DIAN lo había negado en el Concepto 012101 de agosto de 2025, pero reconsideró esa posición un mes después en el Concepto 013853 del 5 de septiembre de 2025, que es el que está vigente. El Concepto 673 de 2026 incluso previó el caso de quien no lleva contabilidad: puede reemplazar las certificaciones de contador por una declaración juramentada."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto tiempo tengo para reclamar mis beneficios?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Para la devolución de IVA, tienes hasta 5 años desde la fecha de la factura de compra (artículo 2536 del Código Civil, Concepto DIAN 673 de 2026). Para la deducción en renta, tienes un periodo máximo de 15 años contados a partir del año gravable siguiente a la entrada en operación del vehículo (artículo 11, Ley 1715 de 2014). El certificado UPME puede obtenerse antes o después de la compra."
        }
      },
      {
        "@type": "Question",
        "name": "¿CertiVeh gestiona la devolución del IVA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí, de punta a punta. Preparamos tus documentos, generamos tu expediente y, si tu seccional exige cita, la pedimos nosotros a tu nombre. Tú firmas en línea la declaración juramentada y el Formulario 010, y reenvías el correo que te preparamos desde el correo de tu RUT: la DIAN exige que salga del contribuyente. Si hay cita, no es presencial: envías ese correo el día de tu cita, a la hora exacta o dentro de los 30 minutos siguientes (mejor en los primeros 10), ni antes ni después. Y seguimos tu trámite hasta que la DIAN consigna."
        }
      },
      {
        "@type": "Question",
        "name": "¿Pedir la devolución me expone a una auditoría de la DIAN?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No es una auditoría. Es un trámite reglado: la DIAN revisa los documentos de tu propia solicitud y, desde que la radica, tiene hasta 15 días hábiles para pedirte una corrección si falta algo y hasta 50 para devolverte el dinero. No se abre una revisión de tu declaración de renta ni de tu historial tributario. Lo que sí importa es presentarla bien: ese IVA no puede haberse tomado antes como mayor valor del costo, como deducción en renta ni como impuesto descontable."
        }
      },
      {
        "@type": "Question",
        "name": "¿Tengo que quedarme con el vehículo para conservar mis beneficios?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Para la devolución del IVA, no: ninguna norma la condiciona a que conserves el vehículo. Lo único que debes conservar es el certificado UPME y los soportes, por si la DIAN te los pide. La deducción en renta funciona distinto: si vendes antes de que termine el periodo de depreciación del vehículo, lo que ya dedujiste se reversa como recuperación de deducciones (Decreto 1625 de 2016, artículo 1.2.1.18.76)."
        }
      },
      {
        "@type": "Question",
        "name": "¿Puedo hacer el trámite a nombre de otra persona o empresa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Puedes registrar múltiples titulares en tu cuenta, tanto personas naturales como jurídicas. Por ejemplo, tu vehículo personal y el de tu empresa. Cada trámite se asocia a quien compra el vehículo, o al locatario si es con leasing."
        }
      }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo obtener el certificado UPME con CertiVeh",
    "description": "Proceso paso a paso para obtener el certificado UPME para vehículos eléctricos e híbridos en Colombia.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Sube tus documentos", "text": "Tu cédula, la factura y la tarjeta de propiedad o la placa. Si aún no te facturan, la cotización del concesionario. El RUT puedes subirlo después de pagar." },
      { "@type": "HowToStep", "position": 2, "name": "Revisa y confirma", "text": "Revisas los datos que leímos de tus documentos y corriges lo que haga falta." },
      { "@type": "HowToStep", "position": 3, "name": "Solo pagas una vez", "text": "Pagas nuestra tarifa de servicio. El costo del trámite ante la UPME va aparte." },
      { "@type": "HowToStep", "position": 4, "name": "Hacemos el trámite por ti", "text": "Gestionamos tu cuenta UPME y los formularios, y radicamos cuando tus documentos están completos (del 1 de febrero al 15 de diciembre)." },
      { "@type": "HowToStep", "position": 5, "name": "Recibe tu certificado", "text": "Te avisamos por WhatsApp y correo en cada etapa del proceso. Lo descargas desde tu panel." }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Gestión de la devolución de IVA para vehículos eléctricos",
    "description": "CertiVeh gestiona ante la DIAN la devolución del IVA pagado en la adquisición de vehículos eléctricos e híbridos: genera y revisa el expediente completo, diligencia el Formulario 010 y pide la cita cuando la seccional la exige. El titular firma en línea la declaración juramentada y el Formulario 010, y reenvía el correo de radicación desde el correo de su RUT, pues la DIAN exige que salga del contribuyente. Si hay cita, no es presencial: se atiende enviando ese correo el día asignado, a la hora exacta de la cita o dentro de los 30 minutos siguientes (mejor en los primeros 10), ni antes ni después.",
    "provider": {
      "@type": "Organization",
      "name": "CertiVeh",
      "url": "https://certiveh.co"
    },
    "areaServed": "CO",
    "serviceType": "Gestión tributaria",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "COP",
      "price": String(desde.ivaPaquete),
      "description": `Desde ${desde.pesos.ivaPaquete} COP + IVA (precio preferencial contratando junto al certificado UPME). Sin el certificado, desde ${desde.pesos.ivaSuelto} COP + IVA.`
    }
  })} />

