---
import BaseLayout from '../layouts/BaseLayout.astro';
import CertiVehLandingComplete from '../app/components/CertiVehLandingComplete';
import '../styles/index.css';
---

<BaseLayout robots="noindex, nofollow">
  <CertiVehLandingComplete client:load portalUrl="https://exotics.portal.certiveh.co" />

  <!-- Exotics: rewrite all portal links -->
  <script is:inline>
    var rewrite = function() {
      document.querySelectorAll('a[href*="portal.certiveh.co"]').forEach(function(a) {
        if (!a.href.includes('exotics.portal')) {
          a.href = a.href.replace('portal.certiveh.co', 'exotics.portal.certiveh.co');
        }
      });
    };
    rewrite();
    new MutationObserver(rewrite).observe(document.body, { childList: true, subtree: true });
  </script>

  <!-- Structured Data — rendered server-side for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "CertiVeh",
    "description": "CertiVeh gestiona tu certificado UPME y la devolución de IVA para vehículos eléctricos e híbridos en Colombia. Accede a devolución de IVA, deducción en renta y depreciación acelerada.",
    "url": "https://exotics.certiveh.co",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "COP",
      "price": "599990",
      "availability": "https://schema.org/InStock",
      "description": "Certificado UPME desde $599.990 COP + IVA. Gestión de devolución de IVA desde $499.990 COP + IVA. Más el costo del trámite ante la UPME según resolución vigente."
    },
    "author": {
      "@type": "Organization",
      "name": "CertiVeh",
      "url": "https://certiveh.co"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "reviewCount": "3",
      "bestRating": "5"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "¿Qué vehículos califican?", "acceptedAnswer": { "@type": "Answer", "text": "Vehículos eléctricos puros e híbridos registrados en Colombia. No aplica para híbridos ligeros (MHEV). El vehículo debe estar a nombre del solicitante en el RUNT." } },
      { "@type": "Question", "name": "¿Cuándo puedo radicar mi solicitud?", "acceptedAnswer": { "@type": "Answer", "text": "Solo tienes que entrar al portal, crear tu cuenta y cargar tu solicitud. Tu solicitud se radica de inmediato gracias a la ventana continua de recepción (Resolución UPME 400 de 2026)." } },
      { "@type": "Question", "name": "¿Qué documentos necesito?", "acceptedAnswer": { "@type": "Answer", "text": "Si eres persona natural: cédula, tarjeta de propiedad y factura de compra. Si eres persona jurídica: certificado de cámara de comercio, cédula del representante legal, tarjeta de propiedad y factura de compra." } },
      { "@type": "Question", "name": "¿Cuánto toma el proceso completo?", "acceptedAnswer": { "@type": "Answer", "text": "Desde que subes tus documentos hasta la radicación: menos de 10 minutos de tu parte. Desde la radicación hasta el certificado UPME: entre 4 y 8 semanas dependiendo de la UPME." } },
      { "@type": "Question", "name": "¿Qué pasa si la UPME rechaza mi solicitud?", "acceptedAnswer": { "@type": "Answer", "text": "Si el rechazo se debe a un error de nuestra parte, gestionamos la corrección y volvemos a radicar sin costo adicional. Si se debe a información incorrecta proporcionada por el usuario, te acompañamos en el proceso de corrección y solo se cobra nuevamente el costo de la radicación ante la UPME." } },
      { "@type": "Question", "name": "¿Funciona para empresas e independientes?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. El servicio está disponible para personas naturales, independientes y empresas. Las empresas e independientes tienen un beneficio adicional: depreciación acelerada del vehículo a 3 años." } },
      { "@type": "Question", "name": "¿Cuánto tiempo tengo para reclamar mis beneficios?", "acceptedAnswer": { "@type": "Answer", "text": "Para la devolución de IVA, tienes hasta 5 años desde la fecha de la factura de compra. Para la deducción en renta, tienes un periodo máximo de 15 años contados a partir del año gravable siguiente a la entrada en operación del vehículo. El certificado UPME puede obtenerse después de la compra." } },
      { "@type": "Question", "name": "¿CertiVeh gestiona la devolución del IVA?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Una vez tienes tu certificado UPME, CertiVeh gestiona todo el proceso de devolución del IVA ante la DIAN. Puedes contratarlo al momento del checkout del certificado UPME con precio preferencial, o después de forma standalone desde tu dashboard." } },
      { "@type": "Question", "name": "¿Puedo hacer el trámite a nombre de otra persona o empresa?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Puedes registrar múltiples titulares en tu cuenta, tanto personas naturales como jurídicas. Cada trámite se asocia al propietario real del vehículo, que es quien debe figurar en la tarjeta de propiedad." } }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo obtener el certificado UPME con CertiVeh",
    "description": "Proceso paso a paso para obtener el certificado UPME para vehículos eléctricos e híbridos en Colombia.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Sube tus documentos", "text": "Solo necesitas tu cédula, la tarjeta de propiedad del vehículo y la factura de compra." },
      { "@type": "HowToStep", "position": 2, "name": "Revisa y confirma", "text": "Verificas que los datos extraídos sean correctos." },
      { "@type": "HowToStep", "position": 3, "name": "Pago único", "text": "Pagas la tarifa del servicio una sola vez." },
      { "@type": "HowToStep", "position": 4, "name": "CertiVeh hace todo", "text": "Nuestro agente automatizado crea tu cuenta en la UPME, llena formularios y radica la solicitud." },
      { "@type": "HowToStep", "position": 5, "name": "Recibe tu certificado", "text": "Te notificamos por WhatsApp y email. Descargas el certificado desde tu dashboard." }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Gestión de devolución de IVA para vehículos eléctricos",
    "description": "CertiVeh gestiona todo el proceso de devolución del IVA ante la DIAN para propietarios de vehículos eléctricos e híbridos en Colombia.",
    "provider": {
      "@type": "Organization",
      "name": "CertiVeh",
      "url": "https://certiveh.co"
    },
    "areaServed": "CO",
    "serviceType": "Gestión tributaria",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "COP",
      "price": "499990",
      "description": "Desde $499.990 COP + IVA (precio preferencial contratando junto al certificado UPME). Standalone desde $699.990 COP + IVA."
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      "headline": "Buenas noticias para conductores de carros electricos en Colombia: podrian recuperar millones de pesos con este beneficio",
      "url": "https://www.semana.com/vehiculos/articulo/buenas-noticias-para-conductores-de-carros-electricos-en-colombia-podrian-recuperar-millones-de-pesos-con-este-beneficio/202619/",
      "datePublished": "2026-07-06",
      "publisher": { "@type": "Organization", "name": "Revista Semana" },
      "about": { "@type": "Organization", "name": "CertiVeh", "url": "https://certiveh.co" }
    },
    {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      "headline": "Compradores de vehiculos electricos podrian recuperar millones de pesos",
      "url": "https://www.valoraanalitik.com/compradores-de-vehiculos-electricos-podrian-recuperar-millones-de-pesos/",
      "datePublished": "2026-07-06",
      "publisher": { "@type": "Organization", "name": "Valora Analitik" },
      "about": { "@type": "Organization", "name": "CertiVeh", "url": "https://certiveh.co" }
    },
    {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      "headline": "Una empresa colombiana lleva a WhatsApp el tramite para acceder a beneficios tributarios de vehiculos electricos",
      "url": "https://www.portafolio.co/negocios/vehiculo/una-empresa-colombiana-lleva-a-whatsapp-el-tramite-para-acceder-a-beneficios-tributarios-de-vehiculos-electricos-497545",
      "datePublished": "2026-07-05",
      "publisher": { "@type": "Organization", "name": "Portafolio" },
      "about": { "@type": "Organization", "name": "CertiVeh", "url": "https://certiveh.co" }
    }
  ])} />
</BaseLayout>
