---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../app/components/Navbar';
import { SiteFooter } from '../app/components/SiteFooter';
const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://certiveh.co/' },
    { '@type': 'ListItem', position: 2, name: 'Programa de Aliados', item: 'https://certiveh.co/aliados/' },
  ]
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Programa de Aliados CertiVeh',
  headline: 'Programa de Aliados CertiVeh - Genera ingresos con vehículos eléctricos e híbridos',
  description: 'Únete al programa de aliados CertiVeh. Concesionarios, talleres, vendedores e influencers generan ingresos adicionales ofreciendo el certificado UPME a sus clientes. Sin costo de entrada.',
  url: 'https://certiveh.co/aliados/',
  author: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  publisher: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  inLanguage: 'es-CO',
  datePublished: '2026-05-22',
  dateModified: '2026-05-22',
  mainEntity: {
    '@type': 'Service',
    name: 'Programa de Aliados CertiVeh',
    serviceType: 'Programa de referidos y alianzas comerciales',
    description: 'Programa para concesionarios, talleres y vendedores de vehículos eléctricos e híbridos que quieren generar ingresos ofreciendo el trámite del certificado UPME a sus clientes.',
    provider: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
    areaServed: { '@type': 'Country', name: 'Colombia' },
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'Concesionarios, talleres, vendedores de vehículos eléctricos e híbridos'
    }
  }
});
---

<BaseLayout
  title="Programa de Aliados CertiVeh, Genera ingresos con beneficios tributarios"
  description="Únete al programa de aliados CertiVeh. Concesionarios, talleres y vendedores de vehículos eléctricos e híbridos generan ingresos adicionales ofreciendo el certificado UPME. Sin costo de entrada, comisiones inmediatas."
  keywords="programa aliados vehículos eléctricos Colombia, partner CertiVeh, comisión certificado UPME, aliado concesionario vehículos híbridos, programa referidos vehículos eléctricos"
  robots="index, follow"
  ogImage="https://certiveh.co/og/aliados.jpg"
>
  <script slot="head" type="application/ld+json" set:html={breadcrumbLd} />
  <script slot="head" type="application/ld+json" set:html={webPageLd} />

  <style is:inline>
    /* Programa de Aliados · estándar visual 2026-11 (DESIGN_SYSTEM.md §0). Colores, tipo y radio salen de
       las variables --cv-* de src/styles/marca.css. Sin degradados, sin sombras, sin vidrio, sin iconos
       en cuadritos ni rótulos en mayúsculas: cada beneficio es una baldosa de tono y los pasos van en el
       riel del portal. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--cv-font); font-size: var(--cv-body); line-height: 1.5; letter-spacing: -0.01em; background: var(--cv-bg); color: var(--cv-ink); -webkit-font-smoothing: antialiased; }
    .al-wrap { max-width: 1520px; margin: 0 auto; padding-inline: var(--cv-m); }
    .al-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 28px); }
    .al-h2 { font-size: var(--cv-head); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; text-wrap: balance; }
    .al-lab { display: block; font-size: var(--cv-small); font-weight: 600; color: var(--cv-accent); margin-bottom: 14px; }
    .al-sec { padding-top: var(--cv-gap-sec); }
    .al-intro { grid-column: 1 / span 7; }
    .al-intro-6 { grid-column: 1 / span 6; }
    .al-intro p { margin-top: 18px; max-width: 58ch; }

    /* ── HERO: el fotograma del video de la home con el mismo velo neutro ── */
    .al-hero { position: relative; color: #fff; padding: calc(64px + clamp(64px, 9vw, 140px)) 0 clamp(56px, 7vw, 110px); background: url(/hero-bg-poster.webp) center / cover no-repeat, var(--cv-field); }
    .al-hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(9,14,26,.9) 0%, rgba(9,14,26,.74) 50%, rgba(9,14,26,.45) 100%); } /* taste-skill-ignore: velo neutro sobre la foto */
    .al-hero > * { position: relative; }
    .al-hero-copy { max-width: 760px; }
    .al-hero-title { font-size: var(--cv-display); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; text-wrap: balance; }
    .al-hero-subtitle { font-size: var(--cv-lead); line-height: 1.4; color: #e2e8f0; max-width: 40ch; margin-top: 22px; }
    .al-hero .cv-btn { margin-top: 34px; }
    .al-hero-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 30px; font-size: var(--cv-small); font-weight: 600; }
    .al-hero-trust .cv-sq::before { background: var(--cv-mint); }

    /* ── BENEFICIOS: baldosas de tono; la primera es el título en verde ── */
    .al-board { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px; }
    .al-tile { grid-column: span 3; background: var(--cv-tone); border-radius: var(--cv-r); padding: clamp(22px, 2.4vw, 32px); min-height: 240px; display: flex; flex-direction: column; gap: 12px; }
    .al-tile.al-head { grid-column: span 6; background: var(--cv-accent); color: #fff; justify-content: space-between; }
    .al-head .al-lab { color: #fff; margin: 0; }
    .al-head p { color: #fff; max-width: 46ch; margin-top: 18px; }
    .al-head { gap: 32px; }
    .al-benefit-title { font-size: 1.375rem; font-weight: var(--cv-wh); letter-spacing: -0.02em; line-height: 1.15; }
    .al-benefit-desc { color: var(--cv-ink); }
    .al-benefit-desc strong { font-weight: 700; overflow-wrap: anywhere; }
    .al-benefit-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: auto; font-weight: 700; color: var(--cv-accent); text-decoration: none; align-self: flex-start; }
    .al-benefit-link svg { transition: transform .15s; }
    .al-benefit-link:hover svg { transform: translateX(4px); }
    .al-benefit-link:focus-visible { outline: 3px solid var(--cv-accent); outline-offset: 3px; border-radius: 2px; }

    /* ── CÓMO FUNCIONA: el riel del portal (línea de 3 px, puntos de 25 px) ── */
    /* El rótulo de la sección titula el riel, como el título de una pieza del portal */
    .al-rail { grid-column: 8 / span 5; align-self: start; padding-top: 8px; }
    .al-steps { list-style: none; padding-left: 44px; position: relative; display: grid; gap: 36px; margin-top: 20px; }
    .al-steps::before { content: ""; position: absolute; left: 11px; top: 14px; bottom: 14px; width: 3px; background: var(--cv-tone-2); }
    .al-step { position: relative; }
    .al-step-num { position: absolute; left: -44px; top: 0; width: 25px; height: 25px; border-radius: 50%; background: var(--cv-accent); color: #fff; font-size: .8125rem; font-weight: 700; display: grid; place-items: center; line-height: 1; }
    .al-step-title { font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1.1; }
    .al-step-desc { margin-top: 8px; max-width: 46ch; }

    /* ── PARA QUIÉN ES: campo oscuro plano, la lista con viñeta cuadrada ── */
    .al-who { margin-top: var(--cv-gap-sec); background: var(--cv-field); color: #fff; padding-block: clamp(64px, 8vw, 120px); }
    .al-who .al-lab { color: var(--cv-mint); }
    .al-who .al-intro p { color: #e2e8f0; }
    .al-who-lab { margin: 48px 0 14px; }
    .al-who-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .al-who-item { background: var(--cv-field-2); border-radius: var(--cv-r); padding: 22px 22px 22px 40px; font-size: 1.125rem; font-weight: 600; line-height: 1.35; }
    .al-who-item.cv-sq::before { left: 22px; top: calc(22px + .55em); background: var(--cv-mint); }

    /* ── CTA FINAL: campo verde ── */
    .al-cta { padding-block: var(--cv-gap-sec); }
    .al-cta-box { background: var(--cv-accent); color: #fff; border-radius: var(--cv-r); padding: clamp(36px, 6vw, 88px) clamp(24px, 5vw, 72px); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 28px); align-items: end; }
    .al-cta-copy { grid-column: 1 / span 7; }
    .al-cta-title { font-size: var(--cv-head); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; }
    .al-cta-subtitle { margin-top: 18px; color: #fff; max-width: 52ch; }
    .al-cta-act { grid-column: 9 / span 4; display: grid; gap: 16px; }
    .al-cta-act .cv-btn { width: 100%; }
    .al-cta-act .cv-btn:focus-visible { outline-color: #fff; }
    .al-cta-note { display: flex; flex-wrap: wrap; gap: 4px 0; font-size: var(--cv-small); color: #fff; }
    .al-cta-note span::before { content: '·'; margin: 0 6px; }
    .al-cta-note span:first-child::before { display: none; }

    @media (max-width: 1100px) {
      .al-tile { grid-column: span 6; }
      .al-tile.al-head { grid-column: 1 / -1; min-height: 0; }
    }
    @media (max-width: 900px) {
      .al-intro, .al-rail, .al-cta-copy, .al-cta-act { grid-column: 1 / -1; }
      .al-rail { margin-top: 40px; }
      .al-cta-act { margin-top: 32px; }
      .al-who-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
      .al-board { gap: 6px; }
      .al-tile { grid-column: 1 / -1; min-height: 0; }
      .al-who-grid { grid-template-columns: 1fr; gap: 6px; }
      .al-hero .cv-btn { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .al-benefit-link svg { transition: none; }
    }
  </style>

  <!-- NAV -->
  <Navbar isHome={false} darkHero={true} client:load />

  <!-- HERO -->
  <main id="main-content">
  <section class="al-hero">
    <div class="al-wrap">
      <div class="al-hero-copy">
        <h1 class="al-hero-title">Programa de Aliados <span>CertiVeh</span></h1>
        <p class="al-hero-subtitle">
          Genera ingresos adicionales ayudando a tus clientes a obtener su certificado UPME.
          Sin inversión, sin riesgo.
        </p>
        <a href="https://aliado.certiveh.co/" class="cv-btn cv-btn-a" target="_blank" rel="noopener">
          Aplicar ahora
          <span class="cv-arr" aria-hidden="true">→</span>
        </a>
        <ul class="al-hero-trust">
          <li class="cv-sq">Sin costo de entrada</li>
          <li class="cv-sq">Comisiones inmediatas</li>
          <li class="cv-sq">Dashboard en tiempo real</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="al-sec">
    <div class="al-wrap">
      <div class="al-board">
        <div class="al-tile al-head">
          <div>
            <h2 class="al-h2">Todo lo que obtienes como aliado</h2>
            <p>
              Diseñado para que puedas integrar CertiVeh a tu negocio con el mínimo esfuerzo y el máximo retorno.
            </p>
          </div>
          <span class="al-lab">Beneficios</span>
        </div>

        <div class="al-tile">
          <div class="al-benefit-title">Comisión por trámite</div>
          <p class="al-benefit-desc">
            Gana una comisión por cada cliente que pague su trámite a través de tu enlace.
            Las liquidaciones se procesan de forma automática.
          </p>
        </div>

        <div class="al-tile">
          <div class="al-benefit-title">Descuento para tus clientes</div>
          <p class="al-benefit-desc">
            Tus clientes reciben un descuento exclusivo en su primer trámite.
            Más razón para elegirte frente a la competencia.
          </p>
        </div>

        <div class="al-tile">
          <div class="al-benefit-title">Subdominio personalizado</div>
          <p class="al-benefit-desc">
            Obtén tu propio portal en <strong>tu-negocio.portal.certiveh.co</strong>, tu marca integrada en la experiencia del usuario final.
          </p>
        </div>

        <div class="al-tile">
          <div class="al-benefit-title">Código QR personalizado</div>
          <p class="al-benefit-desc">
            Comparte tu código QR en el concesionario, taller o redes sociales.
            Cada escaneo queda registrado en tu dashboard.
          </p>
        </div>

        <div class="al-tile">
          <div class="al-benefit-title">Dashboard con reportes</div>
          <p class="al-benefit-desc">
            Consulta trámites, comisiones y liquidaciones en tiempo real.
            Exporta reportes y mantén el control total de tu actividad.
          </p>
        </div>

        <div class="al-tile">
          <div class="al-benefit-title">API de integración</div>
          <p class="al-benefit-desc">
            Para concesionarios con sistemas propios. Automatiza trámites directamente desde tu plataforma.
          </p>
          <a href="/api-docs/" class="al-benefit-link">
            Ver documentación
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="al-sec">
    <div class="al-wrap al-grid">
      <div class="al-intro al-intro-6">
        <h2 class="al-h2">Tres pasos para empezar a ganar</h2>
        <p>
          El proceso de onboarding toma menos de 24 horas. Sin burocracia, sin costos ocultos.
        </p>
      </div>
      <div class="al-rail">
      <span class="al-lab">Cómo funciona</span>
      <ol class="al-steps">
        <li class="al-step">
          <span class="al-step-num" aria-hidden="true">1</span>
          <div class="al-step-title">Aplica en línea</div>
          <p class="al-step-desc">
            Completa el formulario de aplicación en menos de 2 minutos.
            Solo necesitamos información básica de tu negocio.
          </p>
        </li>
        <li class="al-step">
          <span class="al-step-num" aria-hidden="true">2</span>
          <div class="al-step-title">Recibe tu kit de aliado</div>
          <p class="al-step-desc">
            Subdominio personalizado, código QR único y acceso al dashboard.
            Todo listo para operar el mismo día.
          </p>
        </li>
        <li class="al-step">
          <span class="al-step-num" aria-hidden="true">3</span>
          <div class="al-step-title">Empieza a ganar</div>
          <p class="al-step-desc">
            Comparte tu enlace con tus clientes y gana comisiones por cada trámite pagado.
            Sin límite de ingresos.
          </p>
        </li>
      </ol>
      </div>
    </div>
  </section>

  <!-- WHO CAN BE AN ALLY -->
  <section class="al-who">
    <div class="al-wrap">
      <div class="al-grid">
        <div class="al-intro">
          <h2 class="al-h2">Si trabajas con movilidad eléctrica, esto es para ti</h2>
          <p>
            Cualquier persona o empresa con contactos en el ecosistema de vehículos eléctricos e híbridos puede aplicar.
          </p>
        </div>
      </div>
      <span class="al-lab al-who-lab">Para quién es</span>
      <ul class="al-who-grid">
        <li class="al-who-item cv-sq">Concesionarios de vehículos eléctricos e híbridos</li>
        <li class="al-who-item cv-sq">Talleres especializados</li>
        <li class="al-who-item cv-sq">Vendedores independientes</li>
        <li class="al-who-item cv-sq">Influencers de movilidad eléctrica</li>
        <li class="al-who-item cv-sq">Asesores tributarios y contadores</li>
        <li class="al-who-item cv-sq">Cualquier persona con red en el ecosistema</li>
      </ul>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="al-cta">
    <div class="al-wrap">
      <div class="al-cta-box">
        <div class="al-cta-copy">
          <h2 class="al-cta-title">¿Listo para ser <span>aliado</span>?</h2>
          <p class="al-cta-subtitle">
            Únete a la red de aliados CertiVeh y empieza a generar ingresos adicionales
            ofreciendo beneficios tributarios reales a tus clientes.
          </p>
        </div>
        <div class="al-cta-act">
          <a href="https://aliado.certiveh.co/" class="cv-btn cv-btn-w" target="_blank" rel="noopener">
            Aplicar ahora
            <span class="cv-arr" aria-hidden="true">→</span>
          </a>
          <p class="al-cta-note">
            <span>Respuesta en menos de 24 horas</span>
            <span>Sin costo de entrada</span>
          </p>
        </div>
      </div>
    </div>
  </section>
  </main>

  <!-- FOOTER: el pie compartido de todo el sitio -->
  <SiteFooter />

</BaseLayout>
