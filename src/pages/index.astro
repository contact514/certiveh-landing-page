      "headline": "Empresa colombiana tramito mas de 17.000 millones en beneficios tributarios para compradores de vehiculos electricos",
      "url": "https://revistaclevel.com/empresa-colombiana-tramito-mas-de-17000-millones-en-beneficios-tributarios-para-compradores-de",
      "datePublished": "2026-07-07",
      "publisher": { "@type": "Organization", "name": "Revista C-Level" },
      "about": { "@type": "Organization", "name": "CertiVeh", "url": "https://certiveh.co" }
    },
    {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      "headline": "Compradores de vehiculos electricos reclaman beneficio tributario en Colombia",
      "url": "https://es-us.noticias.yahoo.com/compradores-veh%C3%ADculos-el%C3%A9ctricos-reclaman-beneficio-160000527.html",
      "datePublished": "2026-07-07",
      "publisher": { "@type": "Organization", "name": "Yahoo Finance" },
      "about": { "@type": "Organization", "name": "CertiVeh", "url": "https://certiveh.co" }
    }
  ])} />
</BaseLayout>
