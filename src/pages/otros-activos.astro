---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmpresasLanding from '../app/components/EmpresasLanding';
import '../styles/index.css';
---

<BaseLayout
  title="Certificado UPME para cargadores, flotas GNV y energía solar | CertiVeh"
  description="CertiVeh gestiona tu certificado UPME para proyectos de gestión eficiente de la energía (GEE) y fuentes no convencionales de energía (FNCE). Deducción de renta del 50%, exclusión de IVA, exención arancelaria y depreciación acelerada."
  keywords="certificado UPME, incentivos tributarios GEE, beneficios tributarios energía solar Colombia, exclusión de IVA cargadores eléctricos, deducción de renta Ley 1715, certificación UPME empresas, GEE FNCE Colombia, depreciación acelerada energía, cargadores vehículos eléctricos UPME, camiones GNV beneficios tributarios"
  ogImage="https://certiveh.co/og/otros-activos.png"
>
  <EmpresasLanding client:load />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Certificación UPME para GEE y FNCE - CertiVeh",
    "description": "CertiVeh gestiona el certificado UPME para proyectos de gestión eficiente de la energía (GEE) y fuentes no convencionales de energía (FNCE), habilitando la deducción en renta del 50%, exclusión de IVA del 19%, exención arancelaria y depreciación acelerada conforme a la Ley 1715 de 2014 y la Ley 2099 de 2021.",
    "provider": {
      "@type": "Organization",
      "name": "CertiVeh",
      "url": "https://certiveh.co"
    },
    "areaServed": "CO",
    "serviceType": "Gestión de certificados UPME para incentivos tributarios",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "COP",
      "price": "899990",
      "description": "Desde $899.990 COP + IVA para inversiones hasta $150M. 0,6% del valor del activo + IVA para inversiones mayores. Más el costo del trámite ante la UPME según resolución vigente."
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué es el certificado UPME y para qué sirve?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Es el documento oficial que acredita que una inversión en eficiencia energética (GEE) o energías renovables (FNCE) es elegible para los incentivos de la Ley 1715 de 2014. Es el único soporte requerido para acceder a los cuatro beneficios tributarios: deducción en renta, exclusión de IVA, exención arancelaria y depreciación acelerada."
        }
      },
      {
        "@type": "Question",
        "name": "¿Quién puede solicitarlo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cualquier persona natural o jurídica que realice la inversión. Esto incluye empresas, inversionistas, operadores de flotas, desarrolladores de proyectos solares y propietarios de infraestructura de carga, entre otros."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto se demora el proceso?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La UPME verifica completitud en 10 días hábiles y evalúa en hasta 20 días hábiles para proyectos FNCE (como energía solar) o hasta 30 días hábiles para proyectos GEE (como cargadores o vehículos GNV). CertiVeh gestiona todo el proceso y responde a los requerimientos de la UPME."
        }
      },
      {
        "@type": "Question",
        "name": "¿El certificado vence?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Los certificados emitidos bajo la Resolución UPME 135 de 2025 no tienen límite de vigencia. Pueden modificarse (por ejemplo, para incluir información arancelaria o adicionar solicitantes) dentro de los 2 años siguientes a su expedición."
        }
      },
      {
        "@type": "Question",
        "name": "¿Aplica si la inversión se hizo con leasing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. El Decreto 895 de 2022 contempla expresamente las inversiones realizadas mediante leasing financiero (art. 1.2.1.18.72). Esto es especialmente relevante para flotas de vehículos y equipos de alto valor."
        }
      },
      {
        "@type": "Question",
        "name": "¿Puedo combinar la deducción de renta con la depreciación acelerada?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. La norma establece que tomar ambos beneficios no se considera concurrencia de beneficios (Decreto 895 de 2022). Cada caso debe validarse con asesoría tributaria."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué pasa con el IVA que ya pagué?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Con el certificado UPME es posible gestionar la devolución del IVA ante la DIAN. El mecanismo práctico es la solicitud de devolución con el certificado como soporte."
        }
      }
    ]
  })} />
</BaseLayout>
