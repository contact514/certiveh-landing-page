---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmpresasLanding from '../app/components/EmpresasLanding';
import '../styles/index.css';
---

<BaseLayout
  title="Certificado UPME para Empresas - Incentivos Tributarios GEE y FNCE | CertiVeh"
  description="CertiVeh gestiona tu certificado UPME para proyectos de gestion eficiente de la energia (GEE) y fuentes no convencionales de energia (FNCE). Deduccion de renta del 50%, exclusion de IVA, exencion arancelaria y depreciacion acelerada."
  keywords="certificado UPME, incentivos tributarios GEE, beneficios tributarios energia solar Colombia, exclusion de IVA cargadores electricos, deduccion de renta Ley 1715, certificacion UPME empresas, GEE FNCE Colombia, depreciacion acelerada energia, cargadores vehiculos electricos UPME, camiones GNV beneficios tributarios"
>
  <EmpresasLanding client:load />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Certificacion UPME para GEE y FNCE - CertiVeh",
    "description": "CertiVeh gestiona el certificado UPME para proyectos de gestion eficiente de la energia (GEE) y fuentes no convencionales de energia (FNCE), habilitando la deduccion en renta del 50%, exclusion de IVA del 19%, exencion arancelaria y depreciacion acelerada conforme a la Ley 1715 de 2014 y la Ley 2099 de 2021.",
    "provider": {
      "@type": "Organization",
      "name": "CertiVeh",
      "url": "https://certiveh.co"
    },
    "areaServed": "CO",
    "serviceType": "Gestion de certificados UPME para incentivos tributarios",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "COP",
      "price": "899990",
      "description": "Desde $899.990 COP + IVA para inversiones hasta $150M. 0,6% del valor del activo + IVA para inversiones mayores. Mas el costo del tramite ante la UPME segun resolucion vigente."
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Que es el certificado UPME y para que sirve?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Es el documento oficial que acredita que una inversion en eficiencia energetica (GEE) o energias renovables (FNCE) es elegible para los incentivos de la Ley 1715 de 2014. Es el unico soporte requerido para acceder a los cuatro beneficios tributarios."
        }
      },
      {
        "@type": "Question",
        "name": "Quien puede solicitar el certificado UPME?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cualquier persona natural o juridica que realice la inversion."
        }
      },
      {
        "@type": "Question",
        "name": "Cuanto se demora el proceso de certificacion UPME?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La UPME verifica completitud en 10 dias habiles y evalua en hasta 20 dias habiles para proyectos FNCE (como energia solar) o hasta 30 dias habiles para proyectos GEE (como cargadores o vehiculos GNV). CertiVeh gestiona todo el proceso."
        }
      },
      {
        "@type": "Question",
        "name": "El certificado UPME vence?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Los certificados emitidos bajo la Resolucion UPME 135 de 2025 no tienen limite de vigencia."
        }
      },
      {
        "@type": "Question",
        "name": "Aplica si la inversion se hizo con leasing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Si. El Decreto 895 de 2022 contempla expresamente las inversiones realizadas mediante leasing financiero."
        }
      },
      {
        "@type": "Question",
        "name": "Se puede combinar la deduccion de renta con la depreciacion acelerada?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Si. La norma establece que tomar ambos beneficios no se considera concurrencia de beneficios (Decreto 895 de 2022). Cada caso debe validarse con asesoria tributaria."
        }
      },
      {
        "@type": "Question",
        "name": "Que pasa con el IVA que ya se pago?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Con el certificado UPME es posible gestionar la devolucion del IVA ante la DIAN."
        }
      }
    ]
  })} />
</BaseLayout>
