---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../app/components/Navbar';
import { SiteFooter } from '../app/components/SiteFooter';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://certiveh.co/' },
    { '@type': 'ListItem', position: 2, name: 'Quiénes somos', item: 'https://certiveh.co/nosotros/' },
  ]
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Quiénes somos · CertiVeh',
  description: 'Conoce al equipo detrás de CertiVeh: Julian Delgado (Stanford GSB) y Agustín Jaramillo, con el respaldo de expertos en regulación energética colombiana.',
  url: 'https://certiveh.co/nosotros/',
  author: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  publisher: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
  inLanguage: 'es-CO',
});

const foundersLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Julian Delgado',
    jobTitle: 'Co-fundador',
    worksFor: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
    alumniOf: { '@type': 'Organization', name: 'Stanford Graduate School of Business' },
    sameAs: 'https://www.linkedin.com/in/juliandelgadomoreno/',
    url: 'https://certiveh.co/nosotros/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Agustín Jaramillo',
    jobTitle: 'Co-fundador',
    worksFor: { '@type': 'Organization', name: 'CertiVeh', url: 'https://certiveh.co' },
    sameAs: 'https://www.linkedin.com/in/agustin-jaramillo-londono/',
    url: 'https://certiveh.co/nosotros/',
  },
]);
---

<BaseLayout
  title="Quiénes somos · CertiVeh"
  description="Conoce al equipo detrás de CertiVeh: Julian Delgado (Stanford GSB) y Agustín Jaramillo, con el respaldo de expertos en regulación energética colombiana."
  keywords="equipo CertiVeh, fundadores CertiVeh, Julian Delgado Stanford, Agustín Jaramillo energía, quiénes somos CertiVeh"
  robots="index, follow"
  ogImage="https://certiveh.co/og/nosotros.jpg"
>
  <script slot="head" type="application/ld+json" set:html={breadcrumbLd} />
  <script slot="head" type="application/ld+json" set:html={webPageLd} />
  <script slot="head" type="application/ld+json" set:html={foundersLd} />

  <style is:inline>
    /* Quiénes somos · estándar visual 2026-11 (DESIGN_SYSTEM.md §0). Variables --cv-* de marca.css. La
       foto real de los fundadores manda; las fichas son baldosas de tono, sin borde, sombra ni píldoras. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--cv-font); font-size: var(--cv-body); line-height: 1.5; letter-spacing: -0.01em; background: var(--cv-bg); color: var(--cv-ink); -webkit-font-smoothing: antialiased; }
    .nos-wrap { max-width: 1520px; margin: 0 auto; padding-inline: var(--cv-m); }
    .nos-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 28px); }
    .nos-sec { padding-top: var(--cv-gap-sec); }
    .nos-intro { grid-column: 1 / span 7; }
    .nos-intro p { margin-top: 18px; max-width: 58ch; }

    /* ── HERO: como la home, el texto a la izquierda y lo real a la derecha: la foto de los fundadores ── */
    .nos-hero { position: relative; color: #fff; padding: calc(64px + clamp(40px, 6vw, 96px)) 0 clamp(40px, 5vw, 72px); background: url(/hero-bg-poster.webp) center / cover no-repeat, var(--cv-field); }
    .nos-hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(9,14,26,.9) 0%, rgba(9,14,26,.8) 50%, rgba(9,14,26,.6) 100%); } /* taste-skill-ignore: velo neutro sobre la foto */
    .nos-hero > * { position: relative; }
    .nos-hero .nos-grid { align-items: center; }
    .nos-hero-copy { grid-column: 1 / span 6; }
    .nos-hero-title { max-width: 18ch; }
    .nos-photo { grid-column: 8 / span 5; border-radius: var(--cv-r); overflow: hidden; background: var(--cv-field-2); aspect-ratio: 4 / 5; max-height: calc(100svh - 160px); justify-self: end; width: 100%; }
    .nos-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }

    /* ── FUNDADORES: las dos fichas lado a lado (los dos servicios de la home), la segunda en el campo oscuro ── */
    .nos-founder-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 56px; }
    .nos-card { background: var(--cv-tone); border-radius: var(--cv-r); padding: clamp(28px, 3.4vw, 52px); display: flex; flex-direction: column; gap: 14px; min-height: 420px; }
    .nos-card + .nos-card { background: var(--cv-field); color: #fff; }
    .nos-card + .nos-card .nos-card-role, .nos-card + .nos-card .nos-tag-green { color: var(--cv-mint); }
    .nos-card + .nos-card .nos-card-tags { color: #fff; }
    .nos-card + .nos-card .nos-card-tags span + span::before { color: var(--cv-field-soft); }
    .nos-card + .nos-card .nos-card-li { background: var(--cv-field-2); color: #fff; }
    .nos-card + .nos-card .nos-card-li:hover { color: var(--cv-mint); }
    .nos-card + .nos-card .nos-card-li:focus-visible { outline-color: var(--cv-mint); }
    .nos-card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
    .nos-card-name { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.5rem); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; }
    .nos-card-li { flex: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--cv-r); background: var(--cv-bg); color: var(--cv-ink); transition: color .15s, background-color .15s; }
    .nos-card-li:hover { color: var(--cv-accent); }
    .nos-card-li:focus-visible { outline: 3px solid var(--cv-accent); outline-offset: 3px; }
    .nos-card-role { font-weight: 600; color: var(--cv-accent); }
    /* Las etiquetas son texto, no píldoras: van en línea, separadas por un punto medio */
    .nos-card-tags { display: flex; flex-wrap: wrap; gap: 2px 0; font-size: var(--cv-small); font-weight: 600; color: var(--cv-ink); }
    .nos-card-tags span + span::before { content: "·"; margin: 0 8px; color: var(--cv-soft); }
    .nos-tag-green { color: var(--cv-accent); }
    .nos-card-bio { max-width: 52ch; margin-top: auto; padding-top: 18px; font-size: 1.0625rem; }

    /* ── RESPALDO: el campo oscuro a todo el ancho (el logo de la firma es claro) ── */
    .nos-lznp { margin-top: var(--cv-gap-sec); background: var(--cv-field); color: #fff; padding-block: clamp(64px, 8vw, 120px); }
    .nos-lznp-inner { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 28px); row-gap: 36px; align-items: start; }
    /* El logo de la firma suelto sobre el campo (sin caja) y los tres respaldos como filas grandes, no cajas apiladas. */
    .nos-lznp-logo-wrap { grid-column: span 4; align-self: center; }
    .nos-lznp-logo-wrap img { width: 100%; max-width: 360px; height: auto; display: block; }
    .nos-lznp-copy { grid-column: 6 / span 7; }
    .nos-lznp-desc { margin-top: 18px; max-width: 60ch; color: #e2e8f0; }
    .nos-lznp-points { list-style: none; margin: 36px 0 0; padding: 0; }
    .nos-lznp-point { padding: 22px 0 22px 28px; border-top: 1px solid rgba(255,255,255,.14); font-size: clamp(1.125rem, 1rem + .45vw, 1.375rem); font-weight: 600; letter-spacing: -0.015em; line-height: 1.35; } /* taste-skill-ignore: separador de filas de una lista, no una caja */
    .nos-lznp-point.cv-sq::before { left: 0; top: calc(22px + .55em); width: 9px; height: 9px; background: var(--cv-mint); }
    .nos-lznp-point p { max-width: 60ch; }

    /* ── CTA FINAL: el cierre de la home, el titular grande a la izquierda y la acción a la derecha ── */
    .nos-cta { padding-block: var(--cv-gap-sec); }
    .nos-cta-box { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 28px); align-items: end; }
    .nos-cta-copy { display: contents; }
    .nos-cta-title { grid-column: 1 / span 7; grid-row: 1 / span 2; }
    .nos-cta-sub { grid-column: 8 / span 5; max-width: 52ch; }
    .nos-cta-box .cv-btn { grid-column: 8 / span 5; justify-self: start; margin-top: 30px; }

    @media (max-width: 900px) {
      .nos-intro, .nos-hero-copy, .nos-photo, .nos-lznp-logo-wrap, .nos-lznp-copy, .nos-cta-title, .nos-cta-sub, .nos-cta-box .cv-btn { grid-column: 1 / -1; grid-row: auto; }
      .nos-photo { margin-top: 36px; max-height: 520px; justify-self: stretch; }
      .nos-founder-cards { grid-template-columns: 1fr; gap: 6px; }
      .nos-card { min-height: 0; }
      .nos-lznp-logo-wrap { position: static; max-width: 260px; }
      .nos-cta-sub { margin-top: 24px; }
    }
    @media (max-width: 560px) {
      .nos-cta-box .cv-btn { width: 100%; }
      /* Celular: las etiquetas partían con el punto medio al principio de la línea; van separadas por espacio */
      .nos-card { padding: 24px 22px; }
      .nos-card-tags { gap: 4px 16px; }
      .nos-card-tags span + span::before { content: none; }
      .nos-card-bio { padding-top: 8px; }
    }
  </style>

  <!-- NAV -->
  <Navbar isHome={false} darkHero={true} client:load />

  <main id="main-content">

  <!-- HERO -->
  <section class="nos-hero cv-hero-full">
    <div class="nos-wrap nos-grid">
      <div class="nos-hero-copy">
        <h1 class="nos-hero-title cv-hero-title">El equipo detrás de <span>CertiVeh</span></h1>
        <p class="nos-hero-subtitle cv-hero-sub">
          Tecnología, experiencia en energía y respaldo experto al servicio de los propietarios de vehículos eléctricos e híbridos en Colombia.
        </p>
      </div>
      <!-- Foto: la de los fundadores, lo real de esta página, en la portada -->
      <div class="nos-photo">
        <img
          src="/founders-photo.jpg"
          alt="Julian Delgado y Agustín Jaramillo, co-fundadores de CertiVeh"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- FOUNDERS -->
  <section class="nos-sec">
    <div class="nos-wrap">
      <div class="nos-grid">
        <div class="nos-intro">
          <h2 class="nos-h2 cv-sec-title">Los fundadores</h2>
          <p class="cv-sec-intro">
            Dos perfiles complementarios con un objetivo común: que ningún propietario de vehículo eléctrico o híbrido en Colombia pierda los beneficios tributarios que le corresponden.
          </p>
        </div>
      </div>

      <!-- Cards -->
      <div class="nos-founder-cards">

          <!-- Julian -->
          <div class="nos-card">
            <div class="nos-card-header">
              <span class="nos-card-name">Julian Delgado</span>
              <a href="https://www.linkedin.com/in/juliandelgadomoreno/" target="_blank" rel="noopener noreferrer" class="nos-card-li" aria-label="LinkedIn de Julian Delgado">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
            <p class="nos-card-role">Co-fundador</p>
            <div class="nos-card-tags">
              <span class="nos-tag-green">Stanford GSB Alumni</span>
              <span>Fintech</span>
              <span>Tecnología y producto</span>
            </div>
            <p class="nos-card-bio">
              Fundador en serie con experiencia en fintech y desarrollo de productos tecnológicos. Lidera la arquitectura y el desarrollo de la plataforma de CertiVeh: el agente automatizado que gestiona el trámite ante la UPME sin que el usuario tenga que tocar ningún portal gubernamental.
            </p>
          </div>

          <!-- Agustín -->
          <div class="nos-card">
            <div class="nos-card-header">
              <span class="nos-card-name">Agustín Jaramillo</span>
              <a href="https://www.linkedin.com/in/agustin-jaramillo-londono/" target="_blank" rel="noopener noreferrer" class="nos-card-li" aria-label="LinkedIn de Agustín Jaramillo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
            <p class="nos-card-role">Co-fundador</p>
            <div class="nos-card-tags">
              <span class="nos-tag-green">Sector Energía</span>
              <span>Comercial</span>
              <span>Business Development</span>
            </div>
            <p class="nos-card-bio">
              Trayectoria sólida en el sector energético colombiano. Como co-fundador de CertiVeh, lidera las relaciones comerciales, el desarrollo de alianzas y la operación del negocio. Su conocimiento del ecosistema regulatorio energético es parte central de la metodología de CertiVeh.
            </p>
          </div>

      </div>
    </div>
  </section>

  <!-- RESPALDO LZNP -->
  <section class="nos-lznp">
    <div class="nos-wrap">
      <div class="nos-lznp-inner">

        <div class="nos-lznp-logo-wrap">
          <img src="/lznp-logo.png" alt="Firma de regulación energética" />
        </div>

        <div class="nos-lznp-copy">
          <h2 class="nos-h2 cv-sec-title">Con el respaldo de expertos en la industria</h2>
          <p class="nos-lznp-desc cv-sec-intro">
            Contamos con el respaldo de una firma colombiana con amplia trayectoria en regulación del sector energético, que garantiza que la metodología de CertiVeh esté alineada con los criterios regulatorios vigentes de la UPME y la DIAN.
          </p>
          <ul class="nos-lznp-points">
            <li class="nos-lznp-point cv-sq">
              <p>Experiencia directa en regulación energética colombiana y en los marcos normativos de la Ley 1715 de 2014 y la Ley 2099 de 2021.</p>
            </li>
            <li class="nos-lznp-point cv-sq">
              <p>Conocimiento profundo de los criterios de la UPME para la certificación de inversiones en Gestión Eficiente de la Energía (GEE).</p>
            </li>
            <li class="nos-lznp-point cv-sq">
              <p>Respaldo para la resolución de casos complejos: vehículos sin alta técnica, requerimientos de la UPME y consultas formales ante la DIAN.</p>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="nos-cta">
    <div class="nos-wrap">
      <div class="nos-cta-box">
        <div class="nos-cta-copy">
          <h2 class="nos-cta-title cv-close-title">¿Listo para recuperar <span>lo que es tuyo</span>?</h2>
          <p class="nos-cta-sub cv-sec-intro">
            Gestiona tu certificado UPME y recupera el IVA de tu vehículo eléctrico o híbrido. Todo en línea, sin burocracia.
          </p>
        </div>
        <a href="https://portal.certiveh.co" class="cv-btn cv-btn-a" target="_blank" rel="noopener noreferrer">
          Empezar mi trámite
          <span class="cv-arr" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  </main>

  <!-- FOOTER: el pie compartido de todo el sitio -->
  <SiteFooter />

</BaseLayout>
