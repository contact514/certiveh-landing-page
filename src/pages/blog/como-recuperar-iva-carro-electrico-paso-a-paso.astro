    <article>
      <div class="article-banner b-green">
        <div class="banner-bg-num">11</div>
        <div class="banner-inner">
          <div class="banner-tag">Devolución IVA · DIAN · Paso a Paso · Gestión 2026</div>
          <h1 class="banner-title">Cómo recuperar el IVA de tu carro eléctrico paso a paso</h1>
