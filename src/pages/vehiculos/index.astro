---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Navbar } from '../../app/components/Navbar';
import { SiteFooter } from '../../app/components/SiteFooter';
import { vehiculos, marcas } from '../../data/vehiculos';
import upmeData from '../../../upme-vehicles.json';

const fmt = (n: number) => "$" + Math.round(n).toLocaleString("es-CO");

// Build UPME directory: all brands + models, with links to existing pages
const slugSet = new Set(vehiculos.map(v => v.slug));

// Manual mapping for UPME models whose names don't match our slugs
const upmeToSlug: Record<string, string> = {
  'TOYOTA:COROLLA CROSS XEI': 'toyota-corolla-cross-hybrid',
  'TOYOTA:COROLLA CROSS SEG': 'toyota-corolla-cross-hybrid',
  'TOYOTA:COROLLA CROSS XLI': 'toyota-corolla-cross-hybrid',
  'TOYOTA:COROLLA CROSS HEV': 'toyota-corolla-cross-hybrid',
  'TOYOTA:YARIS CROSS XS HV': 'toyota-yaris-cross-hybrid',
  'TOYOTA:YARIS CROSS XLS HV': 'toyota-yaris-cross-hybrid',
  'TOYOTA:YARIS CROSS HEV': 'toyota-yaris-cross-hybrid',
  'HYUNDAI:KONA ELECTRICA': 'hyundai-kona-electrico',
  'KIA:NIRO SG2': 'kia-niro-ev',
  'KIA:NIRO DESIRE': 'kia-niro-ev',
  'KIA:NIRO VIBRANT': 'kia-niro-ev',
  'KIA:NIRO ZENITH': 'kia-niro-ev',
  'BYD:DOLPHIN': 'byd-dolphin',
  'TESLA:MODEL Y REAR-WHEEL': 'tesla-model-y',
  'TESLA:MODEL Y LONG RANGE AWD': 'tesla-model-y',
  'TESLA:MODEL Y REAR-WHEEL DRIVE': 'tesla-model-y',
  'TESLA:MODEL 3 REAR-WHEEL DRIVE': 'tesla-model-3',
  'TESLA:MODEL 3 RWD': 'tesla-model-3',
  'TESLA:MODEL 3 LR AWD': 'tesla-model-3',
  'TESLA:MODEL 3 AWD': 'tesla-model-3',
};
const upmeBrands = Object.entries(upmeData.vehicles)
  .map(([marca, modelos]) => ({
    marca,
    modelos: Object.keys(modelos as Record<string, unknown>),
  }))
  .sort((a, b) => a.marca.localeCompare(b.marca));

const totalUpmeModels = upmeBrands.reduce((sum, b) => sum + b.modelos.length, 0);

const title = "Vehículos Elegibles para Certificado UPME, Beneficios Tributarios | CertiVeh";
const description = `Listado completo de ${totalUpmeModels}+ vehículos eléctricos e híbridos elegibles para el certificado UPME en Colombia. Consulta tu marca y modelo, calcula tu devolución de IVA y deducción en renta.`;
const keywords = "vehículos elegibles UPME, certificado UPME vehículo eléctrico, beneficios tributarios vehículo eléctrico Colombia, BYD UPME, Toyota híbrido UPME, Kia eléctrico UPME, Tesla UPME Colombia, BMW eléctrico UPME, Mercedes UPME, Volvo UPME, Hyundai UPME, Chevrolet UPME, Ford híbrido UPME, Renault eléctrico UPME, Chery UPME Colombia, MG eléctrico UPME, Mazda UPME, Audi eléctrico UPME, Porsche híbrido UPME, Lexus UPME, Mitsubishi UPME, MINI eléctrico UPME";

const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Vehículos elegibles para certificado UPME en Colombia',
  numberOfItems: vehiculos.length,
  itemListElement: vehiculos.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${v.marca} ${v.modelo}`,
    url: `https://certiveh.co/vehiculos/${v.slug}/`,
  })),
});
---

<BaseLayout title={title} description={description} keywords={keywords} ogImage="https://certiveh.co/og/vehiculos.jpg">
  <script slot="head" type="application/ld+json" set:html={itemListLd} />

  <style is:inline>
    /* Vehículos elegibles · estándar visual 2026-11 (DESIGN_SYSTEM.md §0). Variables --cv-* de marca.css.
       Cada modelo es una baldosa de tono con sus cifras; el directorio UPME es una herramienta: el buscador
       y los filtros llevan su línea de campo, los modelos van en etiquetas planas de 6 px. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--cv-font); font-size: var(--cv-body); line-height: 1.5; letter-spacing: -0.01em; background: var(--cv-bg); color: var(--cv-ink); -webkit-font-smoothing: antialiased; }

    /* ── HERO: el fotograma del video de la home con el mismo velo neutro ── */
    .vh-hero { position: relative; color: #fff; padding: calc(64px + clamp(64px, 9vw, 140px)) max(var(--cv-m), calc((100vw - 1424px) / 2)) clamp(56px, 7vw, 110px); background: url(/hero-bg-poster.webp) center / cover no-repeat, var(--cv-field); }
    .vh-hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(9,14,26,.9) 0%, rgba(9,14,26,.74) 50%, rgba(9,14,26,.45) 100%); } /* taste-skill-ignore: velo neutro sobre la foto */
    .vh-hero > * { position: relative; }
    .vh-title { font-size: var(--cv-display); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; text-wrap: balance; max-width: 20ch; }
    .vh-subtitle { font-size: var(--cv-lead); line-height: 1.4; color: #e2e8f0; max-width: 46ch; margin-top: 22px; }

    /* ── LOS MODELOS CON FICHA: baldosas de tono ── */
    .vh-container { max-width: 1520px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) var(--cv-m) 0; }
    .vh-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
    .vh-card { background: var(--cv-tone); border-radius: var(--cv-r); padding: clamp(22px, 2.2vw, 28px); min-height: 360px; display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--cv-ink); transition: background-color .15s; }
    .vh-card:hover { background: var(--cv-tone-2); }
    .vh-card:focus-visible { outline: 3px solid var(--cv-accent); outline-offset: 3px; }
    .vh-card-name { font-size: clamp(1.375rem, 1.15rem + 0.7vw, 1.75rem); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1.1; }
    .vh-card-badge { font-size: var(--cv-small); font-weight: 600; color: var(--cv-accent); margin-top: 4px; }
    .vh-card-price { font-size: 1rem; color: var(--cv-soft); margin-bottom: 14px; }
    .vh-card-benefit { display: flex; justify-content: space-between; gap: 12px; font-size: 1rem; padding: 4px 0; font-variant-numeric: tabular-nums; }
    .vh-card-benefit-value { font-weight: 600; }
    /* El beneficio total, la cifra de la tarjeta: grande y en verde, como la cifra de las baldosas de la home */
    .vh-card-benefit.vh-card-total { display: flex; flex-direction: column; gap: 2px; order: -1; margin: 18px 0 12px; padding: 0; font-size: var(--cv-small); font-weight: 600; color: var(--cv-soft); }
    .vh-card-total span:last-child { order: -1; font-size: clamp(2rem, 1.5rem + 1.4vw, 2.75rem); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; color: var(--cv-accent); }
    .vh-card-figs { display: flex; flex-direction: column; }
    .vh-card-figs .vh-card-benefit:not(.vh-card-total) { font-size: .9375rem; }
    .vh-card-cta { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 18px; font-weight: 700; color: var(--cv-accent); }
    .vh-card-cta .cv-arr { transition: transform .15s; }
    .vh-card:hover .vh-card-cta .cv-arr { transform: translateX(4px); }
    .vh-disclaimer { font-size: 1rem; color: var(--cv-soft); line-height: 1.6; max-width: 62ch; margin-top: 24px; }

    /* ── DIRECTORIO UPME ── */
    .vh-directory { max-width: 1520px; margin: 0 auto; padding: var(--cv-gap-sec) var(--cv-m) 0; scroll-margin-top: 80px; }
    .vh-directory-header { max-width: 820px; display: flex; flex-direction: column; }
    .vh-directory-title { font-size: var(--cv-head); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: 1; text-wrap: balance; }
    .vh-directory-desc { margin-top: 18px; max-width: 64ch; }
    /* La fecha del listado es un dato, no un rótulo: va debajo, como nota */
    .vh-directory-badge { order: 3; margin-top: 12px; font-size: var(--cv-small); font-weight: 600; color: var(--cv-accent); }
    .vh-search-wrap { position: relative; max-width: 560px; margin-top: 40px; }
    .vh-search-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--cv-soft); pointer-events: none; }
    .vh-search-input { width: 100%; font: 400 1.0625rem/1.3 var(--cv-font); color: var(--cv-ink); background: var(--cv-bg); border: 1.5px solid #cbd5d1; border-radius: var(--cv-r); padding: 16px 16px 16px 46px; transition: border-color .15s; }
    .vh-search-input::placeholder { color: var(--cv-soft); }
    .vh-search-input:focus { outline: none; border-color: var(--cv-accent); box-shadow: 0 0 0 3px #d5efe3; } /* taste-skill-ignore: anillo de foco del campo de formulario */
    .vh-brand-pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
    .vh-brand-pill { font: 600 1rem/1.2 var(--cv-font); color: var(--cv-ink); background: var(--cv-tone); border: 0; border-radius: var(--cv-r); padding: 10px 12px; min-height: 40px; cursor: pointer; transition: background-color .15s, color .15s; }
    .vh-brand-pill:hover { background: var(--cv-tone-2); }
    .vh-brand-pill.active { background: var(--cv-accent); color: #fff; }
    .vh-brand-pill:focus-visible { outline: 3px solid var(--cv-accent); outline-offset: 2px; }
    .vh-no-results { display: none; margin-top: 32px; color: var(--cv-soft); }
    /* Cada marca, una fila: el nombre a la izquierda y sus modelos a la derecha */
    .vh-brand-group { display: grid; grid-template-columns: minmax(180px, 3fr) 9fr; column-gap: clamp(12px, 2vw, 28px); align-items: start; margin-top: 8px; padding: 22px 0; }
    .vh-brand-pills + .vh-no-results + .vh-brand-group { margin-top: 40px; }
    .vh-brand-name { display: flex; flex-direction: column; gap: 2px; font-size: 1.375rem; font-weight: var(--cv-wh); letter-spacing: -0.02em; line-height: 1.15; }
    .vh-brand-count { font-size: 1rem; font-weight: 600; color: var(--cv-soft); letter-spacing: normal; }
    .vh-model-list { display: flex; flex-wrap: wrap; gap: 6px; }
    .vh-model-tag { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 8px 12px; border-radius: var(--cv-r); background: var(--cv-tone); color: var(--cv-ink); font-size: 1rem; font-weight: 600; text-decoration: none; }
    .vh-model-tag-linked { background: var(--cv-accent); color: #fff; transition: background-color .15s; }
    .vh-model-tag-linked:hover { background: var(--cv-accent-hover); }
    .vh-model-tag-linked:focus-visible { outline: 3px solid var(--cv-accent); outline-offset: 2px; }

    /* ── CIERRE DEL DIRECTORIO: el de la home, el titular grande a la izquierda y la acción a la derecha ── */
    .vh-directory-cta { margin: var(--cv-gap-sec) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 28px); align-items: end; }
    .vh-directory-cta-title { grid-column: 1 / span 7; grid-row: 1 / span 3; align-self: end; font-size: var(--cv-display); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: .98; text-wrap: balance; }
    .vh-directory-cta-desc, .vh-directory-cta .vh-directory-cta-btn, .vh-directory-cta-note { grid-column: 8 / span 5; }
    .vh-directory-cta-desc { max-width: 52ch; }
    .vh-directory-cta .vh-directory-cta-btn { margin-top: 30px; justify-self: start; }
    .vh-directory-cta-note { margin-top: 26px; font-size: var(--cv-small); color: var(--cv-soft); max-width: 56ch; }
    .vh-directory-cta-note a { color: var(--cv-accent); font-weight: 700; text-underline-offset: 3px; }

    @media (max-width: 1100px) { .vh-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 860px) {
      .vh-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .vh-brand-group { grid-template-columns: 1fr; row-gap: 12px; }
      .vh-brand-name { flex-direction: row; align-items: baseline; gap: 12px; }
      .vh-directory-cta > *, .vh-directory-cta .vh-directory-cta-btn { grid-column: 1 / -1; grid-row: auto; }
      .vh-directory-cta-desc { margin-top: 24px; }
    }
    @media (max-width: 560px) {
      .vh-grid { grid-template-columns: 1fr; gap: 6px; }
      .vh-directory-cta-btn { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .vh-card-cta .cv-arr { transition: none; }
    }
  </style>

  <!-- NAV -->
  <Navbar isHome={false} darkHero={true} client:load />

  <!-- HERO -->
  <main id="main-content">
  <div class="vh-hero">
    <h1 class="vh-title">Vehículos elegibles para el <span>certificado UPME</span></h1>
    <p class="vh-subtitle">Listado oficial completo de vehículos eléctricos e híbridos que aplican para beneficios tributarios en Colombia. Consulta tu marca y modelo.</p>
  </div>

  <!-- GRID -->
  <div class="vh-container">
    <div class="vh-grid">
      {vehiculos.map(v => {
        const iva = v.precioCOP * 0.05;
        const renta = v.precioCOP * 0.50;
        const total = iva + renta;
        return (
          <a href={`/vehiculos/${v.slug}/`} class="vh-card">
            <div class="vh-card-name">{v.marca} {v.modelo}</div>
            <div class={`vh-card-badge ${v.tipo === 'BEV' ? 'vh-card-badge-ev' : 'vh-card-badge-hev'}`}>
              {v.tipoLabel}
            </div>
            <div class="vh-card-price">Desde {fmt(v.precioCOP)} COP</div>
            <div class="vh-card-figs">
            <div class="vh-card-benefit">
              <span class="vh-card-benefit-label">Devolución IVA</span>
              <span class="vh-card-benefit-value">{fmt(iva)}</span>
            </div>
            <div class="vh-card-benefit">
              <span class="vh-card-benefit-label">Deducción renta</span>
              <span class="vh-card-benefit-value">{fmt(renta)}</span>
            </div>
            <div class="vh-card-benefit vh-card-total">
              <span>Beneficio total</span>
              <span>{fmt(total)}</span>
            </div>
            </div>
            <div class="vh-card-cta">
              Ver detalle y calcular
              <span class="cv-arr" aria-hidden="true">→</span>
            </div>
          </a>
        );
      })}
    </div>
    <p class="vh-disclaimer">* Los valores de IVA, deducción en renta y beneficio total son estimados con base en precios de referencia públicos. El «beneficio total» suma la devolución de IVA y la deducción en renta, y la deducción reduce tu base gravable: no es dinero que se devuelva. Los montos exactos dependen del precio real de compra registrado en tu factura. CertiVeh no garantiza valores específicos, el beneficio final lo determina la DIAN con base en tu documentación.</p>
  </div>

  <!-- DIRECTORY: ALL UPME VEHICLES -->
  <div class="vh-directory" id="directorio">
    <div class="vh-directory-header">
      <div class="vh-directory-badge">Listado oficial UPME · Actualizado julio 2026</div>
      <h2 class="vh-directory-title">Todos los vehículos elegibles para certificado UPME en Colombia</h2>
      <p class="vh-directory-desc">Directorio de {totalUpmeModels}+ modelos de {upmeBrands.length} marcas que la UPME ha certificado para beneficios tributarios. Esta lista se actualiza periódicamente, pero puede no incluir todos los vehículos elegibles; la UPME agrega nuevos modelos con frecuencia.</p>
    </div>

    <!-- SEARCH + BRAND FILTER -->
    <div class="vh-search-wrap">
      <svg class="vh-search-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="vh-search" class="vh-search-input" type="search" aria-label="Busca por marca o modelo" placeholder="Busca por marca o modelo..." autocomplete="off" />
    </div>
    <div class="vh-brand-pills">
      <button type="button" class="vh-brand-pill active" aria-pressed="true" data-brand="TODAS">Todas ({totalUpmeModels})</button>
      {upmeBrands.map(b => (
        <button type="button" class="vh-brand-pill" aria-pressed="false" data-brand={b.marca}>{b.marca} ({b.modelos.length})</button>
      ))}
    </div>
    <p id="vh-no-results" class="vh-no-results" role="status">No se encontraron vehículos para tu búsqueda.</p>

    {upmeBrands.map(brand => {
      const brandSlugPrefix = brand.marca.toLowerCase().replace(/\s+/g, '-');
      return (
        <div class="vh-brand-group" data-brand={brand.marca}>
          <h3 class="vh-brand-name">
            {brand.marca}
            <span class="vh-brand-count">{brand.modelos.length} {brand.modelos.length === 1 ? 'modelo' : 'modelos'}</span>
          </h3>
          <div class="vh-model-list">
            {brand.modelos.map(modelo => {
              const modelSlug = `${brandSlugPrefix}-${modelo.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/, '')}`;
              const manualKey = `${brand.marca}:${modelo}`;
              const matchedSlug = upmeToSlug[manualKey] || [...slugSet].find(s => modelSlug.startsWith(s) || s === modelSlug);
              return matchedSlug ? (
                <a href={`/vehiculos/${matchedSlug}/`} class="vh-model-tag vh-model-tag-linked" data-model={modelo}>
                  {modelo}
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              ) : (
                <span class="vh-model-tag" data-model={modelo} title="Página de detalle no disponible aún">{modelo}</span>
              );
            })}
          </div>
        </div>
      );
    })}

    <div class="vh-directory-cta">
      <div class="vh-directory-cta-title">¿Tu vehículo está en la lista?</div>
      <p class="vh-directory-cta-desc">Si tu vehículo eléctrico o híbrido aparece en este directorio, eres elegible para el certificado UPME. Tramítalo 100% en línea con CertiVeh.</p>
      <a href="https://portal.certiveh.co" target="_blank" rel="noopener noreferrer" class="vh-directory-cta-btn cv-btn cv-btn-a">
        Empezar mi trámite ahora
        <span class="cv-arr" aria-hidden="true">→</span>
      </a>
      <p class="vh-directory-cta-note">¿No ves tu vehículo? Esta lista se actualiza periódicamente. Si tu vehículo es eléctrico o híbrido, es probable que sea elegible. Escríbenos a <a href="mailto:contacto@certiveh.co">contacto@certiveh.co</a> y lo verificamos sin costo.</p>
    </div>
  </div>

  </main>

  <script is:inline>
    (function() {
      const searchInput = document.getElementById('vh-search');
      const brandPills  = document.querySelectorAll('.vh-brand-pill');
      const brandGroups = document.querySelectorAll('.vh-brand-group');
      const noResults   = document.getElementById('vh-no-results');
      let activeBrand   = 'TODAS';

      function filter() {
        const q = searchInput.value.toLowerCase().trim();
        let anyVisible = false;

        brandGroups.forEach(function(group) {
          const brand = group.dataset.brand;
          const brandMatch = activeBrand === 'TODAS' || brand === activeBrand;
          if (!brandMatch) { group.style.display = 'none'; return; }

          if (!q) {
            group.style.display = '';
            group.querySelectorAll('[data-model]').forEach(function(m) { m.style.display = ''; });
            anyVisible = true;
            return;
          }

          const brandNameMatch = brand.toLowerCase().includes(q);
          let anyModel = false;
          group.querySelectorAll('[data-model]').forEach(function(m) {
            const show = brandNameMatch || m.dataset.model.toLowerCase().includes(q);
            m.style.display = show ? '' : 'none';
            if (show) anyModel = true;
          });
          group.style.display = anyModel ? '' : 'none';
          if (anyModel) anyVisible = true;
        });

        noResults.style.display = anyVisible ? 'none' : 'block';
      }

      searchInput.addEventListener('input', filter);

      brandPills.forEach(function(pill) {
        pill.addEventListener('click', function() {
          brandPills.forEach(function(p) { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
          pill.classList.add('active');
          pill.setAttribute('aria-pressed', 'true');
          activeBrand = pill.dataset.brand;
          filter();
        });
      });
    })();
  </script>

  <!-- FOOTER: el pie compartido de todo el sitio -->
  <SiteFooter />

</BaseLayout>
