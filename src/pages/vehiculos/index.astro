---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { vehiculos, marcas } from '../../data/vehiculos';

const fmt = (n: number) => "$" + Math.round(n).toLocaleString("es-CO");

const title = "Vehículos Elegibles para Certificado UPME — Beneficios Tributarios | CertiVeh";
const description = "Consulta si tu vehículo eléctrico o híbrido aplica para el certificado UPME en Colombia. Calcula tu devolución de IVA y deducción en renta por marca y modelo.";
const keywords = "vehículos elegibles UPME, certificado UPME vehículo eléctrico, beneficios tributarios vehículo eléctrico Colombia, BYD UPME, Toyota híbrido UPME, Kia eléctrico UPME";

const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Vehículos elegibles para certificado UPME en Colombia',
  numberOfItems: vehiculos.length,
  itemListElement: vehiculos.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${v.marca} ${v.modelo}`,
    url: `https://certiveh.co/vehiculos/${v.slug}/`,
  })),
});
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <script slot="head" type="application/ld+json" set:html={itemListLd} />

  <style>
    :root {
      --emerald-600: #059669; --emerald-50: #ECFDF5; --emerald-200: #A7F3D0; --emerald-700: #047857;
      --teal-500: #14B8A6;
      --slate-900: #0F172A; --slate-700: #334155; --slate-600: #475569;
      --slate-500: #64748B; --slate-400: #94A3B8; --slate-200: #E2E8F0;
      --slate-100: #F1F5F9; --slate-50: #F8FAFC;
      --ff: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--ff); background: var(--slate-50); color: var(--slate-700); -webkit-font-smoothing: antialiased; }

    .vh-nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.97); backdrop-filter: blur(12px); border-bottom: 1px solid var(--slate-200); height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 48px; }
    .vh-nav a { text-decoration: none; font-size: 14px; color: var(--slate-500); display: flex; align-items: center; gap: 6px; transition: color 0.15s; }
    .vh-nav a:hover { color: var(--slate-900); }
    .vh-nav-logo { font-size: 19px; font-weight: 800; color: var(--slate-900); letter-spacing: -0.03em; }
    .vh-nav-logo span { color: var(--emerald-600); }

    .vh-hero { background: var(--slate-900); padding: 64px 48px; text-align: center; }
    .vh-title { font-size: clamp(28px, 4vw, 42px); font-weight: 700; color: white; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 12px; }
    .vh-subtitle { font-size: 16px; color: var(--slate-400); line-height: 1.6; max-width: 560px; margin: 0 auto; }
    .vh-count { display: inline-block; background: rgba(5,150,105,0.15); border: 1px solid rgba(5,150,105,0.3); color: #34D399; font-size: 12px; font-weight: 700; padding: 5px 14px; border-radius: 20px; margin-bottom: 16px; letter-spacing: 0.06em; }

    .vh-container { max-width: 1000px; margin: 0 auto; padding: 48px 48px 80px; }
    .vh-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
    .vh-card { background: white; border: 1px solid var(--slate-200); border-radius: 12px; padding: 24px; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; }
    .vh-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
    .vh-card-badge { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 10px; border-radius: 12px; display: inline-flex; width: fit-content; margin-bottom: 12px; }
    .vh-card-badge-ev { background: var(--emerald-50); color: var(--emerald-600); border: 1px solid var(--emerald-200); }
    .vh-card-badge-hev { background: #F0FDFA; color: var(--teal-500); border: 1px solid #99F6E4; }
    .vh-card-name { font-size: 20px; font-weight: 700; color: var(--slate-900); letter-spacing: -0.01em; margin-bottom: 4px; }
    .vh-card-price { font-size: 14px; color: var(--slate-500); margin-bottom: 12px; }
    .vh-card-benefit { display: flex; justify-content: space-between; padding: 8px 0; border-top: 1px solid var(--slate-100); font-size: 14px; }
    .vh-card-benefit-label { color: var(--slate-500); }
    .vh-card-benefit-value { font-weight: 600; color: var(--emerald-600); }
    .vh-card-cta { font-size: 13px; font-weight: 600; color: var(--emerald-600); margin-top: auto; padding-top: 16px; display: flex; align-items: center; gap: 4px; }

    .vh-footer { font-size: 13px; color: var(--slate-400); text-align: center; padding: 32px 48px; border-top: 1px solid var(--slate-200); }
    .vh-footer a { color: var(--emerald-600); text-decoration: none; }

    @media (max-width: 640px) {
      .vh-nav { padding: 0 20px; }
      .vh-hero { padding: 48px 20px; }
      .vh-container { padding: 32px 20px 64px; }
      .vh-grid { grid-template-columns: 1fr; }
    }
  </style>

  <!-- NAV -->
  <nav class="vh-nav">
    <a href="/" class="vh-nav-logo">Certi<span>Veh</span></a>
    <a href="/">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Volver al inicio
    </a>
  </nav>

  <!-- HERO -->
  <div class="vh-hero">
    <div class="vh-count">{vehiculos.length} vehículos elegibles</div>
    <h1 class="vh-title">Vehículos elegibles para el certificado UPME</h1>
    <p class="vh-subtitle">Consulta tu marca y modelo para ver cuánto puedes recuperar en beneficios tributarios con CertiVeh.</p>
  </div>

  <!-- GRID -->
  <div class="vh-container">
    <div class="vh-grid">
      {vehiculos.map(v => {
        const iva = v.precioCOP * 0.05;
        const renta = v.precioCOP * 0.50;
        const total = iva + renta;
        return (
          <a href={`/vehiculos/${v.slug}/`} class="vh-card">
            <div class={`vh-card-badge ${v.tipo === 'BEV' ? 'vh-card-badge-ev' : 'vh-card-badge-hev'}`}>
              {v.tipoLabel}
            </div>
            <div class="vh-card-name">{v.marca} {v.modelo}</div>
            <div class="vh-card-price">Desde {fmt(v.precioCOP)} COP</div>
            <div class="vh-card-benefit">
              <span class="vh-card-benefit-label">Devolución IVA</span>
              <span class="vh-card-benefit-value">{fmt(iva)}</span>
            </div>
            <div class="vh-card-benefit">
              <span class="vh-card-benefit-label">Deducción renta</span>
              <span class="vh-card-benefit-value">{fmt(renta)}</span>
            </div>
            <div class="vh-card-benefit" style="font-weight: 700; color: var(--slate-900);">
              <span>Beneficio total</span>
              <span style="color: var(--emerald-600);">{fmt(total)}</span>
            </div>
            <div class="vh-card-cta">
              Ver detalle y calcular
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </a>
        );
      })}
    </div>
  </div>

  <!-- FOOTER -->
  <div class="vh-footer">
    <p>CertiVeh — Tu tramitador virtual del certificado UPME · <a href="/">certiveh.co</a> · <a href="/blog/">Blog</a></p>
  </div>
</BaseLayout>
