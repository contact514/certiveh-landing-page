---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Navbar } from '../../app/components/Navbar';
import { SiteFooter } from '../../app/components/SiteFooter';
import { vehiculos } from '../../data/vehiculos';
import { honorariosCertivehSinEscalar, tarifaVigente } from '../../lib/tipos-de-activo.ts';
import { tasaUpme } from '../../lib/precios-de-la-landing.ts';
// La calculadora de la home (`.calc`): la ficha pinta el desglose del modelo con su mismo CSS (DESIGN_SYSTEM.md §0.5).
import { CSS_CALC, CSS_CALC_MOVIL } from '../../app/components/piezas-de-la-marca.ts';

export async function getStaticPaths() {
  return vehiculos.map(v => ({
    params: { slug: v.slug },
    props: { vehiculo: v },
  }));
}

const { vehiculo: v } = Astro.props;

// La tasa UPME con la misma fórmula de la calculadora y del portal: una sola fuente, `precios-de-la-landing.ts`.
const costoUPME = tasaUpme(v.precioCOP);
// Los honorarios de la tarifa vigente EN EL INSTANTE DEL BUILD (ajuste de precios, lote 4). La ficha es estática:
// tras T cambia con el rebuild de T+1 min.
const honorarios = honorariosCertivehSinEscalar('veh', v.precioCOP, tarifaVigente(new Date()));
const subtotal = costoUPME + honorarios;
const ivaServicio = Math.round(honorarios * 0.19);
const costoTotal = costoUPME + honorarios + ivaServicio;

const iva = v.precioCOP * 0.05;
const renta = v.precioCOP * 0.50;
const totalBeneficio = iva + renta;
const neto = totalBeneficio - costoTotal;
const roi = Math.round(totalBeneficio / costoTotal * 10) / 10;

const fmt = (n: number) => "$" + Math.round(n).toLocaleString("es-CO");
// El ancho de cada barra del desglose: su parte del beneficio total, como en la calculadora de la home.
const pctIva = (iva / totalBeneficio) * 100;
const pctRenta = (renta / totalBeneficio) * 100;
const CSS_FICHA_CALC = `${CSS_CALC}\n  @media (max-width: 900px) {\n${CSS_CALC_MOVIL}\n  }`;

const title = `${v.marca} ${v.modelo}, Certificado UPME y Devolución de IVA | CertiVeh`;
const description = `¿Tienes un ${v.marca} ${v.modelo}? Estima cuánto IVA puedes solicitar (aprox. ${fmt(iva)}) y cuánto deducir en renta (aprox. ${fmt(renta)}). CertiVeh gestiona tu certificado UPME y la devolución de IVA ante la DIAN.`;
const keywords = `${v.marca} ${v.modelo} certificado UPME, ${v.marca} ${v.modelo} beneficios tributarios, ${v.marca} ${v.modelo} devolución IVA Colombia, gestión IVA DIAN ${v.marca}, ${v.slug.replace(/-/g, ' ')}`;

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://certiveh.co/' },
    { '@type': 'ListItem', position: 2, name: 'Vehículos', item: 'https://certiveh.co/vehiculos/' },
    { '@type': 'ListItem', position: 3, name: `${v.marca} ${v.modelo}` },
  ]
});

const productLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Certificado UPME para ${v.marca} ${v.modelo}`,
  description: description,
  image: 'https://certiveh.co/og/vehiculos.jpg',
  brand: { '@type': 'Brand', name: 'CertiVeh' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'COP',
    price: costoTotal.toString(),
    availability: 'https://schema.org/InStock',
    url: `https://certiveh.co/vehiculos/${v.slug}/`,
  },
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `¿El ${v.marca} ${v.modelo} aplica para el certificado UPME?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Sí. El ${v.marca} ${v.modelo} es un vehículo ${v.tipoLabel.toLowerCase()} y es elegible para los beneficios tributarios que otorga el certificado UPME en Colombia.`,
      },
    },
    {
      '@type': 'Question',
      name: `¿Cuánto me devuelve la DIAN por el IVA de mi ${v.marca} ${v.modelo}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `El IVA de los eléctricos e híbridos es del 5% sobre el valor del vehículo antes de impuestos, y con el certificado UPME puedes solicitar a la DIAN la devolución del 100% de ese IVA. Sobre un precio de referencia de ${fmt(v.precioCOP)} el estimado es de ${fmt(iva)}; la cifra exacta es la que aparece discriminada como IVA en tu factura.`,
      },
    },
    {
      '@type': 'Question',
      name: '¿Cuánto puedo deducir en mi declaración de renta?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Puedes deducir hasta el 50% del valor del vehículo, es decir ${fmt(renta)}, de tu base gravable en la declaración de renta, en un periodo máximo de 15 años desde la entrada en operación del vehículo.`,
      },
    },
    {
      '@type': 'Question',
      name: `¿Cuánto cuesta tramitar el certificado UPME con CertiVeh?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `El costo total para un ${v.marca} ${v.modelo} es de ${fmt(costoTotal)} COP (incluye trámite UPME ${fmt(costoUPME)} + honorarios CertiVeh ${fmt(honorarios)} + IVA sobre honorarios). Es un pago único, sin suscripciones.`,
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué documentos necesito?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Tu cédula (de ciudadanía o de extranjería), tarjeta de propiedad y factura de compra. El RUT solo hace falta si además vas a pedir la devolución del IVA, y en ese caso también si eres empresa. Si eres empresa, en vez de tu cédula va la del representante legal y el certificado de Cámara de Comercio vigente. Todo se sube en PDF, JPG o PNG desde tu teléfono en menos de 3 minutos.',
      },
    },
  ],
});
---

<BaseLayout title={title} description={description} keywords={keywords} ogImage="https://certiveh.co/og/vehiculos.jpg">
  <script slot="head" type="application/ld+json" set:html={breadcrumbLd} />
  <script slot="head" type="application/ld+json" set:html={productLd} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />

  <style is:inline set:html={CSS_FICHA_CALC}></style>
  <style is:inline>
    /* Ficha de modelo · estándar visual 2026-11 (DESIGN_SYSTEM.md §0) con los patrones de la home (§0.5): la portada con
       el texto a la izquierda y, encima, la calculadora de la home (`.calc`) con el desglose de ESTE modelo; debajo, las
       preguntas en baldosas con el titular fijo a la izquierda. Las cifras salen de la tarifa vigente en el build. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--cv-font); font-size: var(--cv-body); line-height: 1.5; letter-spacing: -0.01em; background: var(--cv-bg); color: var(--cv-ink); -webkit-font-smoothing: antialiased; }
    .v-wrap { padding-inline: var(--cv-m); max-width: 1520px; margin: 0 auto; }
    .v-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 28px); }

    /* ── PORTADA: el fotograma del video de la home con su velo, el texto a la izquierda y el desglose encima ── */
    .v-hero { position: relative; color: #fff; padding: calc(64px + clamp(40px, 6vw, 96px)) 0 clamp(40px, 5vw, 72px); background: url(/hero-bg-poster.webp) center / cover no-repeat, var(--cv-field); }
    .v-hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(9,14,26,.88) 0%, rgba(9,14,26,.72) 45%, rgba(9,14,26,.35) 100%); } /* taste-skill-ignore: velo neutro sobre la foto */
    .v-hero .v-grid { position: relative; align-items: start; }
    .v-hero-copy { grid-column: 1 / span 6; padding-bottom: 40px; position: sticky; top: 104px; } /* acompaña al bajar por la calculadora, que es más alta: sin hueco a la izquierda */
    .v-breadcrumb { font-size: var(--cv-small); color: #cbd5e1; margin-bottom: 22px; }
    .v-breadcrumb a { color: #fff; text-decoration: none; font-weight: 600; }
    .v-breadcrumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .v-breadcrumb a:focus-visible { outline: 3px solid var(--cv-mint); outline-offset: 2px; }
    .v-title { font-size: var(--cv-display); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: .96; text-wrap: balance; }
    .v-desc { font-size: var(--cv-lead); line-height: 1.4; color: #dbe3ee; max-width: 46ch; margin-top: 24px; }
    .v-stage { grid-column: 8 / span 5; }

    /* El desglose del modelo en la calculadora de la home */
    .calc .v-ref { color: var(--cv-soft); font-size: .9375rem; margin-top: 8px; }
    .calc .bars { margin-top: 24px; gap: 16px; }
    .calc .brow b { white-space: nowrap; }
    .calc .brow { gap: 12px; }
    .v-bnote { font-size: .8125rem; color: var(--cv-soft); margin-top: 6px; }
    .calc .cost h2.h { font-size: .875rem; font-weight: 700; letter-spacing: normal; line-height: 1.5; margin-bottom: 8px; }
    .calc .cost > div > :last-child { white-space: nowrap; }
    .calc .cost .m, .calc .cost .m span { color: var(--cv-soft); }
    .calc .res .row .k { display: block; }
    .calc .res .row b { font-size: 1.25rem; line-height: 1.25; }
    .calc .res .cv-btn:focus-visible { outline-color: var(--cv-mint); }

    /* ── PREGUNTAS: las de la home, el titular fijo a la izquierda ── */
    .v-faq { padding-top: var(--cv-gap-sec); align-items: start; }
    .v-faq > h2 { grid-column: 1 / span 4; position: sticky; top: 96px; font-size: var(--cv-head); font-weight: var(--cv-wh); letter-spacing: var(--cv-trk); line-height: .98; text-wrap: balance; }
    .v-qs { grid-column: 5 / span 8; display: grid; gap: 8px; }
    .v-faq-item { background: var(--cv-tone); border-radius: var(--cv-r); transition: background-color .15s, color .15s; }
    .v-faq-item.open { background: var(--cv-accent); color: #fff; }
    .v-faq-btn { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 72px; padding: 18px 24px; background: none; border: 0; color: inherit; cursor: pointer; text-align: left; font: 600 1.1875rem/1.3 var(--cv-font); letter-spacing: -0.02em; }
    .v-faq-btn:focus-visible { outline: 3px solid var(--cv-accent); outline-offset: 3px; border-radius: var(--cv-r); }
    .v-faq-icon { flex: none; display: grid; place-items: center; width: 28px; height: 28px; transition: transform .2s; }
    .v-faq-item.open .v-faq-icon { transform: rotate(45deg); }
    .v-faq-body { display: none; padding: 0 24px 24px; max-width: 62ch; font-size: 1.0625rem; color: #eafaf2; }
    .v-faq-item.open .v-faq-body { display: block; }
    .v-disclaimer { grid-column: 5 / span 8; font-size: 1rem; color: var(--cv-soft); line-height: 1.6; max-width: 66ch; margin: 40px 0 var(--cv-gap-sec); }

    @media (max-width: 900px) {
      .v-hero::before { background: linear-gradient(180deg, rgba(9,14,26,.82) 0%, rgba(9,14,26,.7) 60%, rgba(9,14,26,.85) 100%); } /* taste-skill-ignore: velo neutro sobre la foto */
      .v-hero-copy, .v-stage, .v-faq > h2, .v-qs, .v-disclaimer { grid-column: 1 / -1; }
      .v-hero-copy { position: static; }
      .v-faq > h2 { position: static; margin-bottom: 28px; }
      .v-faq-btn { min-height: 64px; font-size: 1.0625rem; padding: 16px 18px; }
      .v-faq-body { padding: 0 18px 20px; font-size: 1rem; }
      .calc .res .cv-btn { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .v-faq-item, .v-faq-icon { transition: none; }
    }
  </style>

  <!-- NAV -->
  <Navbar isHome={false} darkHero={true} client:load />

  <!-- HERO -->
  <main id="main-content">
  <div class="v-hero">
    <div class="v-wrap v-grid">
      <div class="v-hero-copy">
        <nav class="v-breadcrumb" aria-label="Migas de pan">
          <a href="/">Inicio</a> → <a href="/vehiculos/">Vehículos</a> → {v.marca} {v.modelo}
        </nav>
        <h1 class="v-title">{v.marca} <span>{v.modelo}</span></h1>
        <p class="v-desc">{v.descripcion}</p>
      </div>

      <!-- BENEFICIOS Y COSTO: la calculadora de la home con el desglose de este modelo -->
      <div class="v-stage">
        <div class="calc">
          <h2>Beneficios tributarios para tu {v.marca} {v.modelo}</h2>
          <p class="v-ref">
            Precio de referencia: {fmt(v.precioCOP)} COP · Fuente: {v.precioFuente}
          </p>

          <div class="bars">
            <div>
              <div class="brow"><span>Devolución de IVA</span><b>{fmt(iva)}</b></div>
              <div class="btrack"><i style={`width:${pctIva}%`}></i></div>
              <p class="v-bnote">5% del valor sin IVA, estimado</p>
            </div>
            <div>
              <div class="brow"><span>Deducción en renta</span><b>{fmt(renta)}</b></div>
              <div class="btrack b2"><i style={`width:${pctRenta}%`}></i></div>
              <p class="v-bnote">50% del valor, reduce tu base gravable</p>
            </div>
          </div>

          <div class="cost">
            <h2 class="h">Costo total del trámite</h2>
            <div>
              <span>Trámite ante UPME</span>
              <b>{fmt(costoUPME)} COP</b>
            </div>
            <div>
              <span>Honorarios CertiVeh</span>
              <b>{fmt(honorarios)} COP</b>
            </div>
            <div class="m">
              <span>IVA (19% sobre honorarios)</span>
              <span>{fmt(ivaServicio)} COP</span>
            </div>
            <div class="t">
              <span>Total</span>
              <span>{fmt(costoTotal)} COP</span>
            </div>
          </div>

          <div class="res" data-ui>
            <div class="big">{fmt(totalBeneficio)}</div>
            <div class="s">Beneficio total estimado para tu {v.marca} {v.modelo} (incluye base gravable en renta)</div>
            <div class="row">
              <b>Por cada $1 de costo total, un beneficio estimado de ${roi.toLocaleString('es-CO')}</b>
              <span class="k">Beneficio estimado menos el costo total (incluye base gravable): {fmt(neto)} COP</span>
            </div>
            <a href="https://portal.certiveh.co" target="_blank" rel="noopener noreferrer" class="v-cta cv-btn cv-btn-w">
              Empezar mi trámite ahora
              <span class="cv-arr" aria-hidden="true">→</span>
            </a>
            <p class="note">Si la UPME rechaza, revisamos tu caso · Si el error es nuestro, corregimos sin costo</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div class="v-wrap v-grid v-faq">
    <h2>Preguntas frecuentes, {v.marca} {v.modelo}</h2>
    <div class="v-qs">
      <div class="v-faq-item">
        <button class="v-faq-btn" onclick="this.parentElement.classList.toggle('open')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.parentElement.classList.toggle('open')}" aria-expanded="false">
          <span>¿El {v.marca} {v.modelo} aplica para el certificado UPME?</span>
          <div class="v-faq-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="7" y1="2" x2="7" y2="12"/><line x1="2" y1="7" x2="12" y2="7"/></svg></div>
        </button>
        <div class="v-faq-body">Sí. El {v.marca} {v.modelo} es un vehículo {v.tipoLabel.toLowerCase()} y es elegible para los beneficios tributarios que otorga el certificado UPME en Colombia.</div>
      </div>
      <div class="v-faq-item">
        <button class="v-faq-btn" onclick="this.parentElement.classList.toggle('open')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.parentElement.classList.toggle('open')}" aria-expanded="false">
          <span>¿Cuánto me devuelve la DIAN por el IVA de mi {v.marca} {v.modelo}?</span>
          <div class="v-faq-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="7" y1="2" x2="7" y2="12"/><line x1="2" y1="7" x2="12" y2="7"/></svg></div>
        </button>
        <div class="v-faq-body">El IVA de los eléctricos e híbridos es del 5% sobre el valor del vehículo antes de impuestos, y con el certificado UPME puedes solicitar a la DIAN la devolución del 100% de ese IVA. Sobre un precio de referencia de {fmt(v.precioCOP)} el estimado es de {fmt(iva)}; la cifra exacta es la que aparece discriminada como IVA en tu factura.</div>
      </div>
      <div class="v-faq-item">
        <button class="v-faq-btn" onclick="this.parentElement.classList.toggle('open')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.parentElement.classList.toggle('open')}" aria-expanded="false">
          <span>¿Cuánto puedo deducir en mi declaración de renta?</span>
          <div class="v-faq-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="7" y1="2" x2="7" y2="12"/><line x1="2" y1="7" x2="12" y2="7"/></svg></div>
        </button>
        <div class="v-faq-body">Puedes deducir hasta el 50% del valor del vehículo, es decir {fmt(renta)}, de tu base gravable en la declaración de renta, en un periodo máximo de 15 años desde la entrada en operación del vehículo.</div>
      </div>
      <div class="v-faq-item">
        <button class="v-faq-btn" onclick="this.parentElement.classList.toggle('open')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.parentElement.classList.toggle('open')}" aria-expanded="false">
          <span>¿Cuánto cuesta tramitar el certificado UPME con CertiVeh?</span>
          <div class="v-faq-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="7" y1="2" x2="7" y2="12"/><line x1="2" y1="7" x2="12" y2="7"/></svg></div>
        </button>
        <div class="v-faq-body">El costo total para un {v.marca} {v.modelo} es de {fmt(costoTotal)} COP (incluye trámite UPME {fmt(costoUPME)} + honorarios CertiVeh {fmt(honorarios)} + IVA sobre honorarios). Es un pago único, sin suscripciones.</div>
      </div>
      <div class="v-faq-item">
        <button class="v-faq-btn" onclick="this.parentElement.classList.toggle('open')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.parentElement.classList.toggle('open')}" aria-expanded="false">
          <span>¿Qué documentos necesito?</span>
          <div class="v-faq-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="7" y1="2" x2="7" y2="12"/><line x1="2" y1="7" x2="12" y2="7"/></svg></div>
        </button>
        <div class="v-faq-body">Tu cédula (de ciudadanía o de extranjería), tarjeta de propiedad y factura de compra. El RUT solo hace falta si además vas a pedir la devolución del IVA, y en ese caso también si eres empresa. Si eres empresa, en vez de tu cédula va la del representante legal y el certificado de Cámara de Comercio vigente. Todo se sube en PDF, JPG o PNG desde tu teléfono en menos de 3 minutos.</div>
      </div>
    </div>

    <p class="v-disclaimer">* Los valores de devolución de IVA, deducción en renta y beneficio total son estimaciones basadas en el precio de referencia público del {v.marca} {v.modelo}. Los montos exactos dependen del precio registrado en tu factura de compra. El costo del trámite UPME se calcula según la tabla de tarifas vigente de la UPME en UVT. CertiVeh no garantiza valores específicos, el beneficio final lo determina la DIAN.</p>
  </div>

  </main>

  <script is:inline>
    document.querySelectorAll('.v-faq-btn').forEach(function(btn) {
      btn.setAttribute('aria-expanded', 'false');
      btn.addEventListener('click', function() {
        var expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !expanded);
      });
    });
  </script>

  <!-- FOOTER: el pie compartido de todo el sitio -->
  <SiteFooter />

</BaseLayout>
