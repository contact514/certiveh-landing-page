{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "flyer.certiveh.co"
        }
      ],
      "destination": "https://certiveh.co/:path*?utm_source=flyer&utm_medium=print&utm_campaign=volantes",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "enterprise.certiveh.co"
        }
      ],
      "destination": "https://certiveh.co/:path*?utm_source=enterprise&utm_medium=print&utm_campaign=empresas",
      "permanent": false
    },
    {
      "source": "/gnv",
      "destination": "/otros-activos",
      "permanent": true
    },
    {
      "source": "/r/:sub([a-z0-9-]{1,63})",
      "destination": "https://:sub.portal.certiveh.co",
      "statusCode": 302
    },
    {
      "source": "/r/:sub([a-z0-9-]{1,63})/",
      "destination": "https://:sub.portal.certiveh.co",
      "statusCode": 302
    }
  ],
  "buildCommand": "npm run build"
}
